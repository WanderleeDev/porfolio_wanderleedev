---
import Icon from "astro-iconify";

interface Props {
  icon: string;
  label: string;
  value: string;
}

const { icon, label, value } = Astro.props;
---

<div
  class="card-info outer-bevel-glass-b relative p-[1px] transition-all duration-500 hover:scale-[1.02]"
>
  <div class="absolute inset-0 bg-white/5 group-hover:bg-[linear-gradient(135deg,rgba(255,255,255,0.1)_0%,#6366f1_100%)] transition-all duration-500 pointer-events-none" />

  <div class="inner-bevel-glass-b bg-slate-950/70 backdrop-blur-md p-5 flex items-center gap-5">
    <div
      class="icon-bevel-outer p-[1px] shrink-0"
    >
      <div class="icon-bevel-inner w-12 h-12 flex items-center justify-center bg-white/5 border border-white/5">
        <Icon name={icon} class="w-6 h-6 text-indigo-300 relative z-10" />
      </div>
    </div>
    <div class="min-w-0">
      <p class="text-xs font-semibold uppercase tracking-wider text-neutral-400 mb-0.5">{label}</p>
      <p class="font-semibold text-white/90 text-sm md:text-base break-all select-all font-mono">{value}</p>
    </div>
  </div>
</div>

<style>
  :root {
    --card-b-bevel: 16px;
    --icon-b-bevel: 8px;
  }

  .outer-bevel-glass-b {
    clip-path: polygon(
      0 var(--card-b-bevel),
      var(--card-b-bevel) 0,
      calc(100% - var(--card-b-bevel)) 0,
      100% var(--card-b-bevel),
      100% calc(100% - var(--card-b-bevel)),
      calc(100% - var(--card-b-bevel)) 100%,
      var(--card-b-bevel) 100%,
      0 calc(100% - var(--card-b-bevel))
    );
  }

  .inner-bevel-glass-b {
    clip-path: polygon(
      0 var(--card-b-bevel),
      var(--card-b-bevel) 0,
      calc(100% - var(--card-b-bevel)) 0,
      100% var(--card-b-bevel),
      100% calc(100% - var(--card-b-bevel)),
      calc(100% - var(--card-b-bevel)) 100%,
      var(--card-b-bevel) 100%,
      0 calc(100% - var(--card-b-bevel))
    );
  }

  .icon-bevel-outer {
    clip-path: polygon(
      0 var(--icon-b-bevel),
      var(--icon-b-bevel) 0,
      calc(100% - var(--icon-b-bevel)) 0,
      100% var(--icon-b-bevel),
      100% calc(100% - var(--icon-b-bevel)),
      calc(100% - var(--icon-b-bevel)) 100%,
      var(--icon-b-bevel) 100%,
      0 calc(100% - var(--icon-b-bevel))
    );
    background: rgba(255,255,255,0.1);
  }
  .icon-bevel-inner {
    clip-path: polygon(
      0 var(--icon-b-bevel),
      var(--icon-b-bevel) 0,
      calc(100% - var(--icon-b-bevel)) 0,
      100% var(--icon-b-bevel),
      100% calc(100% - var(--icon-b-bevel)),
      calc(100% - var(--icon-b-bevel)) 100%,
      var(--icon-b-bevel) 100%,
      0 calc(100% - var(--icon-b-bevel))
    );
  }
</style>
