---
import ChatPanel from "./ChatPanel.tsx";
import { getTranslations } from "../i18n/utils";

const lang = Astro.currentLocale as "es" | "en";
const t = getTranslations(lang)("chat");
---

<section class="w-full max-w-6xl" aria-label={t.title}>
  <ChatPanel client:load lang={lang} />
</section>

<script>
  import "@wanderleedev/pixel-pet/define";

  let meowAudio: HTMLAudioElement | null = null;
  let lastMeow = 0;

  const meow = () => {
    try {
      if (!meowAudio) {
        meowAudio = new Audio("/meowth.mp3");
        meowAudio.volume = 0.35;
      }
      const now = Date.now();
      if (now - lastMeow < 2500) return;
      lastMeow = now;
      meowAudio.currentTime = 0;
      void meowAudio.play()?.catch(() => undefined);
    } catch (e) {}
  };

  window.addEventListener("chat:event", ((e: CustomEvent<string>) => {
    const pet = document.getElementById("chat-pet") as (HTMLElement & {
      feed?: (e: string) => void;
    }) | null;
    pet?.feed?.(e.detail);
    if (e.detail === "send") meow();
  }) as EventListener);
</script>
