---
import { getTranslations } from "../i18n/utils";
import Icon from "astro-iconify";

const lang = Astro.currentLocale as "es" | "en";
const t = getTranslations(lang);
const formT = t("form");

const formId = import.meta.env.FORMSPREE_FORM_ID;
const endpoint = `https://formspree.io/f/${formId}`;
---

<div
  class="outer-bevel-form relative p-[1px] shadow-2xl"
>
  <div class="absolute inset-0 bg-white/10 transition-all duration-300 pointer-events-none" />

  <div class="inner-bevel-form bg-slate-950/85 backdrop-blur-xl p-6 md:p-8 lg:p-10">
    <form
      id="contact-form"
      class="space-y-6 relative z-10"
      method="POST"
      action={endpoint}
    >
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <label class="flex flex-col gap-2">
          <span class="text-xs font-semibold uppercase tracking-wider text-neutral-400 pl-1"
            >{formT.name.label}</span
          >
          <div class="input-bevel-outer p-[1px] bg-white/10 focus-within:bg-[linear-gradient(135deg,#6366f1,#a855f7)] transition-all duration-300">
            <div class="input-bevel-inner relative bg-slate-900/60 w-full flex items-center">
              <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-500 transition-colors duration-300 pointer-events-none">
                <Icon name="ri:user-line" class="w-5 h-5" />
              </span>
              <input
                name="name"
                type="text"
                required
                class="pl-12 pr-4 py-3.5 w-full bg-transparent focus:outline-none transition-all duration-300 text-white placeholder-gray-500 text-sm"
                placeholder={formT.name.placeholder}
              />
            </div>
          </div>
        </label>

        <label class="flex flex-col gap-2">
          <span class="text-xs font-semibold uppercase tracking-wider text-neutral-400 pl-1"
            >{formT.email.label}</span
          >
          <div class="input-bevel-outer p-[1px] bg-white/10 focus-within:bg-[linear-gradient(135deg,#6366f1,#a855f7)] transition-all duration-300">
            <div class="input-bevel-inner relative bg-slate-900/60 w-full flex items-center">
              <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-500 transition-colors duration-300 pointer-events-none">
                <Icon name="ri:mail-line" class="w-5 h-5" />
              </span>
              <input
                name="email"
                type="email"
                required
                class="pl-12 pr-4 py-3.5 w-full bg-transparent focus:outline-none transition-all duration-300 text-white placeholder-gray-500 text-sm"
                placeholder={formT.email.placeholder}
              />
            </div>
          </div>
        </label>
      </div>

      <label class="flex flex-col gap-2">
        <span class="text-xs font-semibold uppercase tracking-wider text-neutral-400 pl-1"
          >{formT.subject.label}</span
        >
        <div class="input-bevel-outer p-[1px] bg-white/10 focus-within:bg-[linear-gradient(135deg,#6366f1,#a855f7)] transition-all duration-300">
          <div class="input-bevel-inner relative bg-slate-900/60 w-full flex items-center">
            <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-500 transition-colors duration-300 pointer-events-none">
              <Icon name="ri:bookmark-line" class="w-5 h-5" />
            </span>
            <input
              name="subject"
              type="text"
              class="pl-12 pr-4 py-3.5 w-full bg-transparent focus:outline-none transition-all duration-300 text-white placeholder-gray-500 text-sm"
              placeholder={formT.subject.placeholder}
            />
          </div>
        </div>
      </label>

      <label class="flex flex-col gap-2">
        <span class="text-xs font-semibold uppercase tracking-wider text-neutral-400 pl-1"
          >{formT.message.label}</span
        >
        <div class="textarea-bevel-outer p-[1px] bg-white/10 focus-within:bg-[linear-gradient(135deg,#6366f1,#a855f7)] transition-all duration-300">
          <div class="textarea-bevel-inner relative bg-slate-900/60 w-full flex items-start">
            <span class="absolute left-4 top-5 text-gray-500 transition-colors duration-300 pointer-events-none">
              <Icon name="ri:chat-3-line" class="w-5 h-5" />
            </span>
            <textarea
              name="message"
              rows="5"
              required
              class="pl-12 pr-4 py-4 w-full bg-transparent focus:outline-none transition-all duration-300 text-white placeholder-gray-500 resize-none text-sm"
              placeholder={formT.message.placeholder}></textarea>
          </div>
        </div>
      </label>

      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 pt-2">
        <div class="btn-bevel-outer p-[1px] bg-indigo-500/50 hover:bg-[linear-gradient(135deg,#6366f1,#a855f7)] shadow-lg transition-all duration-300 rounded-none shrink-0 w-full sm:w-auto">
          <button
            type="submit"
            id="submit-btn"
            class="btn-bevel-inner px-8 py-3.5 w-full text-white font-semibold transition-all duration-300 cursor-pointer flex items-center justify-center gap-2 select-none relative overflow-hidden group/btn font-sans bg-slate-950/20 hover:bg-slate-950/0"
          >
            <span class="relative z-10 flex items-center gap-2">
              {formT.submit}
              <Icon name="ri:send-plane-fill" class="w-4 h-4 group-hover/btn:translate-x-1 group-hover/btn:-translate-y-0.5 transition-transform duration-300" />
            </span>
          </button>
        </div>
        <p id="form-status" class="text-sm font-medium transition-all duration-300"></p>
      </div>
    </form>
  </div>
</div>

<style>
  /* Form Bevel Variables */
  :root {
    --form-bevel: 32px;
    --input-bevel: 10px;
    --btn-bevel: 12px;
  }

  /* Outer Form Bevel Clip-path */
  .outer-bevel-form {
    clip-path: polygon(
      0 var(--form-bevel),
      var(--form-bevel) 0,
      calc(100% - var(--form-bevel)) 0,
      100% var(--form-bevel),
      100% calc(100% - var(--form-bevel)),
      calc(100% - var(--form-bevel)) 100%,
      var(--form-bevel) 100%,
      0 calc(100% - var(--form-bevel))
    );
  }

  /* Inner Form Bevel Clip-path */
  .inner-bevel-form {
    clip-path: polygon(
      0 var(--form-bevel),
      var(--form-bevel) 0,
      calc(100% - var(--form-bevel)) 0,
      100% var(--form-bevel),
      100% calc(100% - var(--form-bevel)),
      calc(100% - var(--form-bevel)) 100%,
      var(--form-bevel) 100%,
      0 calc(100% - var(--form-bevel))
    );
  }

  /* Input Field Bevels */
  .input-bevel-outer {
    clip-path: polygon(
      0 var(--input-bevel),
      var(--input-bevel) 0,
      calc(100% - var(--input-bevel)) 0,
      100% var(--input-bevel),
      100% calc(100% - var(--input-bevel)),
      calc(100% - var(--input-bevel)) 100%,
      var(--input-bevel) 100%,
      0 calc(100% - var(--input-bevel))
    );
  }
  .input-bevel-inner {
    clip-path: polygon(
      0 var(--input-bevel),
      var(--input-bevel) 0,
      calc(100% - var(--input-bevel)) 0,
      100% var(--input-bevel),
      100% calc(100% - var(--input-bevel)),
      calc(100% - var(--input-bevel)) 100%,
      var(--input-bevel) 100%,
      0 calc(100% - var(--input-bevel))
    );
  }

  /* Textarea Bevels */
  .textarea-bevel-outer {
    clip-path: polygon(
      0 var(--input-bevel),
      var(--input-bevel) 0,
      calc(100% - var(--input-bevel)) 0,
      100% var(--input-bevel),
      100% calc(100% - var(--input-bevel)),
      calc(100% - var(--input-bevel)) 100%,
      var(--input-bevel) 100%,
      0 calc(100% - var(--input-bevel))
    );
  }
  .textarea-bevel-inner {
    clip-path: polygon(
      0 var(--input-bevel),
      var(--input-bevel) 0,
      calc(100% - var(--input-bevel)) 0,
      100% var(--input-bevel),
      100% calc(100% - var(--input-bevel)),
      calc(100% - var(--input-bevel)) 100%,
      var(--input-bevel) 100%,
      0 calc(100% - var(--input-bevel))
    );
  }

  /* Button Bevels */
  .btn-bevel-outer {
    clip-path: polygon(
      0 var(--btn-bevel),
      var(--btn-bevel) 0,
      calc(100% - var(--btn-bevel)) 0,
      100% var(--btn-bevel),
      100% calc(100% - var(--btn-bevel)),
      calc(100% - var(--btn-bevel)) 100%,
      var(--btn-bevel) 100%,
      0 calc(100% - var(--btn-bevel))
    );
  }
  .btn-bevel-inner {
    clip-path: polygon(
      0 var(--btn-bevel),
      var(--btn-bevel) 0,
      calc(100% - var(--btn-bevel)) 0,
      100% var(--btn-bevel),
      100% calc(100% - var(--btn-bevel)),
      calc(100% - var(--btn-bevel)) 100%,
      var(--btn-bevel) 100%,
      0 calc(100% - var(--btn-bevel))
    );
  }
</style>

<script>
  import { $ } from "../utils/selectors";

  const form = $<HTMLFormElement>("#contact-form");
  const statusEl = $("#form-status");
  const submitBtn = $<HTMLButtonElement>("#submit-btn");

  if (form && statusEl && submitBtn) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      
      const formData = new FormData(form);
      const isEs = window.location.pathname.startsWith("/es") || !window.location.pathname.includes("/en");
      
      submitBtn.disabled = true;
      submitBtn.style.opacity = "0.7";
      
      statusEl.textContent = isEs ? "Enviando mensaje..." : "Sending message...";
      statusEl.className = "text-sm font-medium text-indigo-400 animate-pulse";

      try {
        const response = await fetch(form.action, {
          method: form.method,
          body: formData,
          headers: {
            'Accept': 'application/json'
          }
        });

        if (response.ok) {
          statusEl.textContent = isEs ? "¡Mensaje enviado con éxito!" : "Message sent successfully!";
          statusEl.className = "text-sm font-medium text-emerald-400";
          form.reset();
        } else {
          const data = await response.json();
          statusEl.textContent = data.errors ? data.errors.map((err: any) => err.message).join(', ') : (isEs ? "Ocurrió un error. Inténtalo de nuevo." : "Oops! There was a problem submitting.");
          statusEl.className = "text-sm font-medium text-rose-400";
        }
      } catch (error) {
        statusEl.textContent = isEs ? "Error de conexión. Inténtalo más tarde." : "Connection error. Please try again later.";
        statusEl.className = "text-sm font-medium text-rose-400";
      } finally {
        submitBtn.disabled = false;
        submitBtn.style.opacity = "";
      }
    });
  }
</script>
