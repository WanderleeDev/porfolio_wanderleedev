---
import Title from "./typography/Title.astro";
import ContactChannels from "./contact/ContactChannels.astro";
import ContactForm from "./contact/ContactForm";
import { getTranslations } from "../i18n/utils";

const lang = Astro.currentLocale as "es" | "en";
const t = getTranslations(lang);
const c = t("contactSection");
const f = t("footer");
---

<div class="grid w-full max-w-6xl grid-cols-1 overflow-hidden rounded-[1.75rem] border border-line bg-surface text-left shadow-[0_36px_90px_-52px_rgb(0_0_0_/_0.45)] lg:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)]">
  <div class="flex flex-col justify-between gap-8 border-b border-line bg-badge/20 p-6 sm:p-8 lg:border-b-0 lg:border-r">
    <div>
      <span class="font-sans text-[0.65rem] font-bold uppercase tracking-[0.3em] text-muted">
        {f.contactLabel}
      </span>
      <Title level={2} family="sans" size="clamp(2.5rem,5vw,4rem)" class="mt-2">
        {c.title}
      </Title>
      <p class="mt-3 max-w-[40ch] font-sans text-[0.95rem] leading-[1.6] text-soft">
        {c.subtitle}
      </p>
      <div class="mt-6 flex flex-wrap gap-2">
        <span class="flex items-center gap-1.5 rounded-full border border-line bg-surface px-3 py-1.5 font-sans text-[0.68rem] font-medium text-ink">
          <span class="size-1.5 rounded-full bg-emerald-500" aria-hidden="true" />
          {c.available}
        </span>
      </div>
    </div>

    <div class="space-y-4">
      <ContactChannels />
      <p class="max-w-[38ch] font-sans text-xs leading-relaxed text-muted">{c.note}</p>
    </div>
  </div>

  <div class="bg-badge/10 p-4 sm:p-6 lg:p-8">
    <ContactForm client:visible lang={lang} />
  </div>
</div>
