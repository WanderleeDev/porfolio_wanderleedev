---
/**
 * Contact section: intro and direct contact on the left, one-field-per-row
 * form on the right. Texts come from i18n (contactSection).
 */
import Icon from "astro-iconify";
import { getTranslations } from "../i18n/utils";
import ContactForm from "./ContactForm";
import Title from "./typography/Title.astro";

const lang = Astro.currentLocale === "en" ? "en" : "es";
const info = getTranslations(lang)("contactSection");
const config = {
  email: "wanderleedev@gmail.com",
};
---

<section id="contact" class="text-ink" aria-labelledby="contact-heading">
  <div class="mx-auto grid max-w-6xl grid-cols-1 items-start gap-10 py-20 md:grid-cols-[1fr_1.1fr] md:gap-14 md:py-28">
    <!-- Left: intro + direct contact -->
    <div data-reveal>
      <Title level={2} id="contact-heading" class="mt-3">
        {info.title}
      </Title>
      <p class="mt-4 max-w-md font-sans text-[clamp(0.95rem,1.8vw,1.05rem)] leading-relaxed text-soft">
        {info.subtitle}
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a
          href={`mailto:${config.email}`}
          class="inline-flex items-center gap-2 rounded-full bg-ink px-6 py-3 text-sm font-bold text-contrast transition hover:brightness-90"
        >
          <Icon name="lucide:mail" class="h-4 w-4" aria-hidden="true" />
          {config.email}
        </a>
        <a
          href="https://www.linkedin.com/in/wanderlee-max/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
          class="flex size-11 items-center justify-center rounded-full border border-line text-ink transition hover:brightness-90"
        >
          <Icon name="lucide:linkedin" class="h-5 w-5" aria-hidden="true" />
        </a>
        <a
          href="https://github.com/WanderleeDev"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
          class="flex size-11 items-center justify-center rounded-full border border-line text-ink transition hover:brightness-90"
        >
          <Icon name="lucide:github" class="h-5 w-5" aria-hidden="true" />
        </a>
      </div>

      <p class="mt-4 font-sans text-sm text-muted">{info.preferredText}</p>
    </div>

    <!-- Right: the form, one field per row -->
    <div data-reveal>
      <ContactForm
      client:load
      lang={lang}
    />
    </div>
  </div>
</section>


