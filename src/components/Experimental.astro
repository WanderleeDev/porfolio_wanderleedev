---
import { getTranslations } from "../i18n/utils";
import Icon from "astro-iconify";
import IntroOverlay from "./IntroOverlay.astro";

const lang = Astro.currentLocale as "es" | "en";
const t = getTranslations(lang);
const skillsT = t("skills");
const groups = skillsT.list;
const journeyT = t("journey");

const descriptions = journeyT.skillDescriptions;
const one =groups[0]
---
<IntroOverlay />

<section class="h-dvh ">
    <h2
      class="m-0 font-fira-sans-extra-condensed font-black text-[64px] uppercase tracking-tight leading-none text-ink"
    >
      Experimental
    </h2>

    <div class="grid grid-cols-2 h-full items-center relative">
        <h3 class="text-6xl">
            {one.title}
        </h3>
        <div class="absolute inset-0 p-8">

        {
            one.techs.map(({icon, color}) =>  {
                const t = () => Math.ceil(Math.random() * 100)
                return 
                <Icon 
                    name={icon} 
                    // class={`size-16 absolute top-[${t()}%] left-2/4 -trasnlate-x-2/4 -trasnlate-y-2/4`} 
                />
            })
        }
        </div>
    </div>
</section>
