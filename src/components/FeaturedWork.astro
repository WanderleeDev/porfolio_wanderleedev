---
import Icon from "astro-iconify";
import { getTranslations } from "../i18n/utils";
import Title from "./typography/Title.astro";

interface Item {
  title: string;
  image: string;
  description?: string;
  demo_url?: string;
  technologies?: string[];
  label?: string;
}

const { items } = Astro.props as { items: Item[] };
const lang = Astro.currentLocale === "en" ? "en" : "es";
const { title, subtitle, prev, next, close, personal, demo } = getTranslations(lang)("featuredWork");
const pad = (n: number) => String(n).padStart(2, "0");
const L = { prev, next, close, personal, demo };

const btn =
  "flex items-center justify-center rounded-full bg-badge text-badge-ink transition hover:brightness-90";
const chip =
  "font-sans text-[0.7rem] font-bold uppercase tracking-widest bg-badge text-badge-ink rounded-full px-3 py-1";
const icon = "w-5 h-5";
---

<section
  data-fw
  class="relative w-full h-dvh flex flex-col items-center text-ink overflow-hidden pt-6 md:pt-20"
>
  <header class="pt-8 md:pt-10 pb-5 md:pb-8 text-center shrink-0 z-10" data-reveal>
    <Title level={2}>{title}</Title>
    <p class="mx-auto mt-3 max-w-[44ch] font-sans text-[clamp(0.95rem,1.8vw,1.05rem)] leading-[1.6] text-soft">
      {subtitle}
    </p>
  </header>

  <div
    id="fw-stage"
    data-reveal
    class="relative flex-1 w-full overflow-hidden flex items-center justify-center cursor-grab active:cursor-grabbing"
  >
    <div id="fw-track" class="absolute top-0 left-0">
      {
        items.map((item, i) => (
          <button
            type="button"
            class="fw__card absolute top-0 left-0 rounded-card border border-line overflow-hidden text-left origin-[50%_100%] will-change-transform"
            data-title={item.title}
            command="show-modal"
            commandfor={`fw-dlg-${i}`}
          >
            <img
              src={item.image}
              alt={item.title}
              draggable="false"
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover block pointer-events-none select-none"
            />
            <span class="sr-only">{item.title}</span>
          </button>
        ))
      }
    </div>

    <div
      class="absolute bottom-10 md:bottom-14 left-1/2 -translate-x-1/2 z-10 flex items-center gap-2 md:gap-3 pointer-events-none"
    >
      <button
        id="fw-prev"
        type="button"
        aria-label={L.prev}
        class={`${btn} pointer-events-auto w-10 h-10 md:w-11 md:h-11`}
      >
        <Icon name="lucide:chevron-left" class={icon} aria-hidden="true" />
      </button>

      <div class="bg-badge rounded-full px-6 md:px-8 py-3 w-60 md:w-72 overflow-hidden">
        <span
          id="fw-badge"
          class="font-sans text-[clamp(0.8rem,1.6vw,1rem)] font-extrabold uppercase tracking-widest text-badge-ink block text-center truncate"
        >
          {items[0]?.title}
        </span>
      </div>

      <button
        id="fw-next"
        type="button"
        aria-label={L.next}
        class={`${btn} pointer-events-auto w-10 h-10 md:w-11 md:h-11`}
      >
        <Icon name="lucide:chevron-right" class={icon} aria-hidden="true" />
      </button>
    </div>
  </div>

  {
    items.map((item, i) => (
      <dialog
        id={`fw-dlg-${i}`}
        aria-labelledby={`fw-dlg-${i}-title`}
        closedby="any"
        class="m-auto max-h-[90vh] w-[min(1020px,94vw)] overflow-y-auto rounded-3xl border border-line p-0 text-ink select-none transition-all duration-1000 delay-150 ease-out-elastic starting:scale-0 backdrop:bg-[rgba(0,0,0,0.55)] backdrop:backdrop-blur-[6px] backdrop:transition-all backdrop:duration-150 starting:backdrop:opacity-0"
      >
        <div class="relative p-5 md:p-8">
          <button
            type="button"
            command="close"
            commandfor={`fw-dlg-${i}`}
            aria-label={L.close}
            class={`${btn} absolute top-4 right-4 md:top-5 md:right-5 z-10 w-11 h-11`}
          >
            <Icon name="lucide:x" class={icon} aria-hidden="true" />
          </button>

          <div class="grid gap-6 md:gap-8 md:grid-cols-[1.15fr_1fr] md:items-center">
            <img
              src={item.image}
              alt={item.title}
              loading="lazy"
              decoding="async"
              class="w-full h-64 md:h-[58vh] object-cover rounded-card block"
            />

            <div class="md:pr-2">
              <p class="flex items-baseline justify-between gap-4 font-sans text-[0.7rem] font-bold uppercase tracking-[0.2em] !text-soft">
                <span>{L.personal}</span>
                <span class="text-muted tabular-nums">
                  {pad(i + 1)} / {pad(items.length)}
                </span>
              </p>

              <Title level={3} id={`fw-dlg-${i}-title`} class="mt-3">
                {item.title}
              </Title>

              {item.description && (
                <p class="mt-4 max-w-none font-sans text-[clamp(0.95rem,1.8vw,1.05rem)] leading-[1.6] text-soft">
                  {item.description}
                </p>
              )}

              {item.technologies?.length ? (
                <div class="mt-5 flex flex-wrap gap-2">
                  {item.technologies.map((tech) => (
                    <span class={chip}>{tech}</span>
                  ))}
                </div>
              ) : null}

              {item.demo_url && (
                <a
                  href={item.demo_url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-7 inline-flex items-center gap-2 font-sans font-bold text-[0.95rem] text-ink transition-colors hover:text-ink/70"
                >
                  <span>{item.label ?? L.demo}</span>
                  <Icon name="lucide:arrow-right" class="w-4 h-4" aria-hidden="true" />
                </a>
              )}
            </div>
          </div>
        </div>
      </dialog>
    ))
  }
</section>

<script>
  import { gsap, Draggable } from "../lib/gsap";
  import { $ } from "../utils/selectors";

  

  const SIDE_ROT = 14;
  const SIDE_SCALE = 0.82;
  const SIDE_DROP = 0.06;
  const SPREAD = 1.2;
  const COPIES = 3;
  const CLICK_TOLERANCE = 8;

  let cleanup: (() => void) | null = null;

  function init() {
    cleanup?.();

    const root = $<HTMLElement>("[data-fw]");
    if (!root) return;

    // Búsquedas acotadas al componente
    const q = gsap.utils.selector(root);
    const stage = q("#fw-stage")[0] as HTMLElement;
    const track = q("#fw-track")[0] as HTMLElement;
    const badge = q("#fw-badge")[0] as HTMLElement;
    const prev = q("#fw-prev")[0] as HTMLElement;
    const next = q("#fw-next")[0] as HTMLElement;

    const originals = gsap.utils.toArray<HTMLElement>(".fw__card", track);
    const N = originals.length;
    if (!N) return;

    // Clones para loop infinito. Conservan commandfor, así que abren el mismo dialog.
    for (let c = 1; c < COPIES; c++) {
      originals.forEach((card) => {
        const clone = card.cloneNode(true) as HTMLElement;
        clone.setAttribute("aria-hidden", "true");
        clone.tabIndex = -1;
        track.appendChild(clone);
      });
    }
    const cards = gsap.utils.toArray<HTMLElement>(".fw__card", track);

    // Geometría responsive
    const vw = stage.clientWidth;
    const vh = stage.clientHeight;
    const isMobile = vw < 640;
    const isTablet = vw < 1024;
    const cardW = Math.min(
      Math.round(vw * (isMobile ? 0.86 : isTablet ? 0.58 : 0.48)),
      isMobile ? 340 : isTablet ? 420 : 544,
    );
    // En móvil la card crece en alto para aprovechar el espacio vertical
    // disponible; en el resto se mantiene la proporción de escritorio.
    const cardH = isMobile
      ? Math.min(Math.round(vh * 0.78), Math.round(cardW * 1.5))
      : Math.min(Math.round(cardW * 1.05), Math.round(vh * 0.7));
    const step = cardW + Math.round(vw * (isMobile ? 0.1 : isTablet ? 0.12 : 0.14));
    const loop = N * step;
    const baseX = vw / 2 - cardW / 2 - loop;
    const wrap = gsap.utils.wrap(baseX - loop / 2, baseX + loop / 2);

    track.style.height = `${cardH}px`;
    cards.forEach((card, i) => {
      card.style.width = `${cardW}px`;
      card.style.height = `${cardH}px`;
      card.style.left = `${i * step}px`;
    });

    const x = () => gsap.getProperty(track, "x") as number;
    const offset = (i: number, cx: number) => i * step + cx + cardW / 2 - vw / 2;

    function render() {
      const cx = x();
      let closest = 0;
      let minDist = Infinity;

      cards.forEach((card, i) => {
        const d = offset(i, cx);
        const norm = d / (step * SPREAD);
        const abs = gsap.utils.clamp(0, 1.5, Math.abs(norm));
        if (Math.abs(d) < minDist) {
          minDist = Math.abs(d);
          closest = i;
        }
        gsap.set(card, {
          rotation: gsap.utils.clamp(-1, 1, norm) * SIDE_ROT,
          scale: 1 - abs * (1 - SIDE_SCALE),
          y: abs * cardH * SIDE_DROP,
          opacity: 1 - abs * 0.5,
          zIndex: Math.round(100 - abs * 80),
        });
      });

      const title = originals[closest % N].dataset.title ?? "";
      if (badge.textContent !== title) {
        gsap.to(badge, {
          opacity: 0,
          y: -6,
          duration: 0.12,
          onComplete: () => {
            badge.textContent = title;
            gsap.to(badge, { opacity: 1, y: 0, duration: 0.15 });
          },
        });
      }
    }

    function goTo(from: number, dir = 0, duration = 0.3, ease = "power2.out") {
      const cx = wrap(from);
      const best = cards.reduce(
        (bestI, _, i) =>
          Math.abs(offset(i, cx)) < Math.abs(offset(bestI, cx)) ? i : bestI,
        0,
      );
      const target = dir
        ? vw / 2 - ((best + dir) * step + cardW / 2)
        : cx - offset(best, cx);

      gsap.to(track, {
        x: wrap(target),
        duration,
        ease,
        overwrite: true,
        onUpdate: render,
      });
    }

    gsap.set(track, { x: baseX });
    render();

    let dragged = false;

    const [drag] = Draggable.create(track, {
      type: "x",
      inertia: true,
      cursor: "grab",
      activeCursor: "grabbing",
      onPress() {
        dragged = false;
      },
      onDrag() {
        if (Math.abs(this.x - this.startX) > CLICK_TOLERANCE) dragged = true;
        render();
      },
      onThrowUpdate() {
        const wrapped = wrap(x());
        if (Math.abs(wrapped - x()) > 0.5) gsap.set(track, { x: wrapped });
        render();
      },
      onThrowComplete: () => goTo(x()),
      onDragEnd: () =>
        requestAnimationFrame(() => {
          if (!gsap.isTweening(track)) goTo(x());
        }),
    });

    const onTrackClick = (e: MouseEvent) => {
      if (dragged) e.preventDefault();
      dragged = false;
    };
    track.addEventListener("click", onTrackClick);

    const onPrev = () => goTo(x(), -1, 0.45, "power3.out");
    const onNext = () => goTo(x(), 1, 0.45, "power3.out");
    prev.addEventListener("click", onPrev);
    next.addEventListener("click", onNext);

    const initialW = vw;
    let timer: ReturnType<typeof setTimeout> | undefined;
    const onResize = () => {
      clearTimeout(timer);
      timer = setTimeout(() => {
        if (stage.clientWidth !== initialW) init();
      }, 200);
    };
    window.addEventListener("resize", onResize, { passive: true });

    cleanup = () => {
      clearTimeout(timer);
      drag.kill();
      gsap.killTweensOf([track, badge, ...cards]);
      prev.removeEventListener("click", onPrev);
      next.removeEventListener("click", onNext);
      track.removeEventListener("click", onTrackClick);
      window.removeEventListener("resize", onResize);
      cards.slice(N).forEach((c) => c.remove());
      cleanup = null;
    };
  }

  document.addEventListener("astro:before-swap", () => cleanup?.());
  document.addEventListener("astro:page-load", init);
  init();
</script>