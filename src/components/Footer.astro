---
import Paragraph from "./typography/Paragraph.astro";
import { cloudinary } from "../utils/cloudinary";
import { Icon } from "astro-iconify";
import { getTranslations } from "../i18n/utils";

const lang = Astro.currentLocale as "es" | "en";
const t = getTranslations(lang);
const footerText = t("footer");
const socialLinks = t("social");
---

<footer
  id="footer"
  class="min-h-svh flex flex-col justify-between bg-slate-950 overflow-hidden fixed inset-0 top-0 z-0"
>
  <div class="absolute inset-0 bg-[linear-gradient(to_right,#0f172a_1px,transparent_1px),linear-gradient(to_bottom,#0f172a_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)] opacity-30 pointer-events-none" />

  <div
    class="grid grid-cols-1 md:grid-cols-2 flex-1 place-content-center gap-12 md:gap-16 px-6 lg:px-12 max-w-7xl w-full mx-auto relative z-10"
  >
    {/* TODO(perf): hero image tom_f0v8qy.webp weighs ~1.5MB even with
        f_auto,q_60. Re-upload pre-compressed to Cloudinary (or w_400)
        and restore the <img> below. Removed 2026-10-06 to unblock LCP. */
    <div
      class="md:items-center md:justify-center flex"
      aria-hidden="true"
    >
      <div
        class="relative w-80 h-80 md:w-96 md:h-96 lg:w-104 lg:h-104 overflow-hidden mx-auto rounded-full bg-gradient-to-br from-indigo-500/20 via-purple-500/10 to-transparent"
      />
    </div>

    <div
      class="flex flex-col gap-6 w-full max-w-lg justify-self-center self-center"
    >
      <Paragraph
        customClass="text-neutral-400 md:text-lg leading-relaxed text-center md:text-left font-light text-pretty"
      >
        {footerText.description}
      </Paragraph>

      <nav aria-label={footerText.socialLinksAria} class="w-full">
        <ul class="flex flex-col gap-4 w-full">
          {
            socialLinks.map((link) => {
              return (
                <li class="w-full">
                  <a
                    href={link.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="clip-bevel group/link block p-[1px] bg-white/5 hover:bg-white/10 transition-colors duration-300"
                    style="--bv: 12px;"
                  >
                    <div 
                      class="clip-bevel bg-white/[0.02] group-hover/link:bg-white/[0.05] px-6 py-4 flex items-center justify-between transition-colors duration-300"
                      style="--bv: 12px;"
                    >
                      <div class="flex items-center gap-4">
                        <Icon name={link.icon} class="w-5 h-5 text-white/70 group-hover/link:text-white transition-colors duration-300" />
                        <span class="text-sm font-semibold tracking-wider uppercase text-white/70 group-hover/link:text-white transition-colors duration-300">{link.name}</span>
                      </div>
                      <Icon name="ri:arrow-right-up-line" class="w-4 h-4 text-white/70 group-hover/link:text-white group-hover/link:translate-x-0.5 group-hover/link:-translate-y-0.5 transition-all duration-300" />
                    </div>
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>

      <div class="mt-4 text-center md:text-left">
        <a
          href={footerText.viewCode.url}
          target="_blank"
          rel="noopener noreferrer"
          class="clip-bevel group/code inline-flex p-[1px] bg-white/5 hover:bg-white/10 transition-colors duration-300"
          style="--bv: 8px;"
        >
          <div class="clip-bevel inline-flex items-center gap-2 px-3 py-1.5 bg-slate-950 group-hover/code:bg-white/[0.05] transition-colors duration-300" style="--bv: 8px;">
            <Icon name="mdi:code-tags" class="w-4 h-4 pointer-events-none text-indigo-400" />
            <span class="pointer-events-none text-xs text-neutral-500 group-hover/code:text-neutral-300 transition-colors duration-300 font-dm-mono">{footerText.viewCode.text}</span>
          </div>
        </a>
      </div>
    </div>
  </div>

  <div class="w-full border-t border-neutral-900 my-6 relative">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-4 h-4 bg-slate-950 border border-neutral-800 rotate-45 flex items-center justify-center">
      <div class="w-1.5 h-1.5 bg-indigo-500 rotate-45" />
    </div>
  </div>

  <p
    class="text-center text-3xl lg:text-5xl xl:text-7xl -tracking-wider text-neutral-600 overflow-hidden relative min-h-24 sm:min-h-32 content-center font-fira-sans-extra-condensed select-none font-bold"
    id="footer-content"
    aria-label={footerText.developedBy}
  >
    {footerText.developedBy}
  </p>
</footer>


<script>
  import { gsap, SplitText } from "../utils/gsapConfig";
  import { $ } from "../utils/selectors";

  function animateFooter() {
    if (
      window.matchMedia("(prefers-reduced-motion: reduce)").matches
    )
      return;
    const description = $("#footer .text-neutral-400");
    const socialLinks = gsap.utils.toArray("#footer nav li");
    const viewCodeLink = $("#footer .font-dm-mono");
    const separator = $("#footer .border-t");
    const bannerText = $("#footer-content");

    if (
      !description ||
      !socialLinks.length ||
      !viewCodeLink ||
      !separator ||
      !bannerText
    ) {
      return;
    }

    const descriptionSplit = new SplitText(description, { type: "words" });
    const bannerSplit = new SplitText(bannerText, { type: "chars" });

    gsap.set(bannerSplit.chars, {
      className:
        "+=char relative inline-block will-change-transform font-inherit",
    });

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: "#main-container",
        start: "bottom bottom",
        end: "bottom top",
        toggleActions: "play none none reverse",
      },
    });

    tl.fromTo(
      bannerSplit.chars,
      { y: 50, opacity: 0 },
      {
        y: 0,
        opacity: 1,
        duration: 0.4,
        stagger: {
          each: 0.01,
          from: "start",
          ease: "power2.out",
        },
      },
      0
    )
      .fromTo(
        separator,
        { scaleX: 0, opacity: 0 },
        { scaleX: 1, opacity: 1, duration: 0.4, ease: "power2.inOut" },
        "<0.2"
      )
      .fromTo(
        descriptionSplit.words,
        { opacity: 0, y: 20 },
        {
          opacity: 1,
          y: 0,
          duration: 0.2,
          stagger: 0.02,
          ease: "power3.out",
        },
        "<0.2"
      )
      .fromTo(
        socialLinks,
        { opacity: 0, x: -20 },
        {
          opacity: 1,
          x: 0,
          duration: 0.2,
          stagger: 0.05,
          ease: "power2.out",
        },
        "<"
      )
      .fromTo(
        viewCodeLink,
        { opacity: 0, y: 10 },
        { opacity: 1, y: 0, duration: 0.2, ease: "power2.out" },
        "<"
      );
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", animateFooter);
  } else {
    animateFooter();
  }
</script>
