---
import Icon from "astro-iconify";

interface Props {
  title: string;
  description: string;
  capsules: string[];
  icon: string;
  borderColor: string;
  shadowColor: string;
  glowColor: string;
  primaryColor: string;
  href: string;
}

const {
  title,
  description,
  capsules,
  icon,
  shadowColor,
  glowColor,
  primaryColor,
  href,
} = Astro.props;
---

<div
  class={`clip-bevel group relative p-[1px] ${shadowColor} transition-all duration-500 hover:scale-[1.01]`}
  style={`--primary: ${primaryColor}; --bv: 20px;`}
>
  <div
    class="absolute inset-0 bg-white/10 group-hover:bg-[linear-gradient(135deg,rgba(255,255,255,0.15)_0%,var(--primary)_100%)] transition-all duration-500 pointer-events-none"
  >
  </div>

  <div
    class="clip-bevel bg-slate-950/85 backdrop-blur-xl p-6 md:p-8 lg:p-10 flex flex-col lg:flex-row gap-8 lg:gap-12 items-stretch"
    style="--bv: 20px;"
  >
    <div
      class={`absolute -top-24 -left-24 w-48 h-48 rounded-full blur-3xl opacity-10 group-hover:opacity-25 transition-all duration-500 ${glowColor}`}
    >
    </div>

    <div class="flex flex-col justify-between lg:w-[38%] shrink-0 space-y-6">
      <div class="space-y-6">
        <div class="flex items-center justify-between">
          <div class="clip-bevel p-[1px] bg-white/10" style="--bv: 8px;">
            <div
              class="clip-bevel w-16 h-16 flex items-center justify-center bg-white/5 border border-white/5 transition-all duration-300 group-hover:scale-105 group-hover:rotate-2"
              style="--bv: 8px;"
            >
              <Icon
                class="w-10 h-10 relative z-10"
                name={icon}
                style={{ color: primaryColor }}
              />
            </div>
          </div>
        </div>

        <div class="space-y-3">
          <h3
            class="text-2xl md:text-3xl font-extrabold text-white tracking-wide"
          >
            {title}
          </h3>
          <p
            class="text-sm text-gray-400 leading-relaxed font-light text-pretty"
          >
            {description}
          </p>
        </div>
      </div>

      <a
        href={href}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-between w-full px-5 py-3 rounded-lg border border-white/5 bg-white/[0.02] text-sm font-semibold text-white/70 hover:text-white hover:bg-white/[0.05] hover:border-white/10 transition-all duration-300 group/btn font-sans"
      >
        <span>Explorar Showroom</span>
        <Icon
          name="ri:arrow-right-up-line"
          class="w-4 h-4 group-hover/btn:translate-x-0.5 group-hover/btn:-translate-y-0.5 transition-transform duration-300"
          style={{ color: primaryColor }}
        />
      </a>
    </div>

    <div class="flex-1 flex flex-col justify-center">
      <div class="space-y-4">
        <h4
          class="text-[10px] md:text-xs font-semibold uppercase tracking-wider text-white/30 pl-1"
        >
          Ecosistema Tecnológico
        </h4>
        <div class="flex flex-wrap gap-2.5">
          {
            capsules.map((cap) => (
              <span
                class="capsule-pill text-xs md:text-sm font-semibold tracking-wide uppercase px-4 py-2.5 bg-white/5 hover:bg-[var(--primary-glow)] border border-white/5 hover:border-[var(--primary)] text-gray-300 hover:text-white rounded-full transition-all duration-300 shadow-sm hover:shadow-[0_0_12px_var(--primary-glow)] select-none"
                style={{
                  "--primary": primaryColor,
                  "--primary-glow": `${primaryColor}15`,
                }}
              >
                {cap}
              </span>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</div>

