---
import FrameworkCard from "./FrameworkCard.astro";

interface Props {
  extras: {
    title: string;
    icon: string;
    link: string;
    description?: string;
    capsules?: string[];
  }[];
}

const { extras } = Astro.props;

const getColors = (title: string) => {
  const lower = title.toLowerCase();
  if (lower.includes("react"))
    return {
      borderColor: "border-cyan-500/20 hover:border-cyan-400/40",
      shadowColor: "shadow-cyan-500/5",
      glowColor: "bg-cyan-500/10",
      primaryColor: "#00d8ff",
    };
  if (lower.includes("angular"))
    return {
      borderColor: "border-red-500/20 hover:border-red-400/40",
      shadowColor: "shadow-red-500/5",
      glowColor: "bg-red-500/10",
      primaryColor: "#E0234E",
    };
  return {
    borderColor: "border-gray-500/20 hover:border-gray-400/40",
    shadowColor: "shadow-gray-500/5",
    glowColor: "bg-gray-500/10",
    primaryColor: "#ffffff",
  };
};

const extrasWithColors = extras.map((e) => ({
  ...e,
  ...getColors(e.title),
}));
---

<div class="extras-cards-container relative w-full">
  <div class="absolute -top-12 -left-12 w-48 h-48 bg-indigo-500/5 rounded-full blur-3xl pointer-events-none" />
  <div class="absolute -bottom-12 -right-12 w-48 h-48 bg-purple-500/5 rounded-full blur-3xl pointer-events-none" />

  <ul class="flex flex-col gap-8 relative z-10 w-full">
    {
      extrasWithColors.map(({ title, icon, link, description, capsules, borderColor, shadowColor, glowColor, primaryColor }) => (
        <li class="card-wrapper extras-card-item w-full">
          <FrameworkCard
            title={title}
            description={description || ""}
            capsules={capsules || []}
            icon={`devicon:${icon.toLowerCase()}`}
            borderColor={borderColor}
            shadowColor={shadowColor}
            glowColor={glowColor}
            primaryColor={primaryColor}
            href={link}
          />
        </li>
      ))
    }
  </ul>
</div>
