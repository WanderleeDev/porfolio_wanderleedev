---
import { Image } from "astro:assets";

interface Props {
  projects: {
    title: string;
    description: string;
    demo_url: string;
    technologies: string[];
    image: string;
    label: string;
  }[];
}

const { projects } = Astro.props;
---

<ul
  class="grid place-content-center items-center gap-8 md:gap-6 grid-cols-1 md:grid-cols-2 w-[90%] md:w-full lg:w-4/5 mx-auto lg:min-h-dvh pt-4 md:py-0"
>
  {
    projects.map(({ title, demo_url, image, description, technologies }, i) => (
      <li
        class="card-project @container will-change-transform group clip-bevel relative p-[1px]"
        style="--bv: 12px;"
      >
        <div class="absolute inset-0 bg-white/10 group-hover:bg-[linear-gradient(135deg,rgba(255,255,255,0.15)_0%,#6366f1_100%)] transition-all duration-500 pointer-events-none" />

        <a
          class="clip-bevel overflow-hidden block relative bg-slate-950/85 backdrop-blur-xl transition-all duration-300"
          style="--bv: 12px;"
          target="_blank"
          href={demo_url}
          rel="noopener noreferrer"
        >
          <Image
            class="aspect-video object-cover w-full group-hover:scale-105 transition-all duration-500 lg:group-hover:brightness-75 pointer-events-none"
            loading="lazy"
            src={image}
            alt={`thumbnail for ${title}`}
            width={800}
            height={450}
          />
          <div
            class={`absolute flex flex-col inset-0 justify-end bottom-0 h-full px-4 md:px-6 py-3 pointer-events-none text-gray-100 font-bold lg:opacity-0 lg:group-hover:opacity-100 lg:group-focus-within:opacity-100 lg:duration-300 lg:transition-opacity text-base md:text-[1.5vw] ${i % 2 === 0 ? "right-0" : "left-0"} bg-black/75`}
          >
            <span class="font-extrabold text-lg lg:text-2xl">{title}</span>
            <p class="pt-2 lowercase first-letter:uppercase text-neutral-200 hidden @sm:block text-sm font-normal">
              {description}.
            </p>

            <div class="flex flex-wrap gap-1.5 mt-2">
              {technologies.map((tech) => (
                <span class="px-2.5 py-0.5 text-xs font-mono font-medium rounded-full bg-white/10 text-neutral-200 border border-white/5">
                  {tech}
                </span>
              ))}
            </div>
          </div>
        </a>
      </li>
    ))
  }
</ul>

<script>
  import {
    gsap,
    GsapBreakpoints,
    type GsapBreakpointsType,
  } from "../utils/gsapConfig";
  import { $$ } from "../utils/selectors";

  const ANIMATION_CONFIG = {
    mobile: {
      duration: 0.8,
      ease: "power2.out",
      scrollTrigger: {
        start: "top 80%",
        end: "center 50%",
        toggleActions: "play none none reverse",
      },
    },
    desktop: {
      scrollTrigger: {
        start: "top 80%",
        end: "bottom 20%",
        scrub: true,
      },
    },
  } as const;

  const projectCardsAnimate = () => {
    const cards = $$<HTMLElement>(".card-project");
    const containerCards = document.querySelector("#projects");

    if (!cards || cards.length === 0 || !containerCards) return;

    const mm = gsap.matchMedia();

    mm.add({ ...GsapBreakpoints }, (context) => {
      let { isDesktop, isMobile, isTablet, reduceMotion } =
        context.conditions as GsapBreakpointsType;

      gsap.set(cards, { clearProps: "all" });

      if (reduceMotion) return;

      cards.forEach((card, i) => {
        const isEven = i % 2 === 0;

        if (isMobile || isTablet) {
          gsap.set(card, {
            x: isEven ? "-100%" : "100%",
            rotation: isEven ? -10 : 10,
            opacity: 0,
          });

          gsap.to(card, {
            ...ANIMATION_CONFIG.mobile,
            scrollTrigger: {
              ...ANIMATION_CONFIG.mobile.scrollTrigger,
              trigger: card,
            },
            x: 0,
            rotation: 0,
            opacity: 1,
          });

          return;
        }

        if (isDesktop) {
          gsap.to(card, {
            scrollTrigger: {
              ...ANIMATION_CONFIG.desktop.scrollTrigger,
              trigger: containerCards,
            },
            x: isEven ? "-20vw" : "20vw",
            rotation: isEven ? -10 : 10,
          });
        }
      });
    });

    return () => mm.revert();
  };

  projectCardsAnimate();
</script>
