---
/**
 * Hero — single owner of the intro and the hero content.
 *
 * Merges what used to be MainBackground.astro (stars canvas + badge/cat
 * curtain) and HeroFan.astro (fanned tech cards + big condensed name).
 *
 * Layer order, bottom to top (S2):
 *   #hero content -> #curtain (opaque) -> #stars-bg (warp) -> #badge-layer
 *
 * The opaque curtain hides the hero while the intro runs, and because the
 * canvas sits ABOVE it the warp stays visible. After the intro the canvas
 * drops back to z-0 so the scroll stars live behind the page content.
 *
 * The word reveal is pure CSS driven by --delay (S4): no GSAP writes
 * inline transform/scale/rotate over hero elements, which is what used to
 * flatten the fanned cards (S3).
 */
import Icon from "astro-iconify";
import { getTranslations } from "../i18n/utils";
import Title from "./typography/Title.astro";

const top = "SOFWARE DEVELOPER";
const bottom = "WANDERLEEDEV";

const lang = Astro.currentLocale as "es" | "en";
const t = getTranslations(lang);

const heroWordsName = "Wanderlee Dev".split(" ");
const heroWordsRoleLine1 = "Fullstack,".split(" ");
const heroWordsRoleLine2 = [t("hero").titleAccent, "&", t("hero").titleEnd];

const stackLogos = [
  { icon: "devicon:postgresql", alt: "PostgreSQL", color: "#336791", rotate: "-rotate-6" },
  { icon: "devicon:nestjs", alt: "NestJS", color: "#E0234E", rotate: "rotate-2" },
  { icon: "devicon:angular", alt: "Angular", color: "#DD0031", rotate: "-rotate-2" },
  { icon: "devicon:nodejs", alt: "Node.js", color: "#339933", rotate: "rotate-6" },
];
---

<section
  id="hero"
  class="relative z-0 h-[110dvh] min-h-[640px] bg-surface flex flex-col items-center justify-center px-4 text-center overflow-hidden"
  aria-label="Presentación"
>
  <p class="hero-fade font-sans text-[11px] tracking-[0.2em] text-muted uppercase mt-1">
    wanderleedev@gmail.com
  </p>

  <Title level={1} class="mt-4 hero-reveal">
    {
      heroWordsName.map((w, i) => (
        <span class="hero-word" style={`--delay:${i}`} aria-hidden="true">
          {w}&nbsp;
        </span>
      ))
    }
  </Title>

  <div class="relative flex items-center justify-center mt-6 mb-6" aria-hidden="true">
    {
      stackLogos.map(({ icon, alt, color, rotate }, i) => (
        <div
          class={`tech-card transform-[scale(var(--card-scale,1))] w-28 h-28 sm:w-32 sm:h-32 md:w-40 md:h-40 rounded-card shadow-[0_14px_35px_-10px_rgba(0,0,0,0.12)] flex items-center justify-center bg-surface border border-line ${rotate} -ml-5 first:ml-0 hover:rotate-0 hover:scale-105 hover:z-10 hover:shadow-[0_20px_45px_-10px_rgba(0,0,0,0.18)] transition-[scale,rotate] duration-500 ease-out`}
          style={`--card-i:${i}`}
          role="img"
          aria-label={alt}
          data-color={color}
        >
          <Icon name={icon} class="w-14 h-14 sm:w-16 sm:h-16 md:w-20 md:h-20" style={{ color }} />
        </div>
      ))
    }
  </div>

  <Title level={2} class="!text-muted !text-[clamp(2rem,7.5vw,5.5rem)] hero-reveal">
    {
      heroWordsRoleLine1.map((w, i) => (
        <span class="hero-word" style={`--delay:${i}`} aria-hidden="true">
          {w}&nbsp;
        </span>
      ))
    }
    <br />
    {
      heroWordsRoleLine2.map((w, i) => (
        <span class="hero-word" style={`--delay:${i + 2}`} aria-hidden="true">
          {w}&nbsp;
        </span>
      ))
    }
  </Title>

  <div class="hero-fade mt-6">
    <p class="font-sans text-xs font-bold tracking-[0.2em] text-ink uppercase">
      {t("hero").subtitle}
    </p>
    <p id="stack" class="font-sans text-[11px] tracking-[0.15em] text-muted uppercase mt-1">
      PostgreSQL · NestJS · Angular · Node.js
    </p>
  </div>
</section>

<!-- Opaque backdrop: hides the hero while the intro runs (S2).
     bg-contrast (--color-contrast), not bg-surface: in the neon theme
     --color-surface is `transparent`, so the curtain would not hide anything.
     z >= 1000 keeps the intro above ThemePicker (z-[999]), matching the
     previous z-1000 curtain; otherwise the picker floats over the intro. -->
<div id="curtain" class="fixed inset-0 z-[1000] bg-contrast" aria-hidden="true"></div>

<!-- Above the curtain, so the warp stays visible (S2) -->
<canvas id="stars-bg" class="fixed inset-0 size-full z-[1001] pointer-events-none" aria-hidden="true"
></canvas>

<!-- Badge sits above the canvas, so the warp never paints over it (S2) -->
<div
  id="badge-layer"
  class="fixed inset-0 z-[1002] grid place-items-center pointer-events-none"
  aria-hidden="true"
>
  <div
    id="pet"
    class="relative z-10 size-40 lg:size-64 rounded-full aspect-square bg-black drop-shadow-lg scale-0 origin-center ease-out-elastic"
    aria-hidden="true"
  >
    <svg viewBox="0 0 300 300" class="absolute inset-0 size-full animate-badge-spin" aria-hidden="true">
      <defs>
        <path id="badge-top" d="M 46 150 A 104 104 0 0 1 254 150"></path>
        <path id="badge-bottom" d="M 24 150 A 126 126 0 0 0 276 150"></path>
      </defs>
      <circle cx="150" cy="150" r="142" class="fill-none stroke-white stroke-[1.5]"></circle>
      <circle cx="150" cy="150" r="98" class="fill-none stroke-white/70 stroke-1"></circle>
      <circle cx="150" cy="150" r="82" class="fill-none stroke-white/30 stroke-1"></circle>
      <circle cx="150" cy="150" r="66" class="fill-none stroke-white/15 stroke-1"></circle>
      <circle cx="36" cy="150" r="3.5" class="fill-blue-500"></circle>
      <circle cx="264" cy="150" r="3.5" class="fill-blue-500"></circle>
      <text class="fill-white text-[26px] font-bold tracking-widest" text-anchor="middle">
        <textPath href="#badge-top" startOffset="50%">{top}</textPath>
      </text>
      <text class="fill-white text-[26px] font-bold tracking-widest" text-anchor="middle">
        <textPath href="#badge-bottom" startOffset="50%">{bottom}</textPath>
      </text>
    </svg>
    <div
      id="cat"
      style="image-rendering: pixelated;"
      class="absolute inset-[20%] rounded-full bg-[url('/cat.webp')] bg-no-repeat bg-cover bg-badge-ink"
      aria-hidden="true">
    </div>
  </div>
</div>

<script is:inline define:vars={{ isDev: import.meta.env.DEV }}>
  // Runs inline right after the curtain exists in the DOM (S5). The old copy
  // lived in <head>, always saw a null #curtain, threw, and was swallowed by
  // an empty catch: the repeat-visit skip never worked and the badge flashed.
  try {
    if (!isDev && localStorage.getItem("wdev-intro-seen") === "1") {
      document.getElementById("curtain").style.display = "none";
      document.getElementById("badge-layer").style.display = "none";
      document.getElementById("stars-bg").style.zIndex = "0";
      document.documentElement.classList.add("hero-ready");
    }
  } catch (e) {}
</script>

<style is:global>
  /* Estados iniciales de la intro. La animación la maneja una única
     timeline de GSAP (ver revealHero en el script): sin transitions ni
     animations CSS compitiendo. Global porque Title.astro renderiza sin
     scope y el selector compuesto de Astro nunca matcheaba. */
  .hero-reveal .hero-word {
    display: inline-block;
    transform-origin: 50% 100%;
    /* transform (no la propiedad `scale`): GSAP anima scaleY sobre el
       transform, así no se multiplican. */
    transform: scaleY(0);
  }

  /* Opacity pura: nunca toca el rotate/scale de Tailwind del fan. */
  #hero .hero-fade {
    opacity: 0;
  }

  /* La escala de entrada vive en --card-scale (propiedad `scale`, que
     compone con el `rotate` de Tailwind). GSAP anima la variable; el
     rotate nunca entra al transform. */
  #hero .tech-card {
    opacity: 0;
    --card-scale: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-reveal .hero-word,
    #hero .hero-fade,
    #hero .tech-card {
      opacity: 1;
      translate: none;
      transform: none;
    }

    #hero .tech-card {
      --card-scale: 1;
    }
  }
</style>


<script>
  import { gsap, ScrollTrigger } from "../lib/gsap";
  import { IS_DEV, storage, reducedMotion } from "../utils/extra";

  window.scrollTo(0, 0);

  const canvas = document.getElementById("stars-bg") as HTMLCanvasElement;
  const ctx = canvas.getContext("2d")!;
  const htmlEl = document.documentElement;
  const curtainEl = document.getElementById("curtain") as HTMLElement;
  const badgeLayerEl = document.getElementById("badge-layer") as HTMLElement;
  const petEl = document.getElementById("pet") as HTMLElement;
  const catEl = document.getElementById("cat") as HTMLElement;

  // ---- Colores del canvas desde los tokens del theme activo ----
  // El navegador resuelve cualquier valor CSS (var, hex, color-mix) a rgb().
  const probe = document.createElement("span");
  probe.style.display = "none";
  document.body.appendChild(probe);

  const resolveColor = (value: string) => {
    probe.style.color = value;
    return getComputedStyle(probe).color;
  };
  const parseRgb = (c: string) => c.match(/[\d.]+/g)!.slice(0, 3).map(Number);

  function themeColors() {
    const [r, g, b] = parseRgb(resolveColor("var(--color-contrast)"));
    return {
      core: parseRgb(resolveColor("var(--color-ink)")),
      acc: parseRgb(resolveColor("var(--ct-acc)")),
      muted: parseRgb(resolveColor("var(--color-muted)")),
      additive: 0.299 * r + 0.587 * g + 0.114 * b < 128,
    };
  }

  let theme = themeColors();
  new MutationObserver(() => {
    theme = themeColors();
  }).observe(htmlEl, { attributes: true, attributeFilter: ["data-theme", "class"] });

  // Sin intro en visitas repetidas (salvo en dev) o con reducedMotion
  const skipIntro = (storage.get() && !IS_DEV) || reducedMotion;

  // El script inline de arriba ya ocultó la cortina cuando pudo; esto cubre
  // los caminos dev / reducedMotion, que sólo se pueden decidir en JS.
  // Botón de tema (dark mode) y selector de idioma: ocultos durante la
  // intro y revelados al final (ver revealHero).
  const pickers = gsap.utils.toArray<HTMLElement>("#theme-trigger, #lang-trigger");

  if (skipIntro) {
    curtainEl.style.display = "none";
    badgeLayerEl.style.display = "none";
    htmlEl.classList.add("hero-ready");
    gsap.set(pickers, { opacity: 1 });
  } else {
    htmlEl.style.overflow = "hidden";
    gsap.set(pickers, { opacity: 0 });
  }

  const WARP_STAR_COUNT = 1500;
  const SCROLL_STAR_COUNT = 350;
  const DEPTH = 1000;
  const FOCAL = 400;
  const MAX_WARP_SPEED = 140;
  const ACCEL_TIME = 6;
  const DECEL_TIME = 2;
  const TRAIL_FACTOR = 5;
  const MAX_SPEED = 40;

  // idle: no pinta nada (el canvas espera al badge); warp; scroll
  type Mode = "idle" | "warp" | "scroll";
  type WarpStar = { x: number; y: number; z: number; px: number; py: number };
  type ScrollStar = { x: number; y: number; z: number; size: number; alpha: number; drift: number };

  let W = 0;
  let H = 0;
  let DPR = 1;
  let cx = 0;
  let cy = 0;
  let warpStars: WarpStar[] = [];
  let scrollStars: ScrollStar[] = [];

  const state = { mode: (skipIntro ? "scroll" : "idle") as Mode, warp: 0, target: 0, v: 0 };

  const rand = (a: number, b: number) => a + Math.random() * (b - a);

  // ---------- Warp (3D) ----------

  function project(s: WarpStar) {
    const k = FOCAL / s.z;
    return { sx: cx + s.x * k, sy: cy + s.y * k };
  }

  function spawnWarp(s: WarpStar, randomZ: boolean) {
    s.x = rand(-1, 1) * W * (DEPTH / FOCAL);
    s.y = rand(-1, 1) * H * (DEPTH / FOCAL);
    s.z = randomZ ? rand(1, DEPTH) : DEPTH;
    const p = project(s);
    s.px = p.sx;
    s.py = p.sy;
  }

  function warpStyle(depthRatio: number, w: number) {
    const core = Math.min(1, 0.4 + 0.6 * depthRatio + 0.3 * w);
    const [cr, cg, cb] = theme.core;
    const [ar, ag, ab] = theme.acc;
    return {
      coreColor: `rgba(${cr}, ${cg}, ${cb}, ${core})`,
      haloColor: `rgba(${ar}, ${ag}, ${ab}, ${core * 0.6 * w * w})`,
      coreWidth: 0.5 + depthRatio * (1.5 + 1.5 * w),
      haloWidth: depthRatio * 5 + w * w * 10,
    };
  }

  function strokeSegment(
    x1: number,
    y1: number,
    x2: number,
    y2: number,
    color: string,
    width: number,
  ) {
    ctx.strokeStyle = color;
    ctx.lineWidth = width;
    ctx.beginPath();
    ctx.moveTo(x1, y1);
    ctx.lineTo(x2, y2);
    ctx.stroke();
  }

  function renderWarp() {
    const speed = state.warp * MAX_WARP_SPEED;

    // Desvanece las estelas hacia transparencia: el canvas nunca tapa el
    // fondo real de la página (en neón es un gradiente, no un color plano).
    ctx.globalCompositeOperation = "destination-out";
    ctx.fillStyle = "rgba(0, 0, 0, 0.35)";
    ctx.fillRect(0, 0, W, H);

    ctx.globalCompositeOperation = theme.additive ? "lighter" : "source-over";
    ctx.lineCap = "round";

    for (const s of warpStars) {
      const prev = project(s);
      s.px = prev.sx;
      s.py = prev.sy;

      s.z -= speed;
      if (s.z <= 1) {
        spawnWarp(s, false);
        continue;
      }

      const curr = project(s);
      const depthRatio = 1 - s.z / DEPTH;
      const st = warpStyle(depthRatio, state.warp);
      strokeSegment(s.px, s.py, curr.sx, curr.sy, st.haloColor, st.haloWidth);
      strokeSegment(s.px, s.py, curr.sx, curr.sy, st.coreColor, st.coreWidth);
    }

    ctx.globalCompositeOperation = "source-over";
  }

  // ---------- Hand-off warp -> scroll ----------
  // Sólo pasan las estrellas visibles, en su posición exacta. No se reubica
  // ni se agrega ninguna, así que la densidad final es la que ya se veía.
  function handOffToScroll() {
    scrollStars = [];
    for (const s of warpStars) {
      const p = project(s);
      if (p.sx < 0 || p.sx > W || p.sy < 0 || p.sy > H) continue;
      const depthRatio = 1 - s.z / DEPTH;
      scrollStars.push({
        x: p.sx,
        y: p.sy,
        z: 0.2 + 0.8 * depthRatio,
        size: 0.5 + depthRatio * 1.5,
        alpha: 0.4 + 0.6 * depthRatio,
        drift: rand(0.05, 0.25) * (0.2 + 0.8 * depthRatio),
      });
    }
    warpStars = [];
    state.mode = "scroll";
    htmlEl.style.overflow = "";
    // Terminada la intro, el canvas vuelve al fondo (z-0)
    canvas.style.zIndex = "0";
    revealHero();
    if (!skipIntro) storage.set();
  }

  // ---------- Scroll (2D) ----------

  function resetScrollStar(s: ScrollStar, fromTop: boolean) {
    s.x = rand(0, W);
    s.y = fromTop ? -10 : H + 10;
    s.z = rand(0.2, 1);
    s.size = rand(0.6, 2) * s.z + 0.3;
    s.alpha = rand(0.4, 1) * s.z + 0.2;
    s.drift = rand(0.05, 0.25) * s.z;
  }

  function renderScroll() {
    state.target *= 0.92;
    state.v += (state.target - state.v) * 0.12;

    ctx.clearRect(0, 0, W, H);
    ctx.lineCap = "round";

    for (const s of scrollStars) {
      const move = state.v * s.z * 0.8 + s.drift;
      s.y += move;

      if (move > 0 && s.y > H + 10) resetScrollStar(s, true);
      if (move < 0 && s.y < -10) resetScrollStar(s, false);

      const tail = move * TRAIL_FACTOR;
      const [cr, cg, cb] = theme.core;
      strokeSegment(s.x, s.y - tail, s.x, s.y, `rgba(${cr}, ${cg}, ${cb}, ${s.alpha})`, s.size);
    }
  }

  // idle: estrellas fijas, sin movimiento ni velo. Así el canvas aparece con
  // el gato y no se anima hasta que el gato termine su animación.
  function renderIdle() {
    ctx.clearRect(0, 0, W, H);
    ctx.globalCompositeOperation = theme.additive ? "lighter" : "source-over";
    const [mr, mg, mb] = theme.muted;
    for (const s of warpStars) {
      const p = project(s);
      const st = warpStyle(1 - s.z / DEPTH, 0);
      ctx.fillStyle = `rgba(${mr}, ${mg}, ${mb}, ${st.coreWidth * 0.6})`;
      ctx.beginPath();
      ctx.arc(p.sx, p.sy, st.coreWidth, 0, Math.PI * 2);
      ctx.fill();
    }
    ctx.globalCompositeOperation = "source-over";
  }

  function render() {
    if (state.mode === "idle") return renderIdle();
    if (state.mode === "warp") renderWarp();
    else renderScroll();
  }

  function resize() {
    DPR = window.devicePixelRatio || 1;
    W = window.innerWidth;
    H = window.innerHeight;
    cx = W / 2;
    cy = H / 2;
    canvas.width = W * DPR;
    canvas.height = H * DPR;
    ctx.setTransform(DPR, 0, 0, DPR, 0, 0);

    if (state.mode !== "scroll") {
      warpStars = Array.from({ length: WARP_STAR_COUNT }, () => {
        const s: WarpStar = { x: 0, y: 0, z: 0, px: 0, py: 0 };
        spawnWarp(s, true);
        return s;
      });
    } else {
      scrollStars = Array.from({ length: SCROLL_STAR_COUNT }, () => {
        const z = rand(0.2, 1);
        return {
          x: rand(0, W),
          y: rand(0, H),
          z,
          size: rand(0.6, 2) * z + 0.3,
          alpha: rand(0.4, 1) * z + 0.2,
          drift: rand(0.05, 0.25) * z,
        };
      });
    }
  }

  resize();
  window.addEventListener("resize", resize);

  ScrollTrigger.create({
    start: 0,
    end: "max",
    onUpdate: (self) => {
      if (state.mode !== "scroll") return;
      state.target = gsap.utils.clamp(-MAX_SPEED, MAX_SPEED, self.getVelocity() / 100);
    },
  });

  gsap.ticker.add(render);

  // ---------- Reveal del Hero: una sola timeline ----------
  // email/stack -> palabras con stagger elástico -> fan de cards.
  // fontWeight del h1 usa steps(1) porque font-weight no interpola.
  function revealHero() {
    htmlEl.classList.add("hero-ready");
    const hero = document.getElementById("hero");
    if (!hero) return;
    const words = hero.querySelectorAll(".hero-reveal .hero-word");
    const fades = hero.querySelectorAll(".hero-fade");
    const cards = hero.querySelectorAll(".tech-card");

    // Entrada de las cards: scale desde el centro, en oleadas simétricas
    // (cada oleada es un par espejo: una card impar y una par). Sin stagger
    // lineal y sin animar opacity: aparecen al 100% y crecen desde el centro.
    const mid = (cards.length - 1) / 2;
    const waves = new Map<number, HTMLElement[]>();
    cards.forEach((card, i) => {
      const key = Math.abs(i - mid);
      const list = waves.get(key) ?? [];
      list.push(card);
      waves.set(key, list);
    });
    const waveKeys = [...waves.keys()].sort((a, b) => a - b);

    const tl = gsap.timeline();
    tl.to(fades, { opacity: 1, duration: 0.6, ease: "power2.out" }, 0)
      .to(words, { scaleY: 1, duration: 0.8, ease: "elastic.out(1, 0.45)", stagger: 0.08 }, 0.1);

    // Opacity sin animación: las cards aparecen de golpe y sólo crece el scale.
    gsap.set(cards, { opacity: 1 });

    // Botón de tema (dark mode) y selector de idioma: aparecen al final.
    waveKeys.forEach((key, w) => {
      tl.to(
        waves.get(key)!,
        { "--card-scale": 1, duration: 0.9, ease: "elastic.out(1, 0.45)" },
        0.45 + w * 0.12,
      );
    });
    tl.to(pickers, { opacity: 1, duration: 0.5, ease: "power2.out" }, "+=0.15");
  }

  // Warp: arranca solo cuando el badge terminó de achicarse
  function startWarp() {
    state.mode = "warp";
    gsap
      .timeline({ onComplete: handOffToScroll })
      .to(state, { warp: 1, duration: ACCEL_TIME, ease: "power2.in" })
      .to(state, { warp: 0, duration: DECEL_TIME, ease: "power2.out" });
  }

  if (skipIntro) {
    state.mode = "scroll";
    gsap.set("#hero .hero-reveal .hero-word", { scaleY: 1 });
    gsap.set("#hero .hero-fade", { opacity: 1 });
    gsap.set("#hero .tech-card", { opacity: 1, "--card-scale": 1 });
  } else {
    // Badge aparece con el canvas quieto; al terminar la animación del gato
    // arranca el warp, junto con su salida.
    const badgeTl = gsap.timeline({
      paused: true,
      onComplete: () => {
        badgeLayerEl.style.display = "none";
        curtainEl.style.display = "none";
      },
    });

    // El `animationend` del gato es la señal para continuar, pero si por
    // cualquier motivo no dispara (fuente, tab oculta, animation cancelada),
    // el fallback por tiempo evita que la intro quede trabada con las
    // cards en opacity 0. Bandera once: solo el primero que llegue resume.
    let badgeResumed = false;
    const resumeBadge = () => {
      if (badgeResumed) return;
      badgeResumed = true;
      badgeTl.resume();
    };

    badgeTl
      .to(petEl, { scale: 1, delay: 0.3 })
      .call(() => {
        badgeTl.pause();
        catEl.classList.add("animate-move-x");
        catEl.addEventListener("animationend", resumeBadge, { once: true });
        window.setTimeout(resumeBadge, 3500);
      })
      .call(startWarp)
      .to(petEl, { scale: 0, duration: 0.4, ease: "power3.in" });

    // Última red: si a los 20s el hero no hizo reveal, se fuerza el
    // hand-off para no dejar la página con el contenido invisible.
    window.setTimeout(() => {
      if (!htmlEl.classList.contains("hero-ready")) {
        try {
          handOffToScroll();
        } catch {
          /* el hand-off ya corrió o el canvas no existe */
        }
      }
    }, 20000);

    Promise.race([document.fonts.ready, new Promise((r) => setTimeout(r, 1500))]).then(() =>
      badgeTl.play(),
    );
  }
</script>