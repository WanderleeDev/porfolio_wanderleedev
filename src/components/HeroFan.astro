---
/**
 * Redesign hero — Spencer Gabor language:
 * white canvas, huge condensed name, fanned illustration cards,
 * big grey role line, clients strip.
 * Content: WanderleeDev portfolio (own projects from Cloudinary).
 */
import Icon from "astro-iconify";
import { getTranslations } from "../i18n/utils";

const stackLogos = [
  {
    icon: "devicon:postgresql",
    alt: "PostgreSQL",
    color: "#336791",
    rotate: "-rotate-6",
  },
  {
    icon: "devicon:nestjs",
    alt: "NestJS",
    color: "#E0234E",
    rotate: "rotate-2",
  },
  {
    icon: "devicon:angular",
    alt: "Angular",
    color: "#DD0031",
    rotate: "-rotate-2",
  },
  {
    icon: "devicon:nodejs",
    alt: "Node.js",
    color: "#339933",
    rotate: "rotate-6",
  },
];

const lang = Astro.currentLocale as "es" | "en";
const t = getTranslations(lang);
---

<section
  id="hero"
  class="h-[110dvh] min-h-[640px] bg-surface flex flex-col items-center justify-center px-4 text-center overflow-hidden"
  aria-label="Presentación"
>
  <p class="font-sans text-[11px] tracking-[0.2em] text-muted uppercase mt-1">
    wanderleedev@gmail.com
  </p>

  <h1
    id="hero-name"
    class="font-fira-sans-extra-condensed font-black uppercase text-ink leading-[0.9] mt-4 text-[clamp(3rem,10vw,8rem)] tracking-tight"
  >
    Wanderlee Dev
  </h1>

  <div
    class="relative flex items-center justify-center mt-6 mb-6"
    aria-hidden="true"
  >
    {
      stackLogos.map(({ icon, alt, color, rotate }) => (
        <div
          class={`tech-card w-28 h-28 sm:w-32 sm:h-32 md:w-40 md:h-40 rounded-2xl shadow-[0_14px_35px_-10px_rgba(0,0,0,0.12)] flex items-center justify-center bg-surface border border-line ${rotate} -ml-5 first:ml-0 hover:rotate-0 hover:scale-105 hover:z-10 hover:shadow-[0_20px_45px_-10px_rgba(0,0,0,0.18)] transition-transform duration-500 ease-out`}
          role="img"
          aria-label={alt}
          data-color={color}
        >
          <Icon
            name={icon}
            class="w-14 h-14 sm:w-16 sm:h-16 md:w-20 md:h-20"
            style={{ color }}
          />
        </div>
      ))
    }
  </div>

  <h2
    id="hero-role"
    class="font-fira-sans-extra-condensed font-black uppercase text-muted leading-[0.95] text-[clamp(2rem,7.5vw,5.5rem)]"
  >
    Fullstack,<br />
    {t("hero").titleAccent} & {t("hero").titleEnd}
  </h2>

  <div class="mt-6">
    <p class="font-sans text-xs font-bold tracking-[0.2em] text-ink uppercase">
      {t("hero").subtitle}
    </p>
    <p id="stack" class="font-sans text-[11px] tracking-[0.15em] text-muted uppercase mt-1">
      PostgreSQL · NestJS · Angular · Node.js
    </p>
  </div>
</section>

<style>
@property --hero-color-1 {
  syntax: "<color>";
  inherits: false;
  initial-value: transparent;
}

@property --hero-color-2 {
  syntax: "<color>";
  inherits: false;
  initial-value: transparent;
}

@property --hero-color-3 {
  syntax: "<color>";
  inherits: false;
  initial-value: transparent;
}

@property --hero-color-4 {
  syntax: "<color>";
  inherits: false;
  initial-value: transparent;
}

#hero {
  --hero-color-1: transparent;
  --hero-color-2: transparent;
  --hero-color-3: transparent;
  --hero-color-4: transparent;
 mask-image: linear-gradient(
  #000 0,
  #000 90%,
  #0000 100%
);

  background: linear-gradient(
    135deg,
    var(--hero-color-1) 0%,
    var(--hero-color-2) 25%,
    var(--hero-color-3) 75%,
    var(--hero-color-4) 100%
  );

  transition:
    --hero-color-1 500ms ease,
    --hero-color-2 500ms ease,
    --hero-color-3 500ms ease,
    --hero-color-4 500ms ease,
    font-weight 500ms ease;

  &:has(.tech-card:hover) #stack {
    color: #fff;
  }

  &:has(.tech-card:nth-child(1):hover) {
    --hero-color-1: #1b2a41;
    --hero-color-2: #336791;
    --hero-color-3: #00a6fb;
    --hero-color-4: #a9def9;
    & #stack {
        font-weight: 900;
    }
  }

  &:has(.tech-card:nth-child(2):hover) {
    --hero-color-1: #5c001f;
    --hero-color-2: #e0234e;
    --hero-color-3: #a000ff;
    --hero-color-4: #ff7eb6;
  }

  &:has(.tech-card:nth-child(3):hover) {
    --hero-color-1: #ff0057;
    --hero-color-2: #dd0031;
    --hero-color-3: #a000ff;
    --hero-color-4: #6a00ff;
  }

  &:has(.tech-card:nth-child(4):hover) {
    --hero-color-1: #164e24;
    --hero-color-2: #339933;
    --hero-color-3: #84cc16;
    --hero-color-4: #d9f99d;
  }

}
</style>

<style>
  .hero-word {
    display: inline-block;
  }
</style>

<script>
  import gsap from "gsap";
  import { SplitText } from "gsap/SplitText";
  gsap.registerPlugin(SplitText);

  const BOUNCE_SOFT =
    "linear(0, .5737 7.6%, .8382 11.87%, .9463 14.19%, 1.0292 16.54%, 1.0886 18.97%, 1.1258 21.53%, 1.137 22.97%, 1.1424 24.48%, 1.1423 26.1%, 1.1366 27.86%, 1.1165 31.01%, 1.0507 38.62%, 1.0219 42.57%, .9995 46.99%, .9872 51.63%, .9842 58.77%, 1.0011 81.26%, 1)";

  function heroWordReveal() {
    gsap.matchMedia().add(
      "(prefers-reduced-motion: no-preference)",
      () => {
        ["hero-name", "hero-role"].forEach((id) => {
          const el = document.getElementById(id);
          if (!el || el.dataset.wired) return;
          el.dataset.wired = "true";

          const split = SplitText.create(el, {
            type: "words",
            wordsClass: "hero-word",
          });

          gsap.from(split.words, {
            opacity: 0,
            y: 60,
            duration: 0.9,
            stagger: 0.08,
            ease: BOUNCE_SOFT,
          });
        });
      },
    );
  }

  document.addEventListener("astro:page-load", heroWordReveal);
  heroWordReveal();
</script>
