---
/**
 * Redesign hero — Spencer Gabor language:
 * white canvas, huge condensed name, fanned illustration cards,
 * big grey role line, clients strip.
 * Content: WanderleeDev portfolio (own projects from Cloudinary).
 */
import Icon from "astro-iconify";
import { getTranslations } from "../i18n/utils";

const stackLogos = [
  {
    icon: "devicon:postgresql",
    alt: "PostgreSQL",
    color: "#336791",
    rotate: "-rotate-6",
  },
  {
    icon: "devicon:nestjs",
    alt: "NestJS",
    color: "#E0234E",
    rotate: "rotate-2",
  },
  {
    icon: "devicon:angular",
    alt: "Angular",
    color: "#DD0031",
    rotate: "-rotate-2",
  },
  {
    icon: "devicon:nodejs",
    alt: "Node.js",
    color: "#339933",
    rotate: "rotate-6",
  },
];

const lang = Astro.currentLocale as "es" | "en";
const t = getTranslations(lang);
---

<section
  class="h-dvh min-h-[640px] bg-surface flex flex-col items-center justify-center px-4 text-center overflow-hidden"
  aria-label="Presentación"
>
  <p class="font-sans text-[11px] tracking-[0.2em] text-muted uppercase mt-1">
    wanderleedev@gmail.com
  </p>

  <h1
    class="font-fira-sans-extra-condensed font-black uppercase text-ink leading-[0.9] mt-4 text-[clamp(3rem,10vw,8rem)] tracking-tight"
  >
    Wanderlee Dev
  </h1>

  <div
    class="relative flex items-center justify-center mt-6 mb-6"
    aria-hidden="true"
  >
    {
      stackLogos.map(({ icon, alt, color, rotate }) => (
        <div
          class={`w-28 h-28 sm:w-32 sm:h-32 md:w-40 md:h-40 rounded-2xl shadow-[0_14px_35px_-10px_rgba(0,0,0,0.12)] flex items-center justify-center bg-surface border border-line ${rotate} -ml-5 first:ml-0 hover:rotate-0 hover:scale-105 hover:z-10 hover:shadow-[0_20px_45px_-10px_rgba(0,0,0,0.18)] transition-transform duration-500 ease-out`}
          role="img"
          aria-label={alt}
        >
          <Icon
            name={icon}
            class="w-14 h-14 sm:w-16 sm:h-16 md:w-20 md:h-20"
            style={{ color }}
          />
        </div>
      ))
    }
  </div>

  <h2
    class="font-fira-sans-extra-condensed font-black uppercase text-muted leading-[0.95] text-[clamp(2rem,7.5vw,5.5rem)]"
  >
    Fullstack,<br />
    {t("hero").titleAccent} & {t("hero").titleEnd}
  </h2>

  <div class="mt-6">
    <p class="font-sans text-xs font-bold tracking-[0.2em] text-ink uppercase">
      {t("hero").subtitle}
    </p>
    <p class="font-sans text-[11px] tracking-[0.15em] text-muted uppercase mt-1">
      PostgreSQL · NestJS · Angular · Node.js
    </p>
  </div>
</section>
