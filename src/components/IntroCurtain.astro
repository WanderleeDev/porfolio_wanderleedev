---
const top = "SOFWARE DEVELOPER";
const bottom = "WANDERLEEDEV";
---

<div
  id="curtain"
  class="fixed inset-0 z-1000 grid grid-rows-2 size-full overflow-hidden"
  aria-hidden="true"
>
  <div id="bar-1" class="bg-red-400 size-full origin-right"></div>
  <div id="bar-2" class="bg-blue-400 size-full origin-left"></div>

  <div
    id="pet"
    class="absolute inset-0 m-auto z-10 size-40 lg:size-64 rounded-full aspect-square bg-black drop-shadow-lg scale-0 origin-center ease-out-elastic"
    aria-hidden="true"
  >
    <svg
      viewBox="0 0 300 300"
      class="absolute inset-0 size-full animate-badge-spin"
      aria-hidden="true"
    >
      <defs>
        <path id="badge-top" d="M 46 150 A 104 104 0 0 1 254 150"></path>
        <path id="badge-bottom" d="M 24 150 A 126 126 0 0 0 276 150"></path>
      </defs>

      <circle
        cx="150"
        cy="150"
        r="142"
        class="fill-none stroke-white stroke-[1.5]"></circle>
      <circle
        cx="150"
        cy="150"
        r="98"
        class="fill-none stroke-white/70 stroke-1"></circle>
      <circle
        cx="150"
        cy="150"
        r="82"
        class="fill-none stroke-white/30 stroke-1"></circle>
      <circle
        cx="150"
        cy="150"
        r="66"
        class="fill-none stroke-white/15 stroke-1"></circle>

      <circle cx="36" cy="150" r="3.5" class="fill-blue-500"></circle>
      <circle cx="264" cy="150" r="3.5" class="fill-blue-500"></circle>

      <text
        class="fill-white text-[26px] font-bold tracking-widest"
        text-anchor="middle"
      >
        <textPath href="#badge-top" startOffset="50%">{top}</textPath>
      </text>
      <text
        class="fill-white text-[26px] font-bold tracking-widest"
        text-anchor="middle"
      >
        <textPath href="#badge-bottom" startOffset="50%">{bottom}</textPath>
      </text>
    </svg>

    <div
      id="cat"
      style="image-rendering: pixelated;"
      class="absolute inset-[20%] rounded-full bg-[url('/cat.webp')] bg-no-repeat bg-cover bg-badge-ink"
      aria-hidden="true"
    >
    </div>
  </div>
</div>

<script>
  import { gsap } from "../lib/gsap";
  import { IS_DEV, storage, reducedMotion } from "../utils/extra";
  import { $ } from "../utils/selectors";

  (function initIntro() {
    const rootEl = document.documentElement;
    const curtainEl = $<HTMLElement>("#curtain");
    const barEl1 = $<HTMLElement>("#bar-1");
    const barEl2 = $<HTMLElement>("#bar-2");
    const petEl = $<HTMLElement>("#pet");
    const catEl = $<HTMLElement>("#cat");

    if (!curtainEl || !barEl1 || !barEl2 || !petEl || !catEl) {
      return;
    }

    if ((storage.get() && !IS_DEV) || reducedMotion) {
      curtainEl!.style.display = "none";
      return;
    }

    const tl = gsap.timeline({
      paused: true,
      onStart: () => gsap.set(rootEl, { overflow: "hidden" }),
      onComplete: () => {
        storage.set();
        gsap.set(rootEl, { overflow: "unset" });
        curtainEl.style.display = "none";
      },
    });

    tl.to(petEl, { scale: 1, delay: 0.3 })
      .call(() => {
        tl.pause();
        catEl.classList.add("animate-move-x");
        catEl.addEventListener("animationend", () => tl.resume(), {
          once: true,
        });
      })
      .to(petEl, { scale: 0, duration: 0.4, ease: "power3.in" })
      .to(barEl1, { scaleX: 0, duration: 0.8, ease: "expo.inOut" }, "-=0.15")
      .to(barEl2, { scaleX: 0, duration: 0.8, ease: "expo.inOut" }, "<0.08");

    Promise.race([
      document.fonts.ready,
      new Promise((r) => setTimeout(r, 1500)),
    ]).then(() => tl.play());
  })();
</script>
