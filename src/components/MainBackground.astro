<canvas id="stars-bg" class="fixed inset-0 size-full z-0 pointer-events-none" aria-hidden="true"></canvas>

<script>
  import { gsap } from "../lib/gsap";

  const canvas = document.getElementById("stars-bg") as HTMLCanvasElement;
  const ctx = canvas.getContext("2d")!;

  const STAR_COUNT = 350;
  const TRAIL_FACTOR = 5;
  const MAX_SPEED = 40;

  let W = 0;
  let H = 0;
  let DPR = 1;
  let stars: ReturnType<typeof createStar>[] = [];

  const state = { target: 0, v: 0 };

  const rand = (a: number, b: number) => a + Math.random() * (b - a);

  function createStar() {
    const z = rand(0.2, 1);
    return {
      x: rand(0, W),
      y: rand(0, H),
      z,
      size: rand(0.6, 2) * z + 0.3,
      alpha: rand(0.4, 1) * z + 0.2,
      drift: rand(0.05, 0.25) * z,
    };
  }

  function resetStar(s: ReturnType<typeof createStar>, fromTop: boolean) {
    s.x = rand(0, W);
    s.y = fromTop ? -10 : H + 10;
    s.z = rand(0.2, 1);
    s.size = rand(0.6, 2) * s.z + 0.3;
    s.alpha = rand(0.4, 1) * s.z + 0.2;
    s.drift = rand(0.05, 0.25) * s.z;
  }

  function resize() {
    DPR = window.devicePixelRatio || 1;
    W = window.innerWidth;
    H = window.innerHeight;
    canvas.width = W * DPR;
    canvas.height = H * DPR;
    ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
    stars = Array.from({ length: STAR_COUNT }, createStar);
  }

  resize();
  window.addEventListener("resize", resize);

  ScrollTrigger.create({
    start: 0,
    end: "max",
    onUpdate: (self) => {
      state.target = gsap.utils.clamp(-MAX_SPEED, MAX_SPEED, self.getVelocity() / 100);
    },
  });

  function render() {
    state.target *= 0.92;
    state.v += (state.target - state.v) * 0.12;

    ctx.clearRect(0, 0, W, H);
    ctx.lineCap = "round";

    for (const s of stars) {
      const move = state.v * s.z * 0.8 + s.drift;
      s.y += move;

      if (move > 0 && s.y > H + 10) resetStar(s, true);
      if (move < 0 && s.y < -10) resetStar(s, false);

      const tail = move * TRAIL_FACTOR;

      ctx.strokeStyle = `rgba(200, 220, 255, ${s.alpha})`;
      ctx.lineWidth = s.size;
      ctx.beginPath();
      ctx.moveTo(s.x, s.y - tail);
      ctx.lineTo(s.x, s.y);
      ctx.stroke();
    }
  }

  gsap.ticker.add(render);
</script>