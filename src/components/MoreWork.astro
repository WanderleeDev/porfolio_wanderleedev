---
/**
 * More Work — Angular vs React.
 * Banner 2:1 dividido por un corte diagonal. En escritorio la entrada es
 * scroll-driven (solo con soporte y sin reduced motion); en móvil se apila.
 */
import Icon from "astro-iconify";

type Tier = "near" | "mid" | "far";
type Side = "angular" | "react";

interface VsTag {
  label: string;
  side: Side;
  x: number; // posición escritorio (%)
  y: number;
  mx: number; // posición móvil (%)
  my: number;
  tz: number; // profundidad (px)
  rz: number; // rotación (deg)
  tier: Tier;
  drift: number; // duración de la flotación (s)
  start: number; // % del scroll donde empieza a aparecer
}

const TAGS: VsTag[] = [
  { label: "Signals",    side: "angular", x: 13, y: 20, mx: 16, my: 10, tz: 90,  rz: -4, tier: "near", drift: 7,  start: 58 },
  { label: "NgRx",       side: "angular", x: 38, y: 82, mx: 80, my: 34, tz: 45,  rz: 3,  tier: "mid",  drift: 9,  start: 60.5 },
  { label: "RxJS",       side: "angular", x: 8,  y: 48, mx: 12, my: 32, tz: 130, rz: -2, tier: "far",  drift: 11, start: 63 },
  { label: "Standalone", side: "angular", x: 44, y: 12, mx: 76, my: 10, tz: 20,  rz: 2,  tier: "mid",  drift: 8,  start: 65.5 },
  { label: "useEffect",  side: "react",   x: 88, y: 22, mx: 82, my: 60, tz: 90,  rz: 4,  tier: "near", drift: 8,  start: 68 },
  { label: "useState",   side: "react",   x: 60, y: 78, mx: 24, my: 84, tz: 45,  rz: -3, tier: "mid",  drift: 7,  start: 70.5 },
  { label: "Suspense",   side: "react",   x: 86, y: 78, mx: 78, my: 86, tz: 130, rz: 2,  tier: "far",  drift: 10, start: 73 },
  { label: "JSX",        side: "react",   x: 62, y: 32, mx: 18, my: 60, tz: 20,  rz: -2, tier: "mid",  drift: 9,  start: 75.5 },
];

// Un solo origen para el corte: el SVG y los recortes de fondo usan estos puntos (en %).
// Los valores fuera de 0–100 son intencionales: el corte cubre todo el banner.
const CRACK: [number, number][] = [
  [55, -4],
  [47.9, 50],
  [53.6, 50],
  [46.25, 104],
];
const pt = ([x, y]: [number, number]) => `${x}% ${y}%`;
const [top, midL, midR, bot] = CRACK;

const clipLeft = `polygon(-20% -4%, ${pt(top)}, ${pt(midL)}, ${pt(midR)}, ${pt(bot)}, -20% 104%)`;
const clipRight = `polygon(${pt(top)}, 120% -4%, 120% 104%, ${pt(bot)}, ${pt(midR)}, ${pt(midL)})`;
const crackD = CRACK.map(([x, y], i) => `${i === 0 ? "M" : "L"}${x * 12} ${y * 6}`).join(" ");

// Móvil: corte horizontal, Angular arriba y React abajo
const clipLeftM = "polygon(0 0, 100% 0, 100% 44%, 0 56%)";
const clipRightM = "polygon(0 56%, 100% 44%, 100% 100%, 0 100%)";
---

<div class="vs-scroll">
  <div class="vs-sticky">
    <div class="vs-banner" role="img" aria-label="Angular vs React">
      <div
        class="vs-bg vs-bg-left"
        style={`--clip-d: ${clipLeft}; --clip-m: ${clipLeftM};`}
        aria-hidden="true"></div>
      <div
        class="vs-bg vs-bg-right"
        style={`--clip-d: ${clipRight}; --clip-m: ${clipRightM};`}
        aria-hidden="true"></div>

      <svg class="vs-crack" viewBox="0 0 1200 600" preserveAspectRatio="none" aria-hidden="true">
        <path class="crack-edge" d={crackD} pathLength="1" />
      </svg>

      <div class="vs-tags" aria-hidden="true">
        {TAGS.map((t) => (
          <span
            class={`vs-tag vs-tag--${t.tier}`}
            style={`--x: ${t.x}%; --y: ${t.y}%; --mx: ${t.mx}%; --my: ${t.my}%; --tz: ${t.tz}px; --rz: ${t.rz}deg; --drift: ${t.drift}s; --start: ${t.start}%;`}
          >
            {t.label}
          </span>
        ))}
      </div>

      <div class="vs-half">
        <Icon name="devicon:angular" class="vs-logo vs-logo--angular" />
        <p class="vs-label">Angular</p>
      </div>
      <div class="vs-half vs-half--right">
        <Icon name="devicon:react" class="vs-logo vs-logo--react" />
        <p class="vs-label">React</p>
      </div>
    </div>
  </div>
</div>

<style>
  /* ── Base: estática, siempre visible ── */
  .vs-banner {
    position: relative;
    width: 100%;
    aspect-ratio: 2 / 1;
    max-height: 100dvh;
    overflow: hidden;
    container-type: inline-size; /* cqw dentro del banner */
    display: grid;
    grid-template-columns: 1fr 1fr;
    perspective: 1200px;
    mask-image: linear-gradient(to bottom, transparent, #000 2%, #000 98%, transparent);
  }

  .vs-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .vs-bg-left {
    clip-path: var(--clip-d);
    background:
      radial-gradient(50% 65% at 30% 35%, rgba(255, 110, 150, 0.55), transparent 72%),
      radial-gradient(70% 90% at 85% 85%, rgba(60, 10, 40, 0.55), transparent 70%),
      linear-gradient(135deg, #3a0a2e 0%, #7a1243 45%, #b81e5b 78%, #ff2d78 100%);
  }

  .vs-bg-right {
    clip-path: var(--clip-d);
    background:
      radial-gradient(60% 80% at 85% 50%, rgba(255, 255, 255, 0.18), transparent 70%),
      radial-gradient(65% 90% at 78% 30%, rgba(180, 230, 255, 0.4), transparent 65%),
      linear-gradient(135deg, #6f9fd8 0%, #8fc0f5 45%, #9dd0fb 75%, #c4e6ff 100%);
  }

  .vs-crack {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .crack-edge {
    fill: none;
    stroke: #fff;
    stroke-width: 8;
    vector-effect: non-scaling-stroke;
    filter: drop-shadow(0 0 6px rgba(255, 255, 255, 0.25));
  }

  .vs-half {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(0.5rem, 1.2cqw, 1.25rem);
    padding: clamp(0.5rem, 1.5cqw, 1.5rem);
  }

  .vs-tags {
    position: absolute;
    inset: 0;
    z-index: 0;
    transform-style: preserve-3d;
    pointer-events: none;
  }

  .vs-tag {
    position: absolute;
    left: var(--x);
    top: var(--y);
    transform: translate(-50%, -50%) translateZ(var(--tz)) rotate(var(--rz));
    font-family: var(--font-sans, "Inter", ui-sans-serif, system-ui, sans-serif);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    white-space: nowrap;
    color: #fff;
    background: rgba(255, 255, 255, 0.14);
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 999px;
    padding: 0.45em 1.1em;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.35);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
  }

  .vs-tag--near { font-size: clamp(0.7rem, 1.8cqw, 1rem); }
  .vs-tag--mid  { font-size: clamp(0.6rem, 1.4cqw, 0.8rem); opacity: 0.9; }
  .vs-tag--far  { font-size: clamp(0.5rem, 1.1cqw, 0.65rem); opacity: 0.7; }

  .vs-logo {
    width: clamp(96px, 20cqw, 240px);
    height: auto;
    display: block;
    filter: drop-shadow(0 6px 24px rgba(255, 255, 255, 0.45))
      drop-shadow(0 2px 8px rgba(0, 0, 0, 0.18));
  }

  .vs-logo--react {
    width: clamp(96px, 19cqw, 230px);
  }

  /* devicon:react trae fill en el SVG: un fill de CSS lo sobrescribe */
  :global(.vs-logo--react *) {
    fill: #0389d1;
  }

  .vs-label {
    margin: 0;
    color: #fff;
    font-family: var(--font-sans, "Inter", ui-sans-serif, system-ui, sans-serif);
    font-weight: 700;
    font-size: clamp(0.85rem, 2.4cqw, 1.4rem);
    letter-spacing: 0.4em;
    text-indent: 0.4em;
    text-transform: uppercase;
    text-align: center;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.25);
  }

  /* ── Móvil ── */
  @media (max-width: 640px) {
    .vs-banner {
      grid-template-columns: 1fr;
      grid-template-rows: 1fr 1fr;
      aspect-ratio: auto;
      min-height: 80svh;
    }

    .vs-bg-left { clip-path: var(--clip-m); }
    .vs-bg-right { clip-path: var(--clip-m); }

    .vs-crack { display: none; }

    .vs-tag {
      left: var(--mx);
      top: var(--my);
    }
  }

  /* ── Entrada scroll-driven: solo con soporte y sin reduced motion ── */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .vs-scroll {
        position: relative;
        height: 200dvh;
        view-timeline: --vs-enter block;
      }

      .vs-sticky {
        position: sticky;
        top: 0;
        height: 100dvh;
        display: flex;
        align-items: center;
        overflow: hidden;
      }

      .vs-bg-left,
      .vs-bg-right {
        animation: bg-paint linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 100%;
      }

      .vs-bg-left { transform-origin: left center; }
      .vs-bg-right { transform-origin: right center; }

      .crack-edge {
        stroke-dasharray: 1;
        stroke-dashoffset: 1;
        animation: crack-draw linear both;
        animation-timeline: --vs-enter;
        animation-range: cover 36% cover 48%;
      }

      .vs-logo--angular {
        animation: logo-from-top linear both;
        animation-timeline: --vs-enter;
        animation-range: cover 28% cover 38%;
      }

      .vs-logo--react {
        animation: logo-from-bottom linear both;
        animation-timeline: --vs-enter;
        animation-range: cover 28% cover 38%;
      }

      .vs-tag {
        animation:
          tag-in linear both,
          vs-drift var(--drift) ease-in-out infinite alternate;
        animation-timeline: --vs-enter, auto;
        animation-range: cover var(--start) cover calc(var(--start) + 10%), normal;
      }

      @keyframes bg-paint {
        from { transform: scaleX(0); }
      }

      @keyframes crack-draw {
        to { stroke-dashoffset: 0; }
      }

      @keyframes logo-from-top {
        from { opacity: 0; translate: 0 -48px; scale: 0.9; }
      }

      @keyframes logo-from-bottom {
        from { opacity: 0; translate: 0 48px; scale: 0.9; }
      }

      @keyframes tag-in {
        from { opacity: 0; scale: 0.8; }
      }

      @keyframes vs-drift {
        from { translate: 0 0; }
        to { translate: 0 -12px; }
      }
    }
  }
</style>