---
/**
 * More Work — Angular vs React banner.
 * Full-width 2:1 split: red Angular half vs blue React half, divided by a
 * single diagonal white crack (lightning switch, inline SVG).
 *  - Logos via astro-iconify (devicon:angular / devicon:react), same as HeroFan
 *  - Two stacked background blocks + crack SVG; each column visually centered
 */
import Icon from "astro-iconify";

interface VsTag {
  label: string;
  x: string;
  y: string;
  tz: string;
  rz: string;
  tier: "near" | "mid" | "far";
  drift: string;
}

const angularTags: VsTag[] = [
  { label: "Signals",    x: "13%", y: "20%", tz: "90px",  rz: "-4deg", tier: "near", drift: "7s" },
  { label: "NgRx",       x: "38%", y: "82%", tz: "45px",  rz: "3deg",  tier: "mid",  drift: "9s" },
  { label: "RxJS",       x: "8%",  y: "48%", tz: "130px", rz: "-2deg", tier: "far",  drift: "11s" },
  { label: "Standalone", x: "44%", y: "12%", tz: "20px",  rz: "2deg",  tier: "mid",  drift: "8s" },
];

const reactTags: VsTag[] = [
  { label: "useEffect", x: "88%", y: "22%", tz: "90px",  rz: "4deg",  tier: "near", drift: "8s" },
  { label: "useState",  x: "60%", y: "78%", tz: "45px",  rz: "-3deg", tier: "mid",  drift: "7s" },
  { label: "Suspense",  x: "86%", y: "78%", tz: "130px", rz: "2deg",  tier: "far",  drift: "10s" },
  { label: "JSX",       x: "62%", y: "32%", tz: "20px",  rz: "-2deg", tier: "mid",  drift: "9s" },
];
---

<div class="vs-scroll">
<div class="vs-sticky">
<div class="vs-banner" role="img" aria-label="Angular vs React">
  <!-- Background split: red left, blue right -->
  <div class="vs-bg vs-bg-left" aria-hidden="true"></div>
  <div class="vs-bg vs-bg-right" aria-hidden="true"></div>

  <!-- Diagonal white crack, single SVG path on top -->
  <svg class="vs-crack" viewBox="0 0 1200 600" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <path
      class="crack-edge"
      d="M660 -20 L575 300 L643 300 L555 620"
      pathLength="1"
      fill="none"
      stroke="#fff"
      stroke-width="8"
      vector-effect="non-scaling-stroke"
    />
  </svg>

  <!-- Floating tech tags with depth (behind the logos) -->
  <div class="vs-tags" aria-hidden="true">
    {[...angularTags, ...reactTags].map((tag) => (
      <span
        class={`vs-tag vs-tag--${tag.tier}`}
        style={`left:${tag.x};top:${tag.y};--tz:${tag.tz};--rz:${tag.rz};animation-duration:${tag.drift};`}
      >
        {tag.label}
      </span>
    ))}
  </div>

  <!-- Two centered halves -->
  <div class="vs-half">
    <Icon name="devicon:angular" class="vs-logo" alt="Angular" />
    <p class="vs-label">Angular</p>
  </div>
  <div class="vs-half vs-half-right">
    <Icon name="devicon:react" class="vs-logo vs-logo-react" alt="React" />
    <p class="vs-label">React</p>
  </div>
</div>
</div>
</div>

<script>
  // devicon:react ships a hardcoded fill="#61dafb" on its inner <g>, which beats CSS.
  // Strip the fill attribute so the brand blue below applies cleanly.
  function bootMoreWork() {
    document.querySelectorAll(".vs-logo-react [fill]").forEach((el) => el.removeAttribute("fill"));
  }

  document.addEventListener("astro:page-load", bootMoreWork);
  bootMoreWork();
</script>

<style>
  /* Wrapper doble alto: el contenido queda fijo mientras la coreografía avanza */
  .vs-scroll {
    position: relative;
    height: 200dvh;
    view-timeline-name: --vs-enter;
    view-timeline-axis: block;
  }

  .vs-sticky {
    position: sticky;
    top: 0;
    height: 100dvh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .vs-banner {
    position: relative;
    width: 100%;
    aspect-ratio: 2 / 1;
    max-height: 100dvh;
    overflow: hidden;
    display: grid;
    grid-template-columns: 1fr 1fr;
    perspective: 1200px;
    /* Fade casi nulo arriba y abajo — 2%/98% para un despeje prácticamente invisible */
    mask-image: linear-gradient(to bottom, transparent 0, #000 2%, #000 98%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 2%, #000 98%, transparent 100%);
  }

  .vs-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .vs-bg-left {
    clip-path: polygon(0 0, 54.17% 0, 47.92% 49.5%, 53.58% 49.5%, 47.08% 100%, 0 100%);
    background:
      radial-gradient(50% 65% at 30% 35%, rgba(255, 110, 150, 0.55), transparent 72%),
      radial-gradient(70% 90% at 85% 85%, rgba(60, 10, 40, 0.55), transparent 70%),
      linear-gradient(135deg, #3a0a2e 0%, #7a1243 45%, #b81e5b 78%, #ff2d78 100%);
  }
  .vs-bg-right {
    clip-path: polygon(54.17% 0, 100% 0, 100% 100%, 47.08% 100%, 53.58% 49.5%, 47.92% 49.5%);
    background:
      radial-gradient(60% 80% at 85% 50%, rgba(255, 255, 255, 0.18), transparent 70%),
      radial-gradient(65% 90% at 78% 30%, rgba(180, 230, 255, 0.4), transparent 65%),
      linear-gradient(135deg, #6f9fd8 0%, #8fc0f5 45%, #9dd0fb 75%, #c4e6ff 100%);
  }

  .vs-crack {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .vs-crack .crack-edge {
    filter: drop-shadow(0 0 6px rgba(255, 255, 255, 0.25));
  }

  .vs-half {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(0.5rem, 1.2cqw, 1.25rem);
    padding: clamp(0.5rem, 1.5cqw, 1.5rem);
  }

  /* ── Capa de tags con profundidad (detrás de los logos) ── */
  .vs-tags {
    position: absolute;
    inset: 0;
    z-index: 0;
    transform-style: preserve-3d;
    pointer-events: none;
  }

  .vs-tag {
    position: absolute;
    transform: translate(-50%, -50%) translateZ(var(--tz, 40px)) rotate(var(--rz, 0deg));
    font-family: var(--font-sans, "Inter", ui-sans-serif, system-ui, sans-serif);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    white-space: nowrap;
    color: #fff;
    background: rgba(255, 255, 255, 0.13);
    border: 1px solid rgba(255, 255, 255, 0.35);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border-radius: 999px;
    padding: 0.45em 1.1em;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.35);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
    animation: vs-drift 8s ease-in-out infinite alternate;
  }

  .vs-tag--near {
    font-size: clamp(0.7rem, 1.8cqw, 1rem);
  }

  .vs-tag--mid {
    font-size: clamp(0.6rem, 1.4cqw, 0.8rem);
    opacity: 0.9;
  }

  .vs-tag--far {
    font-size: clamp(0.5rem, 1.1cqw, 0.65rem);
    opacity: 0.7;
  }

  @keyframes vs-drift {
    from {
      translate: 0 0;
    }
    to {
      translate: 0 -12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vs-tag {
      animation: none;
    }
  }

  /* ── Entrada coreografiada con scroll-driven animations ──
     Timeline del wrapper doble (cover): se desarrolla durante el dwell fijo.
     Sin soporte o sin movimiento: todo visible, sin animación. */
  .vs-half:not(.vs-half-right) .vs-logo {
    animation: vs-logo-top linear both;
    animation-timeline: --vs-enter;
    animation-range: cover 28% cover 38%;
  }

  .vs-half-right .vs-logo {
    animation: vs-logo-bottom linear both;
    animation-timeline: --vs-enter;
    animation-range: cover 28% cover 38%;
  }

  @keyframes vs-logo-top {
    from {
      opacity: 0;
      translate: 0 -48px;
      scale: 0.9;
    }
  }

  @keyframes vs-logo-bottom {
    from {
      opacity: 0;
      translate: 0 48px;
      scale: 0.9;
    }
  }

  .vs-crack .crack-edge {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: crack-draw linear both;
    animation-timeline: --vs-enter;
    animation-range: cover 36% cover 48%;
  }

  @keyframes crack-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  .vs-bg-left {
    transform-origin: left center;
    animation: bg-paint linear both;
    animation-timeline: view();
    animation-range: entry 0% entry 100%;
  }

  .vs-bg-right {
    transform-origin: right center;
    animation: bg-paint linear both;
    animation-timeline: view();
    animation-range: entry 0% entry 100%;
  }

  @keyframes bg-paint {
    from {
      transform: scaleX(0);
    }
  }

  .vs-tag {
    animation:
      tag-in linear both,
      vs-drift 8s ease-in-out infinite alternate;
    animation-timeline: --vs-enter, auto;
  }

  .vs-tags .vs-tag:nth-child(1) { animation-range: cover 58% cover 68%, normal; }
  .vs-tags .vs-tag:nth-child(2) { animation-range: cover 60.5% cover 70.5%, normal; }
  .vs-tags .vs-tag:nth-child(3) { animation-range: cover 63% cover 73%, normal; }
  .vs-tags .vs-tag:nth-child(4) { animation-range: cover 65.5% cover 75.5%, normal; }
  .vs-tags .vs-tag:nth-child(5) { animation-range: cover 68% cover 78%, normal; }
  .vs-tags .vs-tag:nth-child(6) { animation-range: cover 70.5% cover 80.5%, normal; }
  .vs-tags .vs-tag:nth-child(7) { animation-range: cover 73% cover 83%, normal; }
  .vs-tags .vs-tag:nth-child(8) { animation-range: cover 75.5% cover 85.5%, normal; }

  @keyframes tag-in {
    from {
      opacity: 0;
      scale: 0.8;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vs-logo,
    .vs-tag,
    .vs-bg-left,
    .vs-bg-right {
      animation: none;
    }
    .vs-crack .crack-edge {
      animation: none;
    }
  }

  .vs-logo {
    width: clamp(96px, 20cqw, 240px);
    height: auto;
    display: block;
    filter: drop-shadow(0 6px 24px rgba(255, 255, 255, 0.45)) drop-shadow(0 2px 8px rgba(0, 0, 0, 0.18));
  }
  .vs-logo-react {
    width: clamp(96px, 19cqw, 230px);
    color: #0389d1;
  }
  /* After the inline script strips the hardcoded fill attribute, paint brand blue.
     Scoped CSS can't reach SVG internals, so use :global(). */
  :global(.vs-logo-react g),
  :global(.vs-logo-react path),
  :global(.vs-logo-react circle) {
    fill: #0389d1;
  }

  .vs-label {
    margin: 0;
    color: #fff;
    font-family: var(--font-sans, "Inter", ui-sans-serif, system-ui, sans-serif);
    font-weight: 700;
    font-size: clamp(0.85rem, 2.4cqw, 1.4rem);
    letter-spacing: 0.4em;
    text-indent: 0.4em;
    text-transform: uppercase;
    text-align: center;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.25);
  }

  @media (max-width: 640px) {
    .vs-banner {
      grid-template-columns: 1fr;
      grid-template-rows: 1fr 1fr;
      aspect-ratio: auto;
      min-height: 80svh;
    }
    .vs-half {
      min-height: 0;
    }
    /* Fondos apilados: Angular arriba, React abajo, borde compartido */
    .vs-bg-left {
      clip-path: polygon(0 0, 100% 0, 100% 44%, 0 56%);
    }
    .vs-bg-right {
      clip-path: polygon(0 56%, 100% 44%, 100% 100%, 0 100%);
    }
    /* Sin rayo en mobile: el corte limpio ya divide */
    .vs-crack {
      display: none;
    }
    /* Tags reubicados por fila (orden: 1-4 Angular arriba, 5-8 React abajo) */
    .vs-tags .vs-tag:nth-child(1) { left: 16%; top: 10%; }
    .vs-tags .vs-tag:nth-child(2) { left: 80%; top: 34%; }
    .vs-tags .vs-tag:nth-child(3) { left: 12%; top: 32%; }
    .vs-tags .vs-tag:nth-child(4) { left: 76%; top: 10%; }
    .vs-tags .vs-tag:nth-child(5) { left: 82%; top: 60%; }
    .vs-tags .vs-tag:nth-child(6) { left: 24%; top: 84%; }
    .vs-tags .vs-tag:nth-child(7) { left: 78%; top: 86%; }
    .vs-tags .vs-tag:nth-child(8) { left: 18%; top: 60%; }
  }
</style>
