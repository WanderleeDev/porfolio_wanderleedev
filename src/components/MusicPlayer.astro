---
/**
 * MusicPlayer — reproductor para el slide inferior del deck.
 *
 * Un solo panel: cabecera plegada adentro, vinilo girando con la portada del
 * tema activo y, abajo, el abanico de cards (una por tema del catálogo) con
 * números y etiquetas siempre visibles.
 *
 * El catálogo sale de `data/music.json` vía `music-player/tracks`: agregar un
 * tema es agregar un objeto ahí, sin tocar este componente. Una sola instancia
 * de Audio reproduce el mp3 del tema elegido.
 */
import Icon from "./Icon.astro";
import Title from "./typography/Title.astro";
import { getTranslations } from "../i18n/utils";
import { ACTIVE_INDEX, TRACKS } from "./music-player/tracks";
import { COVER_FRAME } from "../lib/music-catalog";

const lang = Astro.currentLocale as "es" | "en";
const t = getTranslations(lang);
const p = t("player");

const active = TRACKS[ACTIVE_INDEX];
---

<section
  data-music-player
  data-start-index={ACTIVE_INDEX}
  data-playing="false"
  class="w-full max-w-4xl rounded-[1.75rem] border border-line bg-surface p-4 text-left shadow-[0_36px_90px_-52px_rgb(0_0_0_/_0.45)] sm:p-7"
  style={`--track-accent: ${active.accent ?? "transparent"}`}
  aria-label={p.title}
>
  <!-- Fondo del slide: la portada activa, difusa. Sólo se enciende mientras suena. -->
  <div class="track-ambient" aria-hidden="true">
    {
      TRACKS.map((track, i) => (
        <img
          data-ambient-cover={i}
          src={track.cover}
          alt=""
          {...COVER_FRAME}
          loading="lazy"
          class:list={["ambient-cover", i === ACTIVE_INDEX ? "is-active" : ""]}
        />
      ))
    }
  </div>
  <header class="flex flex-wrap items-end justify-between gap-x-6 gap-y-3 border-b border-line pb-4 sm:pb-5">
    <div>
      <span class="font-sans text-[11px] font-bold uppercase tracking-[0.3em] text-muted">
        {p.eyebrow}
      </span>
      <Title level={2} family="sans" size="clamp(1.5rem,3.4vw,2.35rem)" class="mt-1.5 sm:mt-2">
        {p.title}
      </Title>
    </div>
  </header>
  <div class="mt-4 grid items-center gap-5 sm:mt-6 sm:grid-cols-[auto_minmax(0,1fr)] sm:gap-8">
    <!-- Vinilo: material de la opción «Vinilo real» (design/vinyl-disc/02-vinilo-real.html). -->
    <div class="vinyl-disc" style="--disc: clamp(7.5rem, 26vw, 13rem);" aria-hidden="true">
      <div class="vinyl-spin">
        {
          TRACKS.map((track, i) => (
            <img
              data-cover={i}
              src={track.cover}
              alt=""
              {...COVER_FRAME}
              loading={i === ACTIVE_INDEX ? "eager" : "lazy"}
              class:list={["vinyl-art", i === ACTIVE_INDEX ? "" : "hidden"]}
            />
          ))
        }
        <div class="vinyl-grooves"></div>
      </div>
      <div class="vinyl-sheen"></div>
      <div class="vinyl-bevel"></div>
      <div class="vinyl-hole"></div>
    </div>

    <!-- Tema activo y controles -->
    <div class="min-w-0">
      <div class="flex items-center gap-2">
        <span class="flex h-4 items-end gap-1" aria-hidden="true">
          {[0, 1, 2, 3].map(() => <span class="eq-bar w-[2px] rounded-full bg-ink/60"></span>)}
        </span>
        <span
          class="font-sans text-[11px] font-bold uppercase tracking-[0.25em] text-muted"
          data-state-label
          data-label-paused={p.paused}
          data-label-playing={p.playing}
        >
          {p.paused}
        </span>
      </div>

      <p
        class="mt-2 truncate font-sans text-[clamp(1.3rem,2.6vw,1.9rem)] font-bold leading-tight text-ink"
        data-now-title
      >
        {active.title}
      </p>
      <p
        class="truncate font-sans text-[11px] uppercase tracking-[0.22em] text-soft"
        data-now-artist
      >
        {active.artist}
      </p>

      <div class="mt-4 flex items-center gap-3">
        <span class="w-10 shrink-0 font-sans text-[11px] tabular-nums text-muted" data-current>0:00</span>
        <input
          type="range"
          data-seek
          min="0"
          max="100"
          step="0.1"
          value="0"
          aria-label={p.progress}
          class="h-1 min-w-0 flex-1 appearance-none"
          style="--fill: 0%"
        />
        <span class="w-10 shrink-0 text-right font-sans text-[11px] tabular-nums text-muted" data-duration>0:00</span>
      </div>

      <div class="mt-3 flex items-center justify-between gap-4 sm:mt-4">
        <div class="flex items-center gap-2.5">
          <button
            type="button"
            data-prev
            aria-label={p.prev}
            class="grid size-10 shrink-0 place-items-center rounded-full border border-line text-ink transition-colors hover:bg-badge"
          >
            <Icon name="lucide:skip-back" class="size-5" aria-hidden="true" />
          </button>
          <button
            type="button"
            data-play
            aria-label={p.play}
            data-label-play={p.play}
            data-label-pause={p.pause}
            class="grid size-12 shrink-0 place-items-center rounded-full bg-ink text-contrast shadow-card transition-transform hover:scale-105"
          >
            <span data-icon-play class="col-start-1 row-start-1 grid place-items-center">
              <Icon name="lucide:play" class="size-5" aria-hidden="true" />
            </span>
            <span data-icon-pause class="col-start-1 row-start-1 hidden">
              <Icon name="lucide:pause" class="size-5" aria-hidden="true" />
            </span>
          </button>
          <button
            type="button"
            data-next
            aria-label={p.next}
            class="grid size-10 shrink-0 place-items-center rounded-full border border-line text-ink transition-colors hover:bg-badge"
          >
            <Icon name="lucide:skip-forward" class="size-5" aria-hidden="true" />
          </button>
        </div>

        <div class="flex items-center gap-2">
          <button
            type="button"
            data-mute
            aria-label={p.mute}
            aria-pressed="false"
            data-label-mute={p.mute}
            data-label-unmute={p.unmute}
            class="grid size-9 shrink-0 place-items-center rounded-full text-soft transition-colors hover:bg-badge hover:text-ink"
          >
            <span data-icon-volume class="col-start-1 row-start-1">
              <Icon name="lucide:volume-2" class="size-5" aria-hidden="true" />
            </span>
            <span data-icon-muted class="col-start-1 row-start-1 hidden">
              <Icon name="lucide:volume-x" class="size-5" aria-hidden="true" />
            </span>
          </button>
          <input
            type="range"
            data-volume
            min="0"
            max="1"
            step="0.01"
            value="0.8"
            aria-label={p.volume}
            class="h-1 w-16 appearance-none sm:w-20"
            style="--fill: 80%"
          />
        </div>
      </div>
    </div>
  </div>

  <!-- Fila de discos: en mobile + tablet el carousel se desliza con snap; en lg se lista completa. -->
  <div class="mt-5 border-t border-line pt-4 sm:mt-7 sm:pt-5">
    <div class="flex items-center justify-between gap-2 font-sans">
      <span class="text-[11px] font-bold uppercase tracking-[0.24em] text-muted">
        {p.choose}
      </span>
      <div class="flex items-center gap-1.5 lg:hidden">
        <button
          type="button"
          data-disc-prev
          aria-label={p.prev}
          class="disc-arrow"
        >
          <Icon name="lucide:chevron-left" class="size-4" aria-hidden="true" />
        </button>
        <button
          type="button"
          data-disc-next
          aria-label={p.next}
          class="disc-arrow"
        >
          <Icon name="lucide:chevron-right" class="size-4" aria-hidden="true" />
        </button>
      </div>
    </div>

    <div
      data-disc-row
      class="disc-row flex items-center gap-3 px-1 pt-4 lg:justify-center lg:gap-5 lg:pt-6"
    >
      {
        TRACKS.map((track, i) => (
          <button
            type="button"
            data-track={i}
            data-id={track.id}
            data-title={track.title}
            data-artist={track.artist}
            data-src={track.src}
            data-accent={track.accent ?? ""}
            aria-label={`${p.select}: ${track.title}`}
            aria-pressed={i === ACTIVE_INDEX ? "true" : "false"}
            class="disc shrink-0"
          >
            <img src={track.cover} alt="" {...COVER_FRAME} loading="lazy" class="disc-art" />
          </button>
        ))
      }
    </div>
  </div>
</section>

<script>
  import {
    applyVolumeInput,
    centerScrollLeft,
    formatTime,
    isGuardedDeckKey,
    nextTrackIndex,
    seekPercent,
    seekTime,
    toggleMute,
    wrapIndex,
  } from "./music-player/player-core";
  import { requestUnlock } from "../lib/logros-store";
  import { nowPlaying, playerCommand } from "./music-player/player-store";

  const root = document.querySelector<HTMLElement>("[data-music-player]");

  if (root) {
    const cards = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-track]"));
    const covers = Array.from(root.querySelectorAll<HTMLElement>("[data-cover]"));
    const ambient = Array.from(root.querySelectorAll<HTMLElement>("[data-ambient-cover]"));
    const row = root.querySelector<HTMLElement>("[data-disc-row]")!;
        const nowTitle = root.querySelector<HTMLElement>("[data-now-title]")!;
    const nowArtist = root.querySelector<HTMLElement>("[data-now-artist]")!;
    const stateLabel = root.querySelector<HTMLElement>("[data-state-label]")!;
    const discPrev = root.querySelector<HTMLButtonElement>("[data-disc-prev]")!;
    const discNext = root.querySelector<HTMLButtonElement>("[data-disc-next]")!;
    const counter = root.querySelector<HTMLElement>("[data-track-counter]");
    const seek = root.querySelector<HTMLInputElement>("[data-seek]")!;
    const volume = root.querySelector<HTMLInputElement>("[data-volume]")!;
    const currentEl = root.querySelector<HTMLElement>("[data-current]")!;
    const durationEl = root.querySelector<HTMLElement>("[data-duration]")!;
    const playBtn = root.querySelector<HTMLButtonElement>("[data-play]")!;
    const prevBtn = root.querySelector<HTMLButtonElement>("[data-prev]")!;
    const nextBtn = root.querySelector<HTMLButtonElement>("[data-next]")!;
    const muteBtn = root.querySelector<HTMLButtonElement>("[data-mute]")!;
    const playIcon = root.querySelector<HTMLElement>("[data-icon-play]")!;
    const pauseIcon = root.querySelector<HTMLElement>("[data-icon-pause]")!;
    const volumeOnIcon = root.querySelector<HTMLElement>("[data-icon-volume]")!;
    const volumeOffIcon = root.querySelector<HTMLElement>("[data-icon-muted]")!;

    const audio = new Audio();
    audio.preload = "metadata";
    audio.volume = 0.8;

    const startIndex = Number(root.dataset.startIndex ?? 0);
    let index = Number.isInteger(startIndex) ? startIndex : 0;
    let lastVolume = audio.volume;

    // El relleno de ambos sliders sale de --fill, pintado acá.
    const paint = (input: HTMLInputElement, percent: number) => {
      input.style.setProperty("--fill", `${Math.max(0, Math.min(100, percent))}%`);
    };

    // En mobile + tablet la fila scrollea: centra el disco activo sin tocar el deck.
    const centerDisc = (behavior: ScrollBehavior) => {
      const disc = cards[index];
      const discRect = disc.getBoundingClientRect();
      const rowRect = row.getBoundingClientRect();
      row.scrollTo({
        left: centerScrollLeft({
          itemLeft: row.scrollLeft + (discRect.left - rowRect.left),
          itemWidth: discRect.width,
          rowWidth: row.clientWidth,
          rowScrollWidth: row.scrollWidth,
        }),
        behavior,
      });
    };

    const syncUi = () => {
      const card = cards[index];
      covers.forEach((cover, i) => cover.classList.toggle("hidden", i !== index));
      const accent = card.dataset.accent ?? "";
      if (accent) root.style.setProperty("--track-accent", accent);
      ambient.forEach((cover, i) => cover.classList.toggle("is-active", i === index));
      cards.forEach((item, i) => item.setAttribute("aria-pressed", i === index ? "true" : "false"));
      // La selección mueve el disco activo; las flechas del header mueven el scroll.
      nowTitle.textContent = card.dataset.title ?? "";
      nowArtist.textContent = card.dataset.artist ?? "";
      if (counter) {
        counter.textContent = `${String(index + 1).padStart(2, "0")} / ${String(cards.length).padStart(2, "0")}`;
      }
      updateDiscArrows();
      publish();
    };

    // Estado que el chat lee justo después de mandar un comando: se publica en
    // el mismo tick, sin esperar al evento `play` del navegador.
    let playing = false;

    const publish = (nextPlaying: boolean = playing) => {
      playing = nextPlaying;
      const card = cards[index];
      if (!card) return;
      nowPlaying.set({
        id: card.dataset.id ?? "",
        index,
        title: card.dataset.title ?? "",
        artist: card.dataset.artist ?? "",
        cover: covers[index]?.getAttribute("src") ?? "",
        accent: card.dataset.accent ?? "",
        playing,
      });
    };

    const syncPlaying = (isPlaying: boolean) => {
      root.dataset.playing = isPlaying ? "true" : "false";
      stateLabel.textContent = isPlaying
        ? stateLabel.dataset.labelPlaying ?? ""
        : stateLabel.dataset.labelPaused ?? "";
      playIcon.classList.toggle("hidden", isPlaying);
      pauseIcon.classList.toggle("hidden", !isPlaying);
      playBtn.setAttribute(
        "aria-label",
        isPlaying ? playBtn.dataset.labelPause ?? "" : playBtn.dataset.labelPlay ?? "",
      );
      publish(isPlaying);
    };

    const syncMute = () => {
      const muted = audio.muted || audio.volume === 0;
      volumeOnIcon.classList.toggle("hidden", muted);
      volumeOffIcon.classList.toggle("hidden", !muted);
      muteBtn.setAttribute("aria-pressed", String(muted));
      muteBtn.setAttribute(
        "aria-label",
        muted ? muteBtn.dataset.labelUnmute ?? "" : muteBtn.dataset.labelMute ?? "",
      );
    };

    const play = () => {
      // Optimista: el chat recibe `playing: true` en este mismo tick. Si el
      // navegador bloquea el autoplay, el catch lo corrige.
      publish(true);
      void audio.play().catch(() => publish(false));
    };

    const pause = () => {
      publish(false);
      audio.pause();
    };

    const select = (i: number, autoplay: boolean, behavior: ScrollBehavior = "smooth") => {
      index = wrapIndex(i, cards.length);
      const src = cards[index].dataset.src;

      if (src && audio.getAttribute("src") !== src) audio.src = src;
      audio.currentTime = 0;
      seek.value = "0";
      paint(seek, 0);
      currentEl.textContent = "0:00";
      syncUi();
      centerDisc(behavior);

      if (autoplay) play();
    };

    // Flechas del header: desplazan el scroll del carousel un disco por ves.
    const updateDiscArrows = () => {
      const atStart = row.scrollLeft <= 0;
      const atEnd = row.scrollWidth - row.clientWidth - row.scrollLeft <= 1;
      if (discPrev) discPrev.disabled = atStart;
      if (discNext) discNext.disabled = atEnd;
    };

    if (discPrev) {
      discPrev.addEventListener("click", () => {
        const disc = cards[index]?.getBoundingClientRect();
        const step = disc ? disc.width + 12 : row.clientWidth * 0.6;
        row.scrollBy({ left: -step, behavior: "smooth" });
      });
    }

    if (discNext) {
      discNext.addEventListener("click", () => {
        const disc = cards[index]?.getBoundingClientRect();
        const step = disc ? disc.width + 12 : row.clientWidth * 0.6;
        row.scrollBy({ left: step, behavior: "smooth" });
      });
    }

    row.addEventListener("scroll", updateDiscArrows, { passive: true });

    // El primer cálculo corre antes de que el layout asiente (fuentes, portadas
    // diferidas, salto de breakpoint), así que `scrollWidth` todavía mide igual
    // que `clientWidth` y la flecha "next" queda deshabilitada para siempre.
    // Se recalcula cuando el ancho real ya existe y cada vez que la fila cambia
    // de tamaño.
    requestAnimationFrame(updateDiscArrows);
    window.addEventListener("load", updateDiscArrows);
    if ("ResizeObserver" in window) {
      new ResizeObserver(updateDiscArrows).observe(row);
    }

    // Transporte
    playBtn.addEventListener("click", () => {
      if (audio.paused) play();
      else audio.pause();
    });


    prevBtn.addEventListener("click", () => select(index - 1, !audio.paused));
    nextBtn.addEventListener("click", () => select(index + 1, !audio.paused));

    // El sonido sólo arranca desde un gesto del usuario.
    cards.forEach((card, i) => {
      card.addEventListener("click", () => select(i, true));
    });

    // Estado del audio
    audio.addEventListener("play", () => {
      syncPlaying(true);
      requestUnlock("soundtrack");
    });
    audio.addEventListener("pause", () => syncPlaying(false));
    audio.addEventListener("ended", () => {
      syncPlaying(false);
      select(nextTrackIndex(index, cards.length), true);
    });

    audio.addEventListener("timeupdate", () => {
      const percent = seekPercent(audio.currentTime, audio.duration);
      seek.value = String(percent);
      paint(seek, percent);
      currentEl.textContent = formatTime(audio.currentTime);
    });

    const syncDuration = () => {
      durationEl.textContent = formatTime(audio.duration);
    };
    audio.addEventListener("loadedmetadata", syncDuration);
    audio.addEventListener("durationchange", syncDuration);

    // Progreso y volumen
    seek.addEventListener("input", () => {
      const percent = Number(seek.value);
      if (Number.isFinite(audio.duration) && audio.duration > 0) {
        audio.currentTime = seekTime(percent, audio.duration);
      }
      paint(seek, percent);
    });

    volume.addEventListener("input", () => {
      const state = applyVolumeInput(Number(volume.value), lastVolume);
      audio.volume = state.volume;
      audio.muted = state.muted;
      lastVolume = state.lastVolume;
      paint(volume, state.volume * 100);
      syncMute();
    });

    muteBtn.addEventListener("click", () => {
      const state = toggleMute(audio.muted, audio.volume, lastVolume);
      audio.muted = state.muted;
      audio.volume = state.volume;
      lastVolume = state.lastVolume;
      volume.value = String(state.volume);
      paint(volume, state.volume * 100);
      syncMute();
    });

    // El deck escucha flechas/Home/End en window: con foco dentro del player,
    // el evento no debe llegar hasta ahí. No se hace preventDefault para no
    // romper el ajuste nativo de los sliders.
    root.addEventListener("keydown", (e) => {
      if (isGuardedDeckKey(e.key)) e.stopPropagation();
    });

    // Estado inicial: tema central cargado (sin reproducir) y UI sincronizada.
    paint(volume, audio.volume * 100);
    syncMute();
    syncPlaying(false);
    select(index, false, "auto");

    // Comandos del chat: el reproductor sigue siendo el dueño del transporte.
    playerCommand.subscribe((command) => {
      if (!command) return;
      switch (command.type) {
        case "play":
          play();
          break;
        case "pause":
          pause();
          break;
        case "next":
          select(index + 1, true);
          break;
        case "prev":
          select(index - 1, true);
          break;
        case "select":
          select(command.index, true);
          break;
      }
    });
  }
</script>

<style>
  /* Sliders: el relleno lo aporta --fill desde el script. */
  [data-music-player] input[type="range"] {
    appearance: none;
    -webkit-appearance: none;
    height: 4px;
    border-radius: 9999px;
    background: linear-gradient(
      to right,
      var(--color-ink) 0,
      var(--color-ink) var(--fill, 0%),
      var(--color-line) var(--fill, 0%),
      var(--color-line) 100%
    );
  }

  [data-music-player] input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 12px;
    height: 12px;
    border: 2px solid var(--color-surface);
    border-radius: 9999px;
    background: var(--color-ink);
    box-shadow: 0 0 0 1px var(--color-line);
  }

  [data-music-player] input[type="range"]::-moz-range-thumb {
    width: 12px;
    height: 12px;
    border: 2px solid var(--color-surface);
    border-radius: 9999px;
    background: var(--color-ink);
    box-shadow: 0 0 0 1px var(--color-line);
  }

  /* Disco: material de la opción «Vinilo real» del diseño design/vinyl-disc/02-vinilo-real.html.
     Aro negro del 3,5%, bisel, surcos al 14% y eje perforado al 8% del diámetro. */
  .vinyl-disc {
    position: relative;
    width: var(--disc);
    height: var(--disc);
    flex: none;
    margin-inline: auto;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 42%, #2b2b33 0%, #131318 58%, #08080b 100%);
    box-shadow:
      0 30px 60px -30px rgb(0 0 0 / 0.8),
      0 0 0 1px rgb(0 0 0 / 0.35),
      inset 0 1px 1px rgb(255 255 255 / 0.35),
      inset 0 -3px 10px rgb(0 0 0 / 0.55);
  }

  .vinyl-grooves {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    pointer-events: none;
    background: repeating-radial-gradient(circle at 50% 50%, rgb(0 0 0 / 0.14) 0 1px, transparent 1px 7px);
  }

  /* El brillo no gira: la luz está fija aunque el disco dé vueltas. */
  .vinyl-sheen {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    pointer-events: none;
    background: conic-gradient(from 205deg, transparent 0 22%, rgb(255 255 255 / 0.14) 31%, transparent 41% 100%);
  }

  .vinyl-bevel {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    pointer-events: none;
    background:
      radial-gradient(circle at 30% 22%, rgb(255 255 255 / 0.2), transparent 44%),
      radial-gradient(circle at 78% 84%, rgb(0 0 0 / 0.42), transparent 54%);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.05);
  }

  .vinyl-hole {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 8%;
    height: 8%;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    pointer-events: none;
    background: #050506;
    box-shadow:
      inset 0 2px 3px rgb(0 0 0 / 0.95),
      0 0 0 calc(var(--disc) * 0.012) #2f2f38,
      0 0 0 calc(var(--disc) * 0.022) rgb(255 255 255 / 0.1),
      0 1px 0 0 rgb(255 255 255 / 0.14);
  }

  /* Vinilo: quieto en pausa, gira sólo mientras suena. */
  .vinyl-spin {
    position: absolute;
    inset: 3.5%;
    border-radius: 50%;
    overflow: hidden;
    animation: vinyl-spin 7s linear infinite;
    animation-play-state: paused;
  }

  .vinyl-art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
  }

  /* Fondo del slide: la portada activa difusa detrás de todo, sólo mientras suena.
     El slide es `relative isolate`, así que el z-index negativo queda contenido. */
  .track-ambient {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    opacity: 0;
    transition: opacity 700ms ease;
  }

  [data-music-player][data-playing="true"] .track-ambient {
    opacity: 1;
  }

  .ambient-cover {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.4);
