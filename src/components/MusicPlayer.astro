---
/**
 * MusicPlayer — reproductor para el slide inferior del deck.
 *
 * Un solo panel: cabecera plegada adentro, vinilo girando con el logo del
 * tema activo y, abajo, el abanico de siete cards (una por logo del stack)
 * con números y etiquetas siempre visibles.
 *
 * Una sola instancia de Audio reproduce el mp3 de demo para los siete temas.
 * Cada card ya lleva su propio data-src, así que conectar mp3 reales por tema
 * es sólo cambiar ese atributo.
 */
import Icon from "./Icon.astro";
import Title from "./typography/Title.astro";
import { getTranslations } from "../i18n/utils";
import { ACTIVE_INDEX, DEMO_SRC, TRACKS } from "./music-player/tracks";

const lang = Astro.currentLocale as "es" | "en";
const t = getTranslations(lang);
const p = t("player");

const active = TRACKS[ACTIVE_INDEX];

// Geometría del abanico: rotación, altura, escala y orden de cada card.
const rot = ["-10deg", "-6.5deg", "-3deg", "0deg", "3deg", "6.5deg", "10deg"];
const rise = ["0.95rem", "0.55rem", "0.2rem", "0rem", "0.2rem", "0.55rem", "0.95rem"];
const scale = ["0.9", "0.94", "0.97", "1.06", "0.97", "0.94", "0.9"];
const z = [1, 2, 3, 5, 3, 2, 1];
---

<section
  data-music-player
  data-playing="false"
  class="w-full max-w-4xl rounded-[1.75rem] border border-line bg-surface p-4 text-left shadow-[0_36px_90px_-52px_rgb(0_0_0_/_0.45)] sm:p-7"
  aria-label={p.title}
>
  <header class="flex flex-wrap items-end justify-between gap-x-6 gap-y-3 border-b border-line pb-4 sm:pb-5">
    <div>
      <span class="font-sans text-[11px] font-bold uppercase tracking-[0.3em] text-muted">
        {p.eyebrow}
      </span>
      <Title level={2} family="sans" size="clamp(1.5rem,3.4vw,2.35rem)" class="mt-1.5 sm:mt-2">
        {p.title}
      </Title>
    </div>
    <p class="max-w-[30ch] font-sans text-[0.85rem] leading-[1.5] text-soft sm:text-[0.9rem]">
      {p.subtitle}
    </p>
  </header>

  <div class="mt-4 grid items-center gap-5 sm:mt-6 sm:grid-cols-[auto_minmax(0,1fr)] sm:gap-8">
    <!-- Vinilo -->
    <div
      class="relative mx-auto size-[clamp(7.5rem,26vw,13rem)] shrink-0 rounded-full border border-line shadow-[0_24px_50px_-24px_rgb(0_0_0_/_0.7)]"
      style="background: radial-gradient(circle at 50% 42%, #26262c 0%, #151519 58%, #0b0b0e 100%);"
      aria-hidden="true"
    >
      <div class="vinyl-spin absolute inset-0 rounded-full">
        <div
          class="absolute inset-[7%] rounded-full"
          style="background: repeating-radial-gradient(circle at 50% 50%, rgb(255 255 255 / 0.055) 0 1px, transparent 1px 5px);"
        >
        </div>
        <div
          class="absolute inset-0 rounded-full"
          style="background: conic-gradient(from 205deg, transparent 0 22%, rgb(255 255 255 / 0.09) 31%, transparent 41% 100%);"
        >
        </div>
        <div
          class="absolute inset-[31%] grid place-items-center rounded-full bg-[#f2eee4] shadow-[0_2px_10px_rgb(0_0_0_/_0.5)]"
        >
          {
            TRACKS.map((track, i) => (
              <span
                data-cover={i}
                class:list={["col-start-1 row-start-1", i === ACTIVE_INDEX ? "" : "hidden"]}
              >
                <Icon name={track.icon} class="size-6 text-[#1b1b1f] sm:size-8" />
              </span>
            ))
          }
          <span class="absolute size-1.5 rounded-full bg-[#1b1b1f]/70" aria-hidden="true"></span>
        </div>
      </div>
    </div>

    <!-- Tema activo y controles -->
    <div class="min-w-0">
      <div class="flex items-center gap-2">
        <span class="flex h-4 items-end gap-1" aria-hidden="true">
          {[0, 1, 2, 3].map(() => <span class="eq-bar w-[2px] rounded-full bg-ink/60"></span>)}
        </span>
        <span
          class="font-sans text-[11px] font-bold uppercase tracking-[0.25em] text-muted"
          data-state-label
          data-label-paused={p.paused}
          data-label-playing={p.playing}
        >
          {p.paused}
        </span>
      </div>

      <p
        class="mt-2 truncate font-sans text-[clamp(1.3rem,2.6vw,1.9rem)] font-bold leading-tight text-ink"
        data-now-title
      >
        {active.title}
      </p>
      <p
        class="truncate font-sans text-[11px] uppercase tracking-[0.22em] text-soft"
        data-now-artist
      >
        {active.artist}
      </p>

      <div class="mt-4 flex items-center gap-3">
        <span class="w-10 shrink-0 font-sans text-[11px] tabular-nums text-muted" data-current>0:00</span>
        <input
          type="range"
          data-seek
          min="0"
          max="100"
          step="0.1"
          value="0"
          aria-label={p.progress}
          class="h-1 min-w-0 flex-1 appearance-none"
          style="--fill: 0%"
        />
        <span class="w-10 shrink-0 text-right font-sans text-[11px] tabular-nums text-muted" data-duration>0:00</span>
      </div>

      <div class="mt-3 flex items-center justify-between gap-4 sm:mt-4">
        <div class="flex items-center gap-2.5">
          <button
            type="button"
            data-prev
            aria-label={p.prev}
            class="grid size-10 shrink-0 place-items-center rounded-full border border-line text-ink transition-colors hover:bg-badge"
          >
            <Icon name="lucide:skip-back" class="size-5" aria-hidden="true" />
          </button>
          <button
            type="button"
            data-play
            aria-label={p.play}
            data-label-play={p.play}
            data-label-pause={p.pause}
            class="grid size-12 shrink-0 place-items-center rounded-full bg-ink text-contrast shadow-card transition-transform hover:scale-105"
          >
            <span data-icon-play class="col-start-1 row-start-1 grid place-items-center">
              <Icon name="lucide:play" class="size-5" aria-hidden="true" />
            </span>
            <span data-icon-pause class="col-start-1 row-start-1 hidden">
              <Icon name="lucide:pause" class="size-5" aria-hidden="true" />
            </span>
          </button>
          <button
            type="button"
            data-next
            aria-label={p.next}
            class="grid size-10 shrink-0 place-items-center rounded-full border border-line text-ink transition-colors hover:bg-badge"
          >
            <Icon name="lucide:skip-forward" class="size-5" aria-hidden="true" />
          </button>
        </div>

        <div class="flex items-center gap-2">
          <button
            type="button"
            data-mute
            aria-label={p.mute}
            aria-pressed="false"
            data-label-mute={p.mute}
            data-label-unmute={p.unmute}
            class="grid size-9 shrink-0 place-items-center rounded-full text-soft transition-colors hover:bg-badge hover:text-ink"
          >
            <span data-icon-volume class="col-start-1 row-start-1">
              <Icon name="lucide:volume-2" class="size-5" aria-hidden="true" />
            </span>
            <span data-icon-muted class="col-start-1 row-start-1 hidden">
              <Icon name="lucide:volume-x" class="size-5" aria-hidden="true" />
            </span>
          </button>
          <input
            type="range"
            data-volume
            min="0"
            max="1"
            step="0.01"
            value="0.8"
            aria-label={p.volume}
            class="h-1 w-16 appearance-none sm:w-20"
            style="--fill: 80%"
          />
        </div>
      </div>
    </div>
  </div>

  <!-- Abanico de temas -->
  <div class="mt-5 border-t border-line pt-4 sm:mt-7 sm:pt-5">
    <div class="flex items-center justify-between font-sans text-[11px] font-bold uppercase tracking-[0.24em] text-muted">
      <span>{p.choose}</span>
      <span data-track-counter class="tabular-nums">
        {String(ACTIVE_INDEX + 1).padStart(2, "0")} / {String(TRACKS.length).padStart(2, "0")}
      </span>
    </div>

    <div
      data-fan
      class="fan-scroll flex items-end justify-start gap-0 overflow-x-auto px-1 pb-2 pt-6 sm:justify-center sm:pt-8"
    >
      {
        TRACKS.map((track, i) => (
          <button
            type="button"
            data-track={i}
            data-title={track.title}
            data-artist={track.artist}
            data-src={DEMO_SRC}
            aria-label={`${p.select}: ${track.title}`}
            aria-pressed={i === ACTIVE_INDEX ? "true" : "false"}
            class="fan-card -ml-1 grid h-[4.75rem] w-[4.25rem] shrink-0 place-items-center rounded-card border border-line bg-surface shadow-card first:ml-0 sm:-ml-2 sm:h-24 sm:w-[4.75rem] lg:h-28 lg:w-24"
            style={`--rot:${rot[i]}; --rise:${rise[i]}; --scale:${scale[i]}; --z:${z[i]};`}
          >
            <span
              class="absolute left-2 top-1.5 font-sans text-[9px] font-bold tabular-nums text-muted"
              aria-hidden="true"
            >
              {String(i + 1).padStart(2, "0")}
            </span>
            <span class="flex min-w-0 flex-col items-center gap-2 px-1.5">
              <Icon name={track.icon} class="size-5 text-ink sm:size-7 lg:size-8" aria-hidden="true" />
              <span class="fan-title w-full truncate text-center font-sans text-[9px] font-bold uppercase tracking-[0.08em] text-soft">
                {track.title}
              </span>
            </span>
          </button>
        ))
      }
    </div>
  </div>
</section>

<script>
  import {
    applyVolumeInput,
    formatTime,
    isGuardedDeckKey,
    nextTrackIndex,
    seekPercent,
    seekTime,
    toggleMute,
    wrapIndex,
  } from "./music-player/player-core";
  import { requestUnlock } from "../lib/logros-store";

  const root = document.querySelector<HTMLElement>("[data-music-player]");

  if (root) {
    const cards = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-track]"));
    const covers = Array.from(root.querySelectorAll<HTMLElement>("[data-cover]"));
    const fan = root.querySelector<HTMLElement>("[data-fan]")!;
    const nowTitle = root.querySelector<HTMLElement>("[data-now-title]")!;
    const nowArtist = root.querySelector<HTMLElement>("[data-now-artist]")!;
    const stateLabel = root.querySelector<HTMLElement>("[data-state-label]")!;
    const counter = root.querySelector<HTMLElement>("[data-track-counter]")!;
    const seek = root.querySelector<HTMLInputElement>("[data-seek]")!;
    const volume = root.querySelector<HTMLInputElement>("[data-volume]")!;
    const currentEl = root.querySelector<HTMLElement>("[data-current]")!;
    const durationEl = root.querySelector<HTMLElement>("[data-duration]")!;
    const playBtn = root.querySelector<HTMLButtonElement>("[data-play]")!;
    const prevBtn = root.querySelector<HTMLButtonElement>("[data-prev]")!;
    const nextBtn = root.querySelector<HTMLButtonElement>("[data-next]")!;
    const muteBtn = root.querySelector<HTMLButtonElement>("[data-mute]")!;
    const playIcon = root.querySelector<HTMLElement>("[data-icon-play]")!;
    const pauseIcon = root.querySelector<HTMLElement>("[data-icon-pause]")!;
    const volumeOnIcon = root.querySelector<HTMLElement>("[data-icon-volume]")!;
    const volumeOffIcon = root.querySelector<HTMLElement>("[data-icon-muted]")!;

    const audio = new Audio();
    audio.preload = "metadata";
    audio.volume = 0.8;

    const DEFAULT_INDEX = 3;
    let index = DEFAULT_INDEX;
    let lastVolume = audio.volume;

    // El relleno de ambos sliders sale de --fill, pintado acá.
    const paint = (input: HTMLInputElement, percent: number) => {
      input.style.setProperty("--fill", `${Math.max(0, Math.min(100, percent))}%`);
    };

    // En mobile el abanico scrollea: centra la card activa sin tocar el deck.
    const centerCard = (behavior: ScrollBehavior) => {
      const card = cards[index];
      const cardRect = card.getBoundingClientRect();
      const fanRect = fan.getBoundingClientRect();
      const target =
        fan.scrollLeft +
        (cardRect.left - fanRect.left) -
        (fan.clientWidth - cardRect.width) / 2;
      fan.scrollTo({ left: target, behavior });
    };

    const syncUi = () => {
      const card = cards[index];
      covers.forEach((cover, i) => cover.classList.toggle("hidden", i !== index));
      cards.forEach((item, i) => item.setAttribute("aria-pressed", i === index ? "true" : "false"));
      nowTitle.textContent = card.dataset.title ?? "";
      nowArtist.textContent = card.dataset.artist ?? "";
      counter.textContent = `${String(index + 1).padStart(2, "0")} / ${String(cards.length).padStart(2, "0")}`;
    };

    const syncPlaying = (playing: boolean) => {
      root.dataset.playing = playing ? "true" : "false";
      stateLabel.textContent = playing
        ? stateLabel.dataset.labelPlaying ?? ""
        : stateLabel.dataset.labelPaused ?? "";
      playIcon.classList.toggle("hidden", playing);
      pauseIcon.classList.toggle("hidden", !playing);
      playBtn.setAttribute(
        "aria-label",
        playing ? playBtn.dataset.labelPause ?? "" : playBtn.dataset.labelPlay ?? "",
      );
    };

    const syncMute = () => {
      const muted = audio.muted || audio.volume === 0;
      volumeOnIcon.classList.toggle("hidden", muted);
      volumeOffIcon.classList.toggle("hidden", !muted);
      muteBtn.setAttribute("aria-pressed", String(muted));
      muteBtn.setAttribute(
        "aria-label",
        muted ? muteBtn.dataset.labelUnmute ?? "" : muteBtn.dataset.labelMute ?? "",
      );
    };

    const play = () => {
      void audio.play().catch(() => undefined);
    };

    const select = (i: number, autoplay: boolean, behavior: ScrollBehavior = "smooth") => {
      index = wrapIndex(i, cards.length);
      const src = cards[index].dataset.src;

      if (src && audio.getAttribute("src") !== src) audio.src = src;
      audio.currentTime = 0;
      seek.value = "0";
      paint(seek, 0);
      currentEl.textContent = "0:00";
      syncUi();
      centerCard(behavior);

      if (autoplay) play();
    };

    // Transporte
    playBtn.addEventListener("click", () => {
      if (audio.paused) play();
      else audio.pause();
    });

    prevBtn.addEventListener("click", () => select(index - 1, !audio.paused));
    nextBtn.addEventListener("click", () => select(index + 1, !audio.paused));

    // El sonido sólo arranca desde un gesto del usuario.
    cards.forEach((card, i) => {
      card.addEventListener("click", () => select(i, true));
    });

    // Estado del audio
    audio.addEventListener("play", () => {
      syncPlaying(true);
      requestUnlock("soundtrack");
    });
    audio.addEventListener("pause", () => syncPlaying(false));
    audio.addEventListener("ended", () => {
      syncPlaying(false);
      select(nextTrackIndex(index, cards.length), true);
    });

    audio.addEventListener("timeupdate", () => {
      const percent = seekPercent(audio.currentTime, audio.duration);
      seek.value = String(percent);
      paint(seek, percent);
      currentEl.textContent = formatTime(audio.currentTime);
    });

    const syncDuration = () => {
      durationEl.textContent = formatTime(audio.duration);
    };
    audio.addEventListener("loadedmetadata", syncDuration);
    audio.addEventListener("durationchange", syncDuration);

    // Progreso y volumen
    seek.addEventListener("input", () => {
      const percent = Number(seek.value);
      if (Number.isFinite(audio.duration) && audio.duration > 0) {
        audio.currentTime = seekTime(percent, audio.duration);
      }
      paint(seek, percent);
    });

    volume.addEventListener("input", () => {
      const state = applyVolumeInput(Number(volume.value), lastVolume);
      audio.volume = state.volume;
      audio.muted = state.muted;
      lastVolume = state.lastVolume;
      paint(volume, state.volume * 100);
      syncMute();
    });

    muteBtn.addEventListener("click", () => {
      const state = toggleMute(audio.muted, audio.volume, lastVolume);
      audio.muted = state.muted;
      audio.volume = state.volume;
      lastVolume = state.lastVolume;
      volume.value = String(state.volume);
      paint(volume, state.volume * 100);
      syncMute();
    });

    // El deck escucha flechas/Home/End en window: con foco dentro del player,
    // el evento no debe llegar hasta ahí. No se hace preventDefault para no
    // romper el ajuste nativo de los sliders.
    root.addEventListener("keydown", (e) => {
      if (isGuardedDeckKey(e.key)) e.stopPropagation();
    });

    // Estado inicial: tema central cargado (sin reproducir) y UI sincronizada.
    paint(volume, audio.volume * 100);
    syncMute();
    syncPlaying(false);
    select(DEFAULT_INDEX, false, "auto");
  }
</script>

<style>
  /* Sliders: el relleno lo aporta --fill desde el script. */
  [data-music-player] input[type="range"] {
    appearance: none;
    -webkit-appearance: none;
    height: 4px;
    border-radius: 9999px;
    background: linear-gradient(
      to right,
      var(--color-ink) 0,
      var(--color-ink) var(--fill, 0%),
      var(--color-line) var(--fill, 0%),
      var(--color-line) 100%
    );
  }

  [data-music-player] input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 12px;
    height: 12px;
    border: 2px solid var(--color-surface);
    border-radius: 9999px;
    background: var(--color-ink);
    box-shadow: 0 0 0 1px var(--color-line);
  }

  [data-music-player] input[type="range"]::-moz-range-thumb {
    width: 12px;
    height: 12px;
    border: 2px solid var(--color-surface);
    border-radius: 9999px;
    background: var(--color-ink);
    box-shadow: 0 0 0 1px var(--color-line);
  }

  /* Vinilo: quieto en pausa, gira sólo mientras suena. */
  .vinyl-spin {
    animation: vinyl-spin 7s linear infinite;
    animation-play-state: paused;
  }

  [data-music-player][data-playing="true"] .vinyl-spin {
    animation-play-state: running;
  }

  @keyframes vinyl-spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* Ecualizador junto al estado */
  .eq-bar {
    height: 100%;
    transform-origin: bottom;
  }

  .eq-bar:nth-child(1) {
    transform: scaleY(0.45);
  }

  .eq-bar:nth-child(2) {
    transform: scaleY(0.8);
  }

  .eq-bar:nth-child(3) {
    transform: scaleY(0.55);
  }

  .eq-bar:nth-child(4) {
    transform: scaleY(0.95);
  }

  [data-music-player][data-playing="true"] .eq-bar {
    animation: eq-pulse 0.9s ease-in-out infinite;
  }

  [data-music-player][data-playing="true"] .eq-bar:nth-child(2) {
    animation-duration: 0.65s;
    animation-delay: -0.2s;
  }

  [data-music-player][data-playing="true"] .eq-bar:nth-child(3) {
    animation-duration: 1.05s;
    animation-delay: -0.45s;
  }

  [data-music-player][data-playing="true"] .eq-bar:nth-child(4) {
    animation-duration: 0.8s;
    animation-delay: -0.12s;
  }

  @keyframes eq-pulse {
    0%,
    100% {
      transform: scaleY(0.22);
    }

    50% {
      transform: scaleY(1);
    }
  }

  /* Abanico */
  .fan-scroll {
    scrollbar-width: none;
  }

  .fan-scroll::-webkit-scrollbar {
    display: none;
  }

  .fan-card {
    position: relative;
    transform-origin: bottom center;
    transform: translateY(var(--rise)) rotate(var(--rot)) scale(var(--scale));
    z-index: var(--z);
    transition:
      transform 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.3s,
      box-shadow 0.3s;
  }

  .fan-card:hover,
  .fan-card:focus-visible,
  .fan-card[aria-pressed="true"] {
    transform: translateY(calc(var(--rise) - 0.75rem)) rotate(0deg) scale(1.06);
    z-index: 10;
    border-color: var(--color-ink);
  }

  [data-music-player][data-playing="true"] .fan-card[aria-pressed="true"] .fan-title {
    color: var(--color-ink);
  }

  @media (prefers-reduced-motion: reduce) {
    .vinyl-spin,
    [data-music-player][data-playing="true"] .eq-bar {
      animation: none;
    }

    .fan-card {
      transition: none;
    }
  }
</style>
