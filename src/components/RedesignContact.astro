---
/**
 * RedesignContact — sección de contacto con marquee + formulario conversacional.
 * Fondo oscuro propio, independiente del tema de la página.
 * Datos del i18n, GSAP para el marquee y la animación de entrada.
 */
import { getTranslations } from "../i18n/utils";

const lang  = Astro.currentLocale as "es" | "en";
const t     = getTranslations(lang);
const info  = t("contactSection");
const email = "wanderleedev@gmail.com";
const kinds = info.kinds;
const labels = info.labels;
---

<section
  id="redesign-contact"
  class="contact"
  aria-labelledby="contact-heading"
>
  <!-- Marquee -->
  <div class="marquee" aria-hidden="true">
    <div class="mtrack" id="mtrack">
      {Array.from({ length: 8 }).map(() => (
        <span>{t("contactSection").marquee}</span>
      ))}
    </div>
  </div>

  <div class="max-w-[1000px] mx-auto px-6">
    <h2 id="contact-heading" class="sr-only">{info.title}</h2>

    <form id="redesign-form" novalidate class="mb-0">
      <p class="sentence capitalize">
        <span class="ln">{info.sentence.start}
          <input
            class="f"
            name="name"
            placeholder={labels.find(l=>l.key==="name")?.label ?? "tu nombre"}
            autocomplete="name"
            aria-label={info.aria.name}
          />
          {info.sentence.andNeed}
        </span>
        <span class="ln">
          <span class="kind-wrap">
            <button type="button" class="f kind-trigger" id="kind-trigger" aria-haspopup="listbox" aria-expanded="false">
              <span id="kind-label">{kinds[0]}</span>
            </button>
            <span class="kind-panel" id="kind-panel" role="listbox" hidden>
              {kinds.map((k, i) => (
                <button
                  type="button"
                  class={`kind-option${i === 0 ? " kind-option--active" : ""}`}
                  data-kind={k}
                  role="option"
                  aria-selected={i === 0 ? true : false}
                >
                  {k}
                  <span class="kind-option__check" aria-hidden="true">✓</span>
                </button>
              ))}
            </span>
            <input type="hidden" name="kind" id="kind-input" value={kinds[0]} />
          </span>
          {info.sentence.for}
        </span>
        <span class="ln">
          <input
            class="f"
            name="what"
            placeholder={labels.find(l=>l.key==="what")?.label ?? "tu empresa o idea"}
            aria-label={info.aria.what}
          />.
        </span>
        <span class="ln">
          {info.sentence.replyTo}
          <input
            class="f"
            name="email"
            type="email"
            placeholder={labels.find(l=>l.key==="email")?.label ?? "tu@correo.com"}
            autocomplete="email"
            aria-label={info.aria.email}
          />.
        </span>
      </p>

      <p class="err" id="redesign-err" role="alert"></p>

      <button
        type="submit"
        class="font-sans font-bold text-[1.05rem] px-7 py-4 rounded-full border-0 bg-ink text-contrast cursor-pointer transition-opacity hover:opacity-80"
      >
        {info.submit}
      </button>
    </form>

    <p class="font-sans text-soft mt-10 text-sm capitalize">
      {info.preferredText}
      <a
        href={`mailto:${email}`}
        class="text-ink font-semibold hover:underline normal-case"
      >
        {email}
      </a>
    </p>
  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const TO = "wanderleedev@gmail.com";

  // ── Formulario ─────────────────────────────────────────────────────────────
  const form = document.getElementById("redesign-form") as HTMLFormElement;
  const err  = document.getElementById("redesign-err")!;

  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    const f = form.elements as any;
    const checks: [HTMLElement, unknown, string][] = [
      [f.name,  f.name.value.trim(),                              info.error],
      [f.what,  f.what.value.trim(),                              info.errorWhat],
      [f.email, f.email.value.trim() && f.email.checkValidity(), info.errorEmail],
    ];
    const bad = checks.find(([, val]) => !val);
    if (bad) { err.textContent = bad[2]; (bad[0] as HTMLElement).focus(); return; }
    err.textContent = "";
    const text = `${info.sentence.start} ${f.name.value.trim()} ${info.sentence.andNeed} ${f.kind.value} ${info.sentence.for} ${f.what.value.trim()}.\n${info.sentence.replyTo} ${f.email.value.trim()}.`;
    window.location.href = `mailto:${TO}?subject=${encodeURIComponent(`${info.submitSubject} – ` + f.name.value.trim())}&body=${encodeURIComponent(text)}`;
  });

  // ── Kind picker (estilo ThemePicker/LangPicker) ──────────────────────────
  const kindTrigger = document.getElementById("kind-trigger");
  const kindPanel   = document.getElementById("kind-panel");
  const kindInput   = document.getElementById("kind-input") as HTMLInputElement | null;
  const kindLabel   = document.getElementById("kind-label");

  kindTrigger?.addEventListener("click", (e) => {
    e.stopPropagation();
    const willOpen = kindPanel?.hidden ?? false;
    kindPanel!.hidden = !willOpen;
    kindTrigger.setAttribute("aria-expanded", String(willOpen));
  });

  kindPanel?.querySelectorAll<HTMLElement>("[data-kind]").forEach((opt) => {
    opt.addEventListener("click", () => {
      const value = opt.dataset.kind ?? "";
      if (kindInput) kindInput.value = value;
      if (kindLabel) kindLabel.textContent = value;
      kindPanel.querySelectorAll<HTMLElement>("[data-kind]").forEach((o) => {
        const active = o === opt;
        o.classList.toggle("kind-option--active", active);
        o.setAttribute("aria-selected", String(active));
      });
      kindPanel.hidden = true;
      kindTrigger?.setAttribute("aria-expanded", "false");
    });
  });

  document.addEventListener("click", () => {
    if (kindPanel && !kindPanel.hidden) {
      kindPanel.hidden = true;
      kindTrigger?.setAttribute("aria-expanded", "false");
    }
  });
  // ── Animaciones ────────────────────────────────────────────────────────────
  const mm = gsap.matchMedia();

  mm.add("(prefers-reduced-motion: no-preference)", () => {
    const section = document.getElementById("redesign-contact")!;
    const mtrack  = document.getElementById("mtrack")!;

    // Marquee continuo
    const loop = gsap.to(mtrack, {
      xPercent: -50,
      duration: 28,
      ease    : "none",
      repeat  : -1,
    });

    // Velocidad reactiva al scroll
    ScrollTrigger.create({
      trigger: section,
      start  : "top bottom",
      end    : "bottom top",
      onUpdate(self) {
        const v = gsap.utils.clamp(-3000, 3000, self.getVelocity());
        gsap.timeline({ overwrite: true })
          .to(loop, { timeScale: self.direction * (1 + Math.abs(v) / 400), duration: 0.3 })
          .to(loop, { timeScale: 1, duration: 1.2 });
      },
    });

    // Frase aparece línea a línea
    gsap.from(".sentence .ln", {
      opacity : 0,
      y       : 30,
      duration: 0.8,
      ease    : "power3.out",
      stagger : 0.15,
      scrollTrigger: { trigger: ".sentence", start: "top 80%" },
    });

    return () => loop.kill();
  });

  mm.add("(prefers-reduced-motion: reduce)", () => {
    const mtrack = document.getElementById("mtrack")!;
    if (mtrack) mtrack.style.transform = "none";
  });
</script>

<style>
  @layer components {
    /* Bloque temático: sigue el fondo de página */
    .contact {
      color: var(--ct-ink, #111111);
      overflow: hidden;
      padding: clamp(40px, 7vw, 80px) 0 clamp(56px, 9vw, 110px);
    }

    /* Marquee */
    .marquee {
      white-space: nowrap;
      overflow: hidden;
      margin-bottom: clamp(40px, 7vw, 90px);
      user-select: none;
    }

    .mtrack {
      display: inline-flex;
      will-change: transform;
    }

    .mtrack span {
      font-family: "Fira Sans Extra Condensed", sans-serif;
      font-size: clamp(3.5rem, 14vw, 11rem);
      font-weight: 900;
      letter-spacing: -0.04em;
      line-height: 1;
      padding-right: 0.5em;
      color: transparent;
      -webkit-text-stroke: 1.5px var(--ct-ink, #111111);
    }

    .mtrack span:nth-child(even) {
      color: var(--ct-ink, #111111);
      -webkit-text-stroke: 0;
    }

    /* Frase conversacional */
    .sentence {
      font-family: "Fira Sans Extra Condensed", sans-serif;
      font-size: clamp(1.6rem, 4.6vw, 3.2rem);
      font-weight: 600;
      letter-spacing: -0.02em;
      line-height: 1.55;
      margin: 0 0 36px;
    }

    .ln { display: inline; }

    /* Inputs inline (texto de usuario sin transformar) */
    .f {
      display: inline-block;
      vertical-align: baseline;
      font: inherit;
      text-transform: none;
      color: var(--ct-acc, #4f46e5);
      background: transparent;
      border: 0;
      border-bottom: 2px solid var(--ct-acc, #4f46e5);
      border-radius: 0;
      padding: 0 0.25em;
      margin: 0 0.2em;
      min-width: 5ch;
      field-sizing: content;
      max-width: 100%;
    }

    .f::placeholder { color: var(--ct-acc, #4f46e5); opacity: 0.55; }

    /* Kind picker: mismo lenguaje que ThemePicker/LangPicker */
    .kind-wrap {
      position: relative;
      display: inline-block;
    }

    .kind-trigger {
      cursor: pointer;
    }

    .kind-panel {
      position: absolute;
      top: calc(100% + 8px);
      left: 0;
      min-width: 220px;
      z-index: 50;
      background: color-mix(in srgb, var(--surface) 92%, transparent);
      backdrop-filter: blur(20px) saturate(1.6);
      -webkit-backdrop-filter: blur(20px) saturate(1.6);
      border: 1.5px solid color-mix(in srgb, var(--ink) 12%, transparent);
      border-radius: 14px;
      padding: 6px;
      display: flex;
      flex-direction: column;
      gap: 2px;
      box-shadow: 0 8px 32px color-mix(in srgb, black 18%, transparent);
      text-transform: none;
    }

    .kind-panel[hidden] {
      display: none;
    }

    .kind-option {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 9px 12px;
      border-radius: 9px;
      border: none;
      background: transparent;
      color: var(--ink);
      font-family: "Inter", ui-sans-serif, system-ui, sans-serif;
      font-size: 1rem;
      cursor: pointer;
      text-align: left;
      width: 100%;
      transition: background 0.15s;
    }

    .kind-option:hover {
      background: color-mix(in srgb, var(--ink) 8%, transparent);
    }

    .kind-option__check {
      margin-left: auto;
      font-size: 0.75rem;
      opacity: 0;
      transition: opacity 0.15s;
    }

    .kind-option--active .kind-option__check {
      opacity: 1;
    }

    .kind-option--active {
      background: color-mix(in srgb, var(--ink) 10%, transparent);
      font-weight: 700;
    }

    .f:focus-visible {
      outline: 3px solid var(--ct-ink, #111111);
      outline-offset: 4px;
    }

    /* Error */
    .err {
      min-height: 1.5em;
      color: var(--ct-err, #dc2626);
      font-family: "Inter", ui-sans-serif, system-ui, sans-serif;
      font-size: 1rem;
      margin: 0 0 20px;
    }
  }
</style>
