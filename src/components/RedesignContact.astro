---
/**
 * RedesignContact — 2 columnas: intro + contacto directo a la izquierda,
 * formulario de un campo por fila a la derecha.
 * Textos del i18n (contactSection). Envío vía mailto, sin backend.
 */
import Icon from "astro-iconify";
import { getTranslations } from "../i18n/utils";

const lang = Astro.currentLocale === "en" ? "en" : "es";
const info = getTranslations(lang)("contactSection");
const kinds: string[] = info.kinds;

const UI = {
  es: { kind: "Tipo de proyecto", name: "Nombre", what: "Empresa o idea", email: "Correo" },
  en: { kind: "Project type", name: "Name", what: "Company or idea", email: "Email" },
}[lang];

const placeholder = (key: string, fallback: string) =>
  info.labels.find((l: { key: string }) => l.key === key)?.label ?? fallback;

const config = {
  email: "wanderleedev@gmail.com",
  error: info.error,
  errorWhat: info.errorWhat,
  errorEmail: info.errorEmail,
  start: info.sentence.start,
  andNeed: info.sentence.andNeed,
  for: info.sentence.for,
  replyTo: info.sentence.replyTo,
  submitSubject: info.submitSubject,
};

// Escapa "<" para que ningún texto pueda cerrar el <script> antes de tiempo
const configJson = JSON.stringify(config).replace(/</g, "\\u003c");

const inputCls =
  "w-full rounded-2xl border border-line bg-surface px-4 py-3 font-sans text-[1.02rem] text-ink placeholder:text-muted/70 transition-colors focus:outline-none focus:border-ink aria-[invalid=true]:border-red-500";
---

<section id="contact" class="bg-surface text-ink" aria-labelledby="contact-heading">
  <div class="mx-auto grid max-w-6xl grid-cols-1 items-start gap-10 px-6 py-20 md:grid-cols-[1fr_1.1fr] md:gap-14 md:py-28 lg:px-10">
    <!-- Left: intro + direct contact -->
    <div data-reveal>
      <p class="font-sans text-[0.7rem] font-bold uppercase tracking-[0.25em] text-muted">{info.marquee}</p>
      <h2
        id="contact-heading"
        class="mt-3 font-fira-sans-extra-condensed font-black uppercase leading-[0.9] tracking-tight text-[clamp(3rem,9vw,7rem)]"
      >
        {info.title}
      </h2>
      <p class="mt-4 max-w-md font-sans text-[clamp(0.95rem,1.8vw,1.05rem)] leading-relaxed text-soft">
        {info.subtitle}
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a
          href={`mailto:${config.email}`}
          class="inline-flex items-center gap-2 rounded-full bg-ink px-6 py-3 font-sans text-sm font-bold text-surface transition-transform hover:scale-105 active:scale-95"
        >
          <Icon name="lucide:mail" class="h-4 w-4" aria-hidden="true" />
          {config.email}
        </a>
        <a
          href="https://www.linkedin.com/in/wanderlee-max/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
          class="flex h-11 w-11 items-center justify-center rounded-full border border-line text-ink transition-transform hover:scale-105 active:scale-95"
        >
          <Icon name="lucide:linkedin" class="h-5 w-5" aria-hidden="true" />
        </a>
        <a
          href="https://github.com/WanderleeDev"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
          class="flex h-11 w-11 items-center justify-center rounded-full border border-line text-ink transition-transform hover:scale-105 active:scale-95"
        >
          <Icon name="lucide:github" class="h-5 w-5" aria-hidden="true" />
        </a>
      </div>

      <p class="mt-4 font-sans text-sm text-muted">{info.preferredText}</p>
    </div>

    <!-- Right: the form, one field per row -->
    <form
      id="contact-form"
      data-reveal
      novalidate
      class="grid gap-5 rounded-3xl border border-line bg-surface p-6 shadow-[0_20px_50px_-30px_rgba(0,0,0,0.25)] md:p-8"
    >
      <div class="grid gap-2">
        <label for="f-name" class="font-sans text-[0.72rem] font-bold uppercase tracking-[0.16em] text-muted">{UI.name}</label>
        <input
          id="f-name"
          name="name"
          autocomplete="name"
          placeholder={placeholder("name", "Ana Pérez")}
          class={inputCls}
        />
      </div>

      <fieldset class="grid min-w-0 gap-2 border-0 p-0">
        <legend class="p-0 font-sans text-[0.72rem] font-bold uppercase tracking-[0.16em] text-muted">{UI.kind}</legend>
        <div class="flex flex-wrap gap-2">
          {kinds.map((k, i) => (
            <label class="cursor-pointer">
              <input type="radio" name="kind" value={k} checked={i === 0} class="peer sr-only" />
              <span class="inline-block rounded-full border border-line px-4 py-2 font-sans text-sm font-semibold text-soft transition-colors peer-checked:border-ink peer-checked:bg-ink peer-checked:text-surface peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-ink">
                {k}
              </span>
            </label>
          ))}
        </div>
      </fieldset>

      <div class="grid gap-2">
        <label for="f-what" class="font-sans text-[0.72rem] font-bold uppercase tracking-[0.16em] text-muted">{UI.what}</label>
        <input
          id="f-what"
          name="what"
          placeholder={placeholder("what", "Acme, mi startup…")}
          class={inputCls}
        />
      </div>

      <div class="grid gap-2">
        <label for="f-email" class="font-sans text-[0.72rem] font-bold uppercase tracking-[0.16em] text-muted">{UI.email}</label>
        <input
          id="f-email"
          name="email"
          type="email"
          autocomplete="email"
          placeholder={placeholder("email", "tu@correo.com")}
          class={inputCls}
        />
      </div>

      <p id="contact-err" class="m-0 min-h-[1.4em] font-sans text-[0.95rem] text-red-500" role="alert"></p>

      <button
        type="submit"
        class="flex w-full items-center justify-between gap-4 rounded-2xl bg-ink px-6 py-4 font-sans text-[1.02rem] font-extrabold text-surface transition-transform hover:-translate-y-0.5 active:translate-y-0"
      >
        <span>{info.submit}</span>
        <Icon name="lucide:arrow-right" class="h-5 w-5" aria-hidden="true" />
      </button>
    </form>
  </div>
</section>

<script type="application/json" id="contact-config" set:html={configJson} />

<script>
  import { gsap } from "../lib/gsap";
  

  

  interface ContactConfig {
    email: string;
    error: string;
    errorWhat: string;
    errorEmail: string;
    start: string;
    andNeed: string;
    for: string;
    replyTo: string;
    submitSubject: string;
  }

  let ctx: gsap.Context | null = null;
  let ac: AbortController | null = null;

  function readConfig(): ContactConfig {
    const raw = document.getElementById("contact-config")?.textContent ?? "{}";
    return JSON.parse(raw) as ContactConfig;
  }

  /* ── Validación y envío ── */
  function wireForm(section: HTMLElement, config: ContactConfig, signal: AbortSignal) {
    const form = section.querySelector<HTMLFormElement>("#contact-form");
    const err = section.querySelector<HTMLElement>("#contact-err");
    const name = section.querySelector<HTMLInputElement>("#f-name");
    const what = section.querySelector<HTMLInputElement>("#f-what");
    const email = section.querySelector<HTMLInputElement>("#f-email");
    if (!form || !err || !name || !what || !email) return;

    form.addEventListener(
      "submit",
      (e) => {
        e.preventDefault();
        const data = new FormData(form);
        const values = {
          name: String(data.get("name") ?? "").trim(),
          what: String(data.get("what") ?? "").trim(),
          email: String(data.get("email") ?? "").trim(),
          kind: String(data.get("kind") ?? ""),
        };

        let problem: { el: HTMLInputElement; msg: string } | null = null;
        if (!values.name) problem = { el: name, msg: config.error };
        else if (!values.what) problem = { el: what, msg: config.errorWhat };
        else if (!values.email || !email.checkValidity())
          problem = { el: email, msg: config.errorEmail };

        // Marca el campo con error para los estilos (aria-invalid)
        [name, what, email].forEach((el) =>
          el.setAttribute("aria-invalid", String(problem?.el === el)),
        );

        if (problem) {
          err.textContent = problem.msg;
          problem.el.focus();
          return;
        }
        err.textContent = "";

        const body =
          `${config.start} ${values.name} ${config.andNeed} ${values.kind} ${config.for} ${values.what}.\n` +
          `${config.replyTo} ${values.email}.`;
        const subject = `${config.submitSubject} – ${values.name}`;

        window.location.href =
          `mailto:${config.email}` +
          `?subject=${encodeURIComponent(subject)}` +
          `&body=${encodeURIComponent(body)}`;
      },
      { signal },
    );
  }

  /* ── Animaciones (dentro de gsap.context) ── */
  function animate(section: HTMLElement) {
    const mm = gsap.matchMedia();
    mm.add("(prefers-reduced-motion: no-preference)", () => {
      gsap.from(section.querySelectorAll("[data-reveal]"), {
        opacity: 0,
        y: 40,
        duration: 0.9,
        ease: "power3.out",
        stagger: 0.15,
        scrollTrigger: { trigger: section, start: "top 75%" },
      });
    });
  }

  function boot() {
    const section = document.querySelector<HTMLElement>("#contact");
    if (!section) return;

    ctx?.revert();
    ac?.abort();
    ac = new AbortController();

    ctx = gsap.context(() => animate(section));
    wireForm(section, readConfig(), ac.signal);
  }

  document.addEventListener("astro:before-swap", () => {
    ctx?.revert();
    ctx = null;
    ac?.abort();
    ac = null;
  });
  document.addEventListener("astro:page-load", boot);
  boot();
</script>
