---
/**
 * RedesignContact — sección de contacto con marquee + formulario conversacional.
 * Fondo oscuro propio, independiente del tema de la página.
 * Datos del i18n, GSAP para el marquee y la animación de entrada.
 */
import { getTranslations } from "../i18n/utils";

const lang  = Astro.currentLocale as "es" | "en";
const t     = getTranslations(lang);
const info  = t("contactSection");
const email = "wanderleedev@gmail.com";
---

<section
  id="redesign-contact"
  class="contact"
  aria-labelledby="contact-heading"
>
  <!-- Marquee -->
  <div class="marquee" aria-hidden="true">
    <div class="mtrack" id="mtrack">
      {Array.from({ length: 8 }).map(() => (
        <span>Escríbeme</span>
      ))}
    </div>
  </div>

  <div class="max-w-[1000px] mx-auto px-6">
    <h2 id="contact-heading" class="sr-only">Contacto</h2>

    <form id="redesign-form" novalidate class="mb-0">
      <p class="sentence">
        <span class="ln">Hola, soy
          <input
            class="f"
            name="name"
            placeholder="tu nombre"
            autocomplete="name"
            aria-label="Tu nombre"
          />
          y necesito
        </span>
        <span class="ln">
          <select class="f" name="kind" aria-label="Qué necesitas">
            <option>una web nueva</option>
            <option>rediseñar mi sitio</option>
            <option>una app a medida</option>
            <option>animaciones para mi producto</option>
            <option>otra cosa</option>
          </select>
          para
        </span>
        <span class="ln">
          <input
            class="f"
            name="what"
            placeholder="tu empresa o idea"
            aria-label="Tu empresa o idea"
          />.
        </span>
        <span class="ln">
          Respóndeme en
          <input
            class="f"
            name="email"
            type="email"
            placeholder="tu@correo.com"
            autocomplete="email"
            aria-label="Tu correo"
          />.
        </span>
      </p>

      <p class="err" id="redesign-err" role="alert"></p>

      <button
        type="submit"
        class="font-dm-mono font-bold text-[1.05rem] px-7 py-4 rounded-full border-0 bg-[var(--dark-ink)] text-[var(--dark-bg)] cursor-pointer transition-opacity hover:opacity-80"
      >
        Abrir en mi correo
      </button>
    </form>

    <p class="font-dm-mono text-[var(--dark-muted)] mt-10 text-sm">
      ¿Prefieres escribir tú?
      <a
        href={`mailto:${email}`}
        class="text-[var(--dark-ink)] font-semibold hover:underline"
      >
        {email}
      </a>
    </p>
  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const TO = "wanderleedev@gmail.com";

  // ── Formulario ─────────────────────────────────────────────────────────────
  const form = document.getElementById("redesign-form") as HTMLFormElement;
  const err  = document.getElementById("redesign-err")!;

  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    const f = form.elements as any;
    const checks: [HTMLElement, unknown, string][] = [
      [f.name,  f.name.value.trim(),                              "Falta tu nombre en la frase."],
      [f.what,  f.what.value.trim(),                              "Cuéntame para qué empresa o idea es."],
      [f.email, f.email.value.trim() && f.email.checkValidity(), "Escribe un correo válido, por ejemplo nombre@dominio.com."],
    ];
    const bad = checks.find(([, val]) => !val);
    if (bad) { err.textContent = bad[2]; (bad[0] as HTMLElement).focus(); return; }
    err.textContent = "";
    const text = `Hola, soy ${f.name.value.trim()} y necesito ${f.kind.value} para ${f.what.value.trim()}.\nRespóndeme en ${f.email.value.trim()}.`;
    window.location.href = `mailto:${TO}?subject=${encodeURIComponent("Proyecto – " + f.name.value.trim())}&body=${encodeURIComponent(text)}`;
  });

  // ── Animaciones ────────────────────────────────────────────────────────────
  const mm = gsap.matchMedia();

  mm.add("(prefers-reduced-motion: no-preference)", () => {
    const section = document.getElementById("redesign-contact")!;
    const mtrack  = document.getElementById("mtrack")!;

    // Marquee continuo
    const loop = gsap.to(mtrack, {
      xPercent: -50,
      duration: 28,
      ease    : "none",
      repeat  : -1,
    });

    // Velocidad reactiva al scroll
    ScrollTrigger.create({
      trigger: section,
      start  : "top bottom",
      end    : "bottom top",
      onUpdate(self) {
        const v = gsap.utils.clamp(-3000, 3000, self.getVelocity());
        gsap.timeline({ overwrite: true })
          .to(loop, { timeScale: self.direction * (1 + Math.abs(v) / 400), duration: 0.3 })
          .to(loop, { timeScale: 1, duration: 1.2 });
      },
    });

    // Frase aparece línea a línea
    gsap.from(".sentence .ln", {
      opacity : 0,
      y       : 30,
      duration: 0.8,
      ease    : "power3.out",
      stagger : 0.15,
      scrollTrigger: { trigger: ".sentence", start: "top 80%" },
    });

    return () => loop.kill();
  });

  mm.add("(prefers-reduced-motion: reduce)", () => {
    const mtrack = document.getElementById("mtrack")!;
    if (mtrack) mtrack.style.transform = "none";
  });
</script>

<style>
  /* Bloque oscuro independiente del tema */
  .contact {
    --c-bg  : var(--dark-bg);
    --c-ink : var(--dark-ink);
    --c-mute: var(--dark-muted);
    --c-acc : var(--dark-acc);
    --c-err : var(--dark-err);

    color      : var(--c-ink);
    overflow   : hidden;
    padding    : clamp(40px, 7vw, 80px) 0 clamp(56px, 9vw, 110px);
  }

  /* Marquee */
  .marquee {
    white-space  : nowrap;
    overflow     : hidden;
    margin-bottom: clamp(40px, 7vw, 90px);
    user-select  : none;
  }

  .mtrack {
    display     : inline-flex;
    will-change : transform;
  }

  .mtrack span {
    font-family   : "Fira Sans Extra Condensed", sans-serif;
    font-size     : clamp(3.5rem, 14vw, 11rem);
    font-weight   : 900;
    letter-spacing: -0.04em;
    line-height   : 1;
    padding-right : 0.5em;
    color         : transparent;
    -webkit-text-stroke: 1.5px var(--c-ink);
  }

  .mtrack span:nth-child(even) {
    color: var(--c-ink);
    -webkit-text-stroke: 0;
  }

  /* Frase conversacional */
  .sentence {
    font-family   : "Fira Sans Extra Condensed", sans-serif;
    font-size     : clamp(1.6rem, 4.6vw, 3.2rem);
    font-weight   : 600;
    letter-spacing: -0.02em;
    line-height   : 1.55;
    margin        : 0 0 36px;
  }

  .ln { display: inline; }

  /* Inputs inline */
  .f {
    display       : inline-block;
    vertical-align: baseline;
    font          : inherit;
    color         : var(--c-acc);
    background    : transparent;
    border        : 0;
    border-bottom : 2px solid var(--c-acc);
    border-radius : 0;
    padding       : 0 0.1em;
    min-width     : 5ch;
    field-sizing  : content;
    max-width     : 100%;
  }

  .f::placeholder { color: var(--c-acc); opacity: 0.55; }

  select.f {
    appearance   : none;
    cursor       : pointer;
    padding-right: 0.1em;
  }

  select.f option {
    color     : var(--dark-bg);
    background: #fff;
    font-size : 1rem;
  }

  .f:focus-visible {
    outline       : 3px solid var(--c-ink);
    outline-offset: 4px;
  }

  /* Error */
  .err {
    min-height: 1.5em;
    color     : var(--c-err);
    font-family: "DM Mono", monospace;
    font-size : 1rem;
    margin    : 0 0 20px;
  }
</style>
