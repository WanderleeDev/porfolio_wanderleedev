---
/**
 * Redesign footer — Spencer Gabor language:
 * black block, giant cropped banner, clients list on the right.
 */
import { cloudinary } from "../utils/cloudinary";

interface Props {
  clientNames?: string[];
  heroImage?: string;
}

const {
  clientNames = ["Apple", "Amazon", "Adobe", "Google", "Nike", "The New York Times", "Lululemon", "NPR"],
  heroImage = "https://res.cloudinary.com/dy8gpozi6/image/upload/v1765154077/tom_f0v8qy.webp",
} = Astro.props;
---

<footer class="bg-dark-bg text-dark-ink overflow-hidden relative">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 px-6 lg:px-12 py-12 md:py-16 items-start">
    <!-- Clients list -->
    <div class="order-2 md:order-1 max-w-md">
      <p class="font-dm-mono text-xs font-bold tracking-[0.2em] text-dark-muted uppercase mb-4">
        Clients Include
      </p>
      <p class="font-dm-mono text-sm text-dark-ink/80 leading-relaxed">
        {
          clientNames.map((name) => (
            <span class="inline-block">{name}, </span>
          ))
        }
      </p>

      <div class="mt-8 font-dm-mono text-xs text-dark-muted space-y-1">
        <p>wanderleedev@gmail.com</p>
        <p>Argentina — Remoto</p>
      </div>

      <div class="flex gap-4 mt-6 font-dm-mono text-xs uppercase tracking-[0.15em]">
        <a
          href="https://www.linkedin.com/in/wanderlee-max/"
          target="_blank"
          rel="noopener noreferrer"
          class="text-dark-muted hover:text-dark-ink transition-colors"
        >
          LinkedIn
        </a>
        <a
          href="https://github.com/WanderleeDev"
          target="_blank"
          rel="noopener noreferrer"
          class="text-dark-muted hover:text-dark-ink transition-colors"
        >
          GitHub
        </a>
      </div>
    </div>

    <!-- Hero image column -->
    <div class="order-1 md:order-2 h-64 md:h-96 overflow-hidden rounded-2xl">
      <img
        src={cloudinary(heroImage, { w: 800, q: 55, f: "webp" })}
        alt="WanderleeDev"
        width={800}
        height={1000}
        class="w-full h-full object-cover object-top scale-125 -translate-y-8"
        loading="lazy"
        decoding="async"
      />
    </div>
  </div>

  <!-- Giant banner across the bottom, cropped like Spencer's -->
  <p
    class="font-fira-sans-extra-condensed font-black uppercase text-dark-ink/20 select-none text-center leading-none overflow-hidden whitespace-nowrap text-[22vw] translate-y-[18%] tracking-tight"
    aria-hidden="true"
  >
    WanderleeDev
  </p>
</footer>
