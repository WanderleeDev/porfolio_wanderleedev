---
import Icon from "astro-iconify";

interface Props {
  title: string;
  techs: { icon: string; color: string }[];
  index: number;
  themeColor: string;
  isFirst?: boolean;
}

const { title, techs, index, themeColor, isFirst = false } = Astro.props;
let innerGridClass = "grid grid-cols-2 sm:grid-cols-3 gap-2.5 sm:gap-3.5";
if (title.toLowerCase().includes("front")) {
  innerGridClass = "grid grid-cols-2 sm:grid-cols-4 gap-2.5 sm:gap-3.5";
}

const bevelClip =
  "polygon(0 12px, 12px 0, calc(100% - 12px) 0, 100% 12px, 100% calc(100% - 12px), calc(100% - 12px) 100%, 12px 100%, 0 calc(100% - 12px))";
---

<details
  class="group w-full overflow-clip [interpolate-size:allow-keywords] details-content:h-0 details-content:opacity-0 details-content:overflow-clip details-content:[transition:height_0.35s_ease,opacity_0.35s_ease,content-visibility_0.35s_ease_allow-discrete] open:details-content:h-auto open:details-content:opacity-100"
  name="skills-accordion"
  data-index={index}
  open={isFirst}
  style={{ "--accordion-theme-color": themeColor }}
>
  <summary
    class="relative w-full p-px cursor-pointer text-left block focus:outline-none transition-all duration-300 list-none [&::-webkit-details-marker]:hidden bg-white/5 group-open:bg-(--accordion-theme-color)"
    style={{ clipPath: bevelClip }}
  >
    <div
      class="bg-slate-950/70 backdrop-blur-md px-4 py-4 flex items-center justify-between"
      style={{ clipPath: bevelClip }}
    >
      <div class="flex items-center gap-3">
        <span
          class="text-xs font-mono text-white/30 transition-colors duration-300 group-open:text-white"
        >
          {(index + 1).toString().padStart(2, "0")}
        </span>
        <span
          class="text-sm font-semibold text-white/60 transition-colors duration-300 group-open:text-white"
        >
          {title}
        </span>
        <div
          class="w-1.5 h-1.5 rounded-full opacity-0 scale-50 transition-all duration-300 group-open:opacity-100 group-open:scale-100"
          style={{
            backgroundColor: themeColor,
            boxShadow: `0 0 8px ${themeColor}`,
          }}
        >
        </div>
      </div>
      <Icon
        name="mdi:chevron-down"
        class="w-5 h-5 text-white/40 transition-transform duration-300 group-open:rotate-180"
      />
    </div>
  </summary>

  <div class="py-4 px-2 sm:px-4">
    <div class={innerGridClass}>
      {
        techs.map((tech) => (
          <div class="tech-tile flex flex-col items-center justify-center p-2.5 rounded-xl border border-white/5 bg-white/2 transition-all duration-300 hover:border-white/15 hover:bg-white/6 hover:-translate-y-0.5 group/tile">
            <div class="relative flex items-center justify-center p-0.5">
              <div
                class="absolute inset-0 rounded-full blur-md opacity-0 group-hover/tile:opacity-40 transition-opacity duration-300 pointer-events-none"
                style={{ backgroundColor: tech.color }}
              />
              <Icon
                name={tech.icon}
                class="w-8 h-8 relative z-10 transition-transform duration-300 group-hover/tile:scale-110"
                style={{ color: tech.color }}
              />
            </div>
            <span class="text-[10px] mt-1.5 font-medium text-white/50 group-hover/tile:text-white transition-colors duration-300 text-center truncate w-full px-0.5">
              {tech.icon.includes("greensock")
                ? "gsap"
                : tech.icon.split(":")[1]}
            </span>
          </div>
        ))
      }
    </div>
  </div>
</details>
