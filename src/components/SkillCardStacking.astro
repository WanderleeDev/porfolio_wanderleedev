---
import Icon from "astro-iconify";

interface Props {
  skills: {
    title: string;
    techs: {
      color: string;
      icon: string;
    }[];
  }[];
}

const { skills } = Astro.props;

const formatTechName = (icon: string) => {
  const name = icon.split(":")[1];
  const mapping: Record<string, string> = {
    postgresql: "PostgreSQL",
    nestjs: "NestJS",
    angular: "Angular",
    nodejs: "Node.js",
    html5: "HTML5",
    css3: "CSS3",
    javascript: "JavaScript",
    typescript: "TypeScript",
    react: "React",
    nextjs: "Next.js",
    astro: "Astro",
    sass: "Sass",
    tailwindcss: "Tailwind CSS",
    ngrx: "NgRx",
    python: "Python",
    fastapi: "FastAPI",
    java: "Java",
    spring: "Spring Boot",
    vuejs: "Vue.js",
    nuxtjs: "Nuxt.js",
    bootstrap: "Bootstrap",
    git: "Git",
    github: "GitHub",
    docker: "Docker",
    trello: "Trello",
  };
  return mapping[name] || (name.charAt(0).toUpperCase() + name.slice(1));
};

const getCardThemeColor = (title: string) => {
  const lower = title.toLowerCase();
  if (lower.includes("stack")) return "#f59e0b"; // Amber
  if (lower.includes("front")) return "#06b6d4"; // Cyan
  if (lower.includes("back")) return "#e0234e"; // NestJS Red/Crimson
  if (lower.includes("herr") || lower.includes("tool")) return "#10b981"; // Emerald/Green for Tools
  return "#8b5cf6"; // Purple default
};
---

<div
  id="container-cards"
  class="relative w-full max-w-2xl h-[420px] sm:h-[460px] md:h-[480px] lg:h-[450px] mx-auto flex items-center justify-center"
>
  {
    skills.map(({ title, techs }, index) => {
      const themeColor = getCardThemeColor(title);
      
      // Determine internal columns layout responsively
      let innerGridClass = "grid grid-cols-2 sm:grid-cols-3 gap-2 sm:gap-3";
      if (title.toLowerCase().includes("front")) {
        innerGridClass = "grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-5 gap-2 sm:gap-3";
      }

      return (
        <article
          class="skill-card absolute top-0 left-0 w-full h-[400px] sm:h-[440px] md:h-[460px] lg:h-[430px] outer-bevel-skill p-[1px] shadow-2xl transition-all duration-300 cursor-pointer select-none origin-center"
          style={{
            background: themeColor,
          }}
          data-card-index={index}
        >
          <div 
            class="inner-bevel-skill w-full h-full flex flex-col p-4 sm:p-6 relative z-10"
            style={{
              background: "linear-gradient(135deg, rgba(15, 23, 42, 0.96) 0%, rgba(9, 15, 30, 0.99) 100%)",
            }}
          >
            <div 
              class="absolute -top-20 -right-20 w-44 h-44 rounded-full blur-3xl opacity-10 pointer-events-none -z-10"
              style={{ backgroundColor: themeColor }}
            />
            <div 
              class="absolute -bottom-20 -left-20 w-44 h-44 rounded-full blur-3xl opacity-5 pointer-events-none -z-10"
              style={{ backgroundColor: themeColor }}
            />

            <div class="h-full flex flex-col relative z-10">
              <div class="pb-4 mb-4 border-b border-white/10 flex items-center justify-between">
                <div class="flex items-center gap-3">
                  <div 
                    class="w-2.5 h-2.5 rounded-full animate-pulse shadow-[0_0_8px_currentColor]"
                    style={{ color: themeColor, backgroundColor: themeColor }}
                  />
                  <h3 class="text-base sm:text-lg md:text-xl font-bold tracking-wide text-white/95">
                    {title}
                  </h3>
                </div>
                <span class="text-[10px] md:text-xs font-semibold uppercase tracking-wider text-white/30 font-mono">
                  {(index + 1).toString().padStart(2, "0")}
                </span>
              </div>

              <div class="flex-1 overflow-y-auto pr-1 custom-scrollbar">
                <div class={innerGridClass}>
                  {techs.map((tech) => (
                    <div 
                      class="tech-tile flex flex-col items-center justify-center p-2 sm:p-3 rounded-xl border border-white/5 bg-white/[0.02] transition-all duration-300 hover:border-white/15 hover:bg-white/[0.06] hover:-translate-y-0.5 group"
                    >
                      <div class="relative flex items-center justify-center p-0.5 sm:p-1">
                        <div 
                          class="absolute inset-0 rounded-full blur-md opacity-0 group-hover:opacity-40 transition-opacity duration-300 pointer-events-none"
                          style={{ backgroundColor: tech.color }}
                        />
                        <Icon
                          name={tech.icon}
                          class="w-7 h-7 sm:w-8 sm:h-8 lg:w-9 lg:h-9 relative z-10 transition-transform duration-300 group-hover:scale-110"
                          style={{ color: tech.color }}
                        />
                      </div>
                      <span class="text-[9px] sm:text-[10px] lg:text-xs mt-1.5 sm:mt-2 font-medium text-white/50 group-hover:text-white transition-colors duration-300 text-center truncate w-full px-0.5">
                        {formatTechName(tech.icon)}
                      </span>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </article>
      );
    })
  }
</div>

<style>
  /* Scrollbar styles */
  .custom-scrollbar::-webkit-scrollbar {
    width: 4px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.08);
    border-radius: 9999px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background: rgba(255, 255, 255, 0.15);
  }

  /* Bevel Clip Path shapes */
  .outer-bevel-skill {
    --skill-bevel: 24px;
    clip-path: polygon(
      0 var(--skill-bevel),
      var(--skill-bevel) 0,
      calc(100% - var(--skill-bevel)) 0,
      100% var(--skill-bevel),
      100% calc(100% - var(--skill-bevel)),
      calc(100% - var(--skill-bevel)) 100%,
      var(--skill-bevel) 100%,
      0 calc(100% - var(--skill-bevel))
    );
  }
  
  .inner-bevel-skill {
    --skill-bevel: 24px;
    clip-path: polygon(
      0 var(--skill-bevel),
      var(--skill-bevel) 0,
      calc(100% - var(--skill-bevel)) 0,
      100% var(--skill-bevel),
      100% calc(100% - var(--skill-bevel)),
      calc(100% - var(--skill-bevel)) 100%,
      var(--skill-bevel) 100%,
      0 calc(100% - var(--skill-bevel))
    );
  }
</style>
