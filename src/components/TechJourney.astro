---
/**
 * TechJourney — recorrido horizontal de tecnologías.
 * Usa los datos reales del i18n (skills.list).
 */
import { getTranslations } from "../i18n/utils";
import Icon from "astro-iconify";

const lang = Astro.currentLocale as "es" | "en";
const t = getTranslations(lang);
const skillsT = t("skills");
const groups = skillsT.list;
const journeyT = t("journey");

const descriptions = journeyT.skillDescriptions;
---

<section
  id="tech-journey"
  aria-label="Tecnologías"
  class="journey relative bg-surface text-ink overflow-x-clip"
  style={`--panels: ${groups.length + 2}`}
>
  <div class="journey-sticky">
  <div class="track flex h-full w-max">
    <!-- Panel intro -->
    <div
      class="panel w-screen h-full flex flex-col justify-center px-[clamp(1.5rem,8vw,7.5rem)]"
    >
      <h2
        class="font-fira-sans-extra-condensed font-black text-[clamp(2.6rem,9vw,6.5rem)] leading-[0.92] tracking-tight m-0 mb-3"
      >
        {journeyT.introTitle}
      </h2>
      <p class="font-sans text-soft text-[1.05rem] max-w-[44ch] m-0">
        {skillsT.sectionDescription}
      </p>
    </div>

    <!-- Paneles por grupo de skills -->
    {
      groups.map((group) => (
        <div class="panel w-screen h-full flex flex-col justify-center px-[clamp(1.5rem,8vw,7.5rem)]">
          <h2
            class="font-fira-sans-extra-condensed font-black text-[clamp(2.6rem,9vw,6.5rem)] leading-[0.92] tracking-tight m-0 mb-2"
            style={`color: ${group.accent}`}
          >
            {group.title}
          </h2>
          <p class="font-sans text-soft text-[1.05rem] max-w-[44ch] m-0 mb-8 capitalize">
            {descriptions[group.title] ?? ""}
          </p>
          <ul class="tech-list">
            {group.techs.map(({color, icon}) => {
              // Extraer el nombre legible del icon (ej: "devicon:angular" → "Angular")
              const raw = icon.split(":")[1] ?? icon;
              const name =
                raw.charAt(0).toUpperCase() + raw.slice(1).replace(/-/g, " ");
              return (
                <li
                  class="tech-item bg-surface relative group"
                  style={`--accent: ${color}; --tw-border-opacity: 1;`}
                >
                  <b class="block py-3 bg-tag font-fira-sans-extra-condensed font-black text-[clamp(1.2rem,2.5vw,1.7rem)] tracking-[-0.02em]" style={`color: ${color};`}>{name}</b>
                  <Icon
                    name={icon}
                    class="h-full w-fit bg-tag -z-10 absolute block left-0 top-2/4 -translate-y-2/4 group-hover:top-0 group-hover:translate-y-[-101%] transition-all"
                  />
                </li>
              );
            })}
          </ul>
        </div>
      ))
    }

    <!-- Panel cierre -->
    <div
      class="panel w-screen h-full flex flex-col justify-center px-[clamp(1.5rem,8vw,7.5rem)]"
    >
      <h2
        class="font-fira-sans-extra-condensed font-black text-[clamp(2.6rem,9vw,6.5rem)] leading-[0.92] tracking-tight m-0 mb-3"
      
      >
        {journeyT.outroTitle}
      </h2>
      <p class="font-sans text-soft text-[1.05rem] max-w-[44ch] m-0 capitalize">
        {journeyT.outroDesc}
      </p>
    </div>
  </div>

  <!-- Barra de progreso -->
  <div
    aria-hidden="true"
    class="route absolute bottom-7 left-[clamp(1.5rem,8vw,7.5rem)] right-[clamp(1.5rem,8vw,7.5rem)] h-[3px] bg-line rounded-full"
  >
    <div
      id="route-progress"
      class="h-full bg-ink rounded-full origin-left scale-x-0"
    >
    </div>
  </div>
  </div>
</section>

<style>
@layer components {
    /* Scroll horizontal puro CSS: wrapper alto + sticky + view-timeline */
    .journey {
      height: calc(100vh + (var(--panels, 7) - 1) * 100vw);
      view-timeline-name: --journey;
      view-timeline-axis: block;
    }

    .journey-sticky {
      position: sticky;
      top: 0;
      height: 100vh;
      overflow: hidden;
    }

    .track {
      animation-name: journey-pan;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: --journey;
      animation-range: cover 0% cover 100%;
    }

    @keyframes journey-pan {
      to {
        transform: translateX(calc(-100% + 100vw));
      }
    }

    .journey .track {
      height: 100%;
      align-items: stretch;
    }

    .journey .panel {
      height: 100%;
      flex-shrink: 0;
    }

    #route-progress {
      animation-name: route-grow;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: --journey;
      animation-range: cover 0% cover 100%;
    }

    @keyframes route-grow {
      to {
        transform: scaleX(1);
      }
    }

    .tech-list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      gap: 12px 40px;
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      max-width: 900px;
    }

    .tech-item {
      border-top: 1.5px solid var(--line, #e5e7eb);
    }
  }

  /* Overrides de theme en utilities */
  @layer utilities {
    /* Neón: chip translúcido para tapar el logo en reposo sin matar el glow */
    .neon .tech-item {
      background: color-mix(in srgb, #161824 72%, transparent);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      border-radius: 12px;
      padding-inline: 14px;
    }

    /* Sin movimiento: apila los paneles, sin animaciones */
    @media (prefers-reduced-motion: reduce) {
      .journey {
        height: auto;
      }
      .journey-sticky {
        position: static;
        height: auto;
        overflow: visible;
      }
      .journey .track {
        flex-direction: column;
        width: 100%;
        height: auto;
        animation: none;
      }
      .journey .panel {
        width: 100% !important;
        height: auto !important;
      }
      .route {
        display: none;
      }
    }
  }
</style>
