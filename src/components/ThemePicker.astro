---
/**
 * ThemePicker + LangPicker — selectores flotantes de tema e idioma.
 * Posición fija esquina superior derecha.
 * Estilos: utilidades Tailwind (el reveal del panel usa `starting:`).
 */

const pathname = Astro.url.pathname;
const currentLang = pathname.startsWith("/en") ? "en" : "es";

const altLang = currentLang === "es" ? "en" : "es";
const altPath  = currentLang === "es"
  ? "/en" + (pathname === "/" ? "" : pathname)
  : pathname.replace(/^\/en/, "") || "/";

const trigger =
  "flex size-11 items-center justify-center rounded-full border-[1.5px] border-[color-mix(in_srgb,currentColor_20%,transparent)] bg-[color-mix(in_srgb,canvas_85%,transparent)] p-0 text-[canvastext] backdrop-blur-[12px] backdrop-saturate-[1.4] [transition:background_0.2s,border-color_0.2s,scale_0.15s] hover:bg-[color-mix(in_srgb,canvas_95%,transparent)] hover:scale-[1.08] focus-visible:outline-2 focus-visible:outline-[canvastext] focus-visible:outline-offset-[3px]";

const panel =
  "absolute top-[calc(100%_+_8px)] right-0 flex min-w-40 flex-col gap-0.5 rounded-[14px] border-[1.5px] border-[color-mix(in_srgb,currentColor_12%,transparent)] bg-[color-mix(in_srgb,canvas_92%,transparent)] p-1.5 shadow-[0_8px_32px_color-mix(in_srgb,black_18%,transparent)] backdrop-blur-[20px] backdrop-saturate-[1.6] [transition:opacity_0.18s_ease,translate_0.18s_ease] starting:opacity-0 starting:translate-y-[-6px]";

const option =
  "group relative flex w-full items-center gap-2.5 rounded-[9px] px-3 py-[9px] text-left font-sans text-[0.8rem] font-medium tracking-[0.04em] text-[canvastext] no-underline transition-[background] duration-150 hover:bg-[color-mix(in_srgb,canvastext_8%,transparent)] focus-visible:outline-2 focus-visible:outline-[canvastext] focus-visible:outline-offset-[-2px] focus-visible:rounded-[9px] aria-selected:bg-[color-mix(in_srgb,canvastext_10%,transparent)] aria-selected:font-bold";

const optionIcon = "size-4 shrink-0 opacity-70 [&_svg]:size-full";
const optionCheck = "ml-auto text-[0.75rem] opacity-0 transition-opacity duration-150 group-aria-selected:opacity-100";

const switchOn =
  "relative size-7 w-11 shrink-0 rounded-full border border-[color-mix(in_srgb,currentColor_25%,transparent)] bg-transparent transition-colors data-[on=true]:border-sky-400 data-[on=true]:bg-sky-400";
const switchKnob =
  "absolute left-0.5 top-0.5 size-6 rounded-full bg-[color-mix(in_srgb,canvas_96%,transparent)] shadow transition-transform data-[on=true]:translate-x-4";
const settingRow =
  "group relative flex w-full items-center gap-2.5 rounded-[9px] px-3 py-[9px] text-left font-sans text-[0.8rem] font-medium tracking-[0.04em] text-[canvastext] no-underline transition-[background] duration-150 hover:bg-[color-mix(in_srgb,canvastext_8%,transparent)] focus-visible:outline-2 focus-visible:outline-[canvastext] focus-visible:outline-offset-[-2px] focus-visible:rounded-[9px]";
const settingLabel = "flex-1";
const settingIcon = "size-4 shrink-0 opacity-70 [&_svg]:size-full";
---

<div class="fixed top-5 right-5 z-[999] flex items-center gap-2" id="theme-picker" transition:animate={false}>

  <!-- Selector de idioma -->
  <div class="relative">
    <button
      class={trigger}
      id="lang-trigger"
      data-trigger
      aria-label="Cambiar idioma"
      aria-expanded="false"
      aria-controls="lang-panel"
    >
      <span class="text-[0.75rem] font-sans font-bold tracking-[0.05em]">
        {currentLang.toUpperCase()}
      </span>
    </button>

    <div class={panel} id="lang-panel" data-panel role="listbox" aria-label="Seleccionar idioma" hidden>
      <a
        class={option}
        href="/"
        role="option"
        aria-selected={currentLang === "es" ? true : false}
        hreflang="es"
      >
        <span class="flex size-4 shrink-0 items-center justify-center text-base leading-none" aria-hidden="true">🇪🇸</span>
        Español
        <span class={optionCheck} aria-hidden="true">✓</span>
      </a>
      <a
        class={option}
        href="/en"
        role="option"
        aria-selected={currentLang === "en" ? true : false}
        hreflang="en"
      >
        <span class="flex size-4 shrink-0 items-center justify-center text-base leading-none" aria-hidden="true">🇺🇸</span>
        English
        <span class={optionCheck} aria-hidden="true">✓</span>
      </a>
    </div>
  </div>

  <!-- Settings -->
  <div class="relative">
    <button
      class={trigger}
      id="settings-trigger"
      data-trigger
      aria-label="Configuración del deck"
      aria-expanded="false"
      aria-controls="settings-panel"
    >
      <span class="flex size-5 items-center justify-center [&_svg]:size-full" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="3"/>
          <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>
        </svg>
      </span>
    </button>

    <div class={panel} id="settings-panel" data-panel role="group" aria-label="Configuración del deck" hidden>
      <div class="px-2 py-1.5 text-[0.65rem] font-bold uppercase tracking-[0.16em] text-[canvastext] opacity-50">
        Deck
      </div>
      <button class={settingRow} data-setting="lock" role="switch" aria-pressed="false">
        <span class={settingIcon} aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
          </svg>
        </span>
        <span class={settingLabel}>Bloqueo vertical</span>
        <span class={switchOn} data-switch><span class={switchKnob}></span></span>
      </button>
      <button class={settingRow} data-setting="overview" role="switch" aria-pressed="false">
        <span class={settingIcon} aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/>
          </svg>
        </span>
        <span class={settingLabel}>Vista general</span>
        <span class={switchOn} data-switch><span class={switchKnob}></span></span>
      </button>
      <button class={settingRow} data-setting="minimap" role="switch" aria-pressed="false">
        <span class={settingIcon} aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/>
          </svg>
        </span>
        <span class={settingLabel}>Minimapa</span>
        <span class={switchOn} data-switch><span class={switchKnob}></span></span>
      </button>
    </div>
  </div>

  <!-- Selector de tema -->
  <div class="relative">
    <button
      class={trigger}
      id="theme-trigger"
      data-trigger
      aria-label="Cambiar tema"
      aria-expanded="false"
      aria-controls="theme-panel"
    >
      <span class="flex size-5 items-center justify-center [&_svg]:size-full" id="theme-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="4"/>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
        </svg>
      </span>
    </button>

    <div class={panel} id="theme-panel" data-panel role="listbox" aria-label="Seleccionar tema" hidden>
      <button class={option} data-theme="system" role="option">
        <span class={optionIcon} aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/>
          </svg>
        </span>
        Sistema
        <span class={optionCheck} aria-hidden="true">✓</span>
      </button>
      <button class={option} data-theme="light" role="option">
        <span class={optionIcon} aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="4"/>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
          </svg>
        </span>
        Claro
        <span class={optionCheck} aria-hidden="true">✓</span>
      </button>
      <button class={option} data-theme="dark" role="option">
        <span class={optionIcon} aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
          </svg>
        </span>
        Oscuro
        <span class={optionCheck} aria-hidden="true">✓</span>
      </button>
      <button class={option} data-theme="neon" role="option">
        <span class={optionIcon} aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3l1.8 4.7 4.7 1.8-4.7 1.8L12 16l-1.8-4.7L5.5 9.5l4.7-1.8z"/>
            <path d="M19 15l.9 2.1 2.1.9-2.1.9L19 21l-.9-2.1-2.1-.9 2.1-.9z"/>
          </svg>
        </span>
        Neón
        <span class={optionCheck} aria-hidden="true">✓</span>
      </button>
    </div>
  </div>

</div>

<script>
  import { loadSettings, updateSetting, type DeckSettings } from "./deck/deck-settings";

  type Theme = "system" | "light" | "dark" | "neon";

  const STORAGE_KEY = "wdev-theme";
  const THEMES: Exclude<Theme, "system">[] = ["light", "dark", "neon"];

  const icons: Record<Theme, string> = {
    system: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>`,
    light:  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>`,
    dark:   `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>`,
    neon:   `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l1.8 4.7 4.7 1.8-4.7 1.8L12 16l-1.8-4.7L5.5 9.5l4.7-1.8z"/><path d="M19 15l.9 2.1 2.1.9-2.1.9L19 21l-.9-2.1-2.1-.9 2.1-.9z"/></svg>`,
  };

  const root = document.getElementById("theme-picker")!;

  function applyTheme(theme: Theme) {
    const html = document.documentElement;
    THEMES.forEach((t) => html.classList.remove(t));
    if (theme === "system") {
      html.removeAttribute("data-theme");
      const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
      html.classList.toggle("dark", prefersDark);
    } else {
      html.classList.add(theme);
      html.setAttribute("data-theme", theme);
    }
  }

  function updateUI(theme: Theme) {
    const icon = document.getElementById("theme-icon")!;
    const options = root.querySelectorAll<HTMLElement>("[data-theme]");
    icon.innerHTML = icons[theme];
    options.forEach((opt) => {
      opt.setAttribute("aria-selected", String(opt.dataset.theme === theme));
    });
  }

  function getSaved(): Theme {
    const raw = localStorage.getItem(STORAGE_KEY);
    return (THEMES as string[]).includes(raw ?? "") ? (raw as Theme) : "system";
  }

  function setTheme(theme: Theme) {
    localStorage.setItem(STORAGE_KEY, theme);
    applyTheme(theme);
    updateUI(theme);
  }

  function reflectSettings(s: DeckSettings) {
    root.querySelectorAll<HTMLElement>("[data-setting]").forEach((btn) => {
      const on = Boolean(s[btn.dataset.setting as keyof DeckSettings]);
      const sw = btn.querySelector<HTMLElement>("[data-switch]")!;
      sw.setAttribute("data-on", String(on));
      btn.setAttribute("aria-pressed", String(on));
    });
  }

  function bootSettings() {
    reflectSettings(loadSettings());
    if (root.dataset.settingsWired === "true") return;
    root.dataset.settingsWired = "true";
    root.querySelectorAll<HTMLElement>("[data-setting]").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.stopPropagation();
        const key = btn.dataset.setting as keyof DeckSettings;
        const sw = btn.querySelector<HTMLElement>("[data-switch]")!;
        const next = sw.getAttribute("data-on") !== "true";
        updateSetting(key, next);
        reflectSettings(loadSettings());
        document.getElementById("settings-panel")!.hidden = true;
        document.getElementById("settings-trigger")!.setAttribute("aria-expanded", "false");
      });
    });
  }

  // Boot: aplica el theme siempre; los listeners se registran una sola vez por DOM.
  function bootPicker() {
    applyTheme(getSaved());
    updateUI(getSaved());
    bootSettings();

    if (root.dataset.wired) return;
    root.dataset.wired = "true";

    function setupToggle(triggerId: string, panelId: string) {
      const trigger = document.getElementById(triggerId)!;
      const panel = document.getElementById(panelId)!;

      trigger.addEventListener("click", (e) => {
        e.stopPropagation();
        const open = !panel.hidden;
        root.querySelectorAll<HTMLElement>("[data-panel]").forEach((p) => {
          if (p !== panel) p.hidden = true;
        });
        root.querySelectorAll<HTMLElement>("[data-trigger]").forEach((t) => {
          if (t !== trigger) t.setAttribute("aria-expanded", "false");
        });
        panel.hidden = open;
        trigger.setAttribute("aria-expanded", String(!open));
      });
    }

    setupToggle("theme-trigger", "theme-panel");
    setupToggle("lang-trigger", "lang-panel");
    setupToggle("settings-trigger", "settings-panel");

    // Cerrar al hacer click fuera
    document.addEventListener("click", () => {
      root.querySelectorAll<HTMLElement>("[data-panel]").forEach((p) => (p.hidden = true));
      root.querySelectorAll<HTMLElement>("[data-trigger]").forEach((t) =>
        t.setAttribute("aria-expanded", "false"),
      );
    });

    // Opciones de tema
    root.querySelectorAll<HTMLElement>("[data-theme]").forEach((opt) => {
      opt.addEventListener("click", () => {
        setTheme(opt.dataset.theme as Theme);
        document.getElementById("theme-panel")!.hidden = true;
        document.getElementById("theme-trigger")!.setAttribute("aria-expanded", "false");
      });
    });
  }

  document.addEventListener("astro:page-load", bootPicker);
  bootPicker();

  // Escuchar cambios del sistema (una vez por carga completa)
  window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", () => {
    const saved = getSaved();
    if (saved === "system") {
      applyTheme("system");
      updateUI("system");
    }
  });
</script>
