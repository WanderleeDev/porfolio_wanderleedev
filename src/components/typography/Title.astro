---
/**
 * Title — heading component centralized by level.
 *
 * Resolves the HTML tag from the `level` prop and applies Tailwind
 * utilities directly so every heading in the site renders
 * consistently without custom CSS classes:
 *
 *   level 1 → hero-level: Fira condensed, 900, clamp(3rem,10vw,8rem)
 *   level 2 → section-level: Fira condensed, 900, clamp(2.5rem,7vw,5rem)
 *   level 3 → card-level:   Fira condensed, 900, clamp(1.75rem,4.5vw,3rem)
 *   level 4+→ eyebrow-level: sans, 700, 0.7rem, tracking-wide
 *
 * The size prop replaces the level's default size, so an override never has
 * to fight a second font-size utility over the !important cascade.
 *
 * Usage:
 *   <Title level={2}>{title}</Title>
 *   <Title level={3} class="mt-3">{item.title}</Title>
 */

interface Props {
  level: 1 | 2 | 3 | 4 | 5 | 6;
  class?: string;
  id?: string;
  style?: string;
  size?: string;
}

const { level, class: className = "", id, style, size } = Astro.props;

const inlineStyle = size
  ? `--title-size: ${size};${style ? ` ${style}` : ""}`
  : style;

const titleClass = (lvl: Props["level"]): string => {
  const base = "font-fira-sans-extra-condensed font-black uppercase leading-[0.9] tracking-tight text-ink m-0";
  const scaled = (lvl: Props["level"]): string => {
    switch (lvl) {
      case 1:
        return "text-[clamp(3rem,10vw,8rem)]";
      case 2:
        return "text-[clamp(2.5rem,7vw,5rem)]";
      case 3:
        return "text-[clamp(1.75rem,4.5vw,3rem)]";
      default:
        return "";
    }
  };
  if (size) return `${base} text-[length:var(--title-size)]`;
  switch (lvl) {
    case 1:
    case 2:
    case 3:
      return `${base} ${scaled(lvl)}`;
    case 4:
    case 5:
    case 6:
      return "font-sans font-bold text-[0.7rem] tracking-[0.2em] uppercase text-muted m-0";
  }
};

const finalClass = [titleClass(level), className].filter(Boolean).join(" ").trim();
---

{
  level === 1 && (
    <h1 {...(id ? { id } : {})} class={finalClass} {...(inlineStyle ? { style: inlineStyle } : {})}>
      <slot />
    </h1>
  )
}

{
  level === 2 && (
    <h2 {...(id ? { id } : {})} class={finalClass} {...(inlineStyle ? { style: inlineStyle } : {})}>
      <slot />
    </h2>
  )
}

{
  level === 3 && (
    <h3 {...(id ? { id } : {})} class={finalClass} {...(inlineStyle ? { style: inlineStyle } : {})}>
      <slot />
    </h3>
  )
}

{
  level === 4 && (
    <h4 {...(id ? { id } : {})} class={finalClass} {...(inlineStyle ? { style: inlineStyle } : {})}>
      <slot />
    </h4>
  )
}

{
  level === 5 && (
    <h5 {...(id ? { id } : {})} class={finalClass} {...(inlineStyle ? { style: inlineStyle } : {})}>
      <slot />
    </h5>
  )
}

{
  level === 6 && (
    <h6 {...(id ? { id } : {})} class={finalClass} {...(inlineStyle ? { style: inlineStyle } : {})}>
      <slot />
    </h6>
  )
}
