---
import { getTranslations } from "../i18n/utils";
import ChatWidget from "../components/ChatWidget.astro";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const lang = Astro.currentLocale as "es" | "en";
const t = getTranslations(lang);
const meta = t("metadata");
const site = "https://wanderlee.dev";
const ogLocale = lang === "en" ? "en_US" : "es_AR";
const altLang = lang === "es" ? "en" : "es";
const altHref = altLang === "en" ? `${site}/en` : `${site}/`;
const altTitle = altLang === "en" ? "WanderleeDev — Portfolio" : "Portafolio WanderleeDev";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="keywords" content={meta.keywords} />
    <link rel="icon" href="/favicon_default.svg" type="image/svg+xml" />
    <link
      rel="icon"
      href="/favicon_dark.svg"
      type="image/svg+xml"
      media="(prefers-color-scheme: dark)"
    />
    <title>{title}</title>

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="WanderleeDev" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={altLang === "en" ? "es_AR" : "en_US"} />
    <meta property="og:url" content={lang === "en" ? `${site}/en` : site} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={meta.thumbnail} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />

    <!-- Alternative language (i18n link) -->
    <link rel="alternate" hreflang={altLang} href={altHref} />
    <link rel="alternate" hreflang={`${altLang}-${altLang.toUpperCase()}`} href={altHref} />
    <link rel="alternate" hreflang="x-default" href={site} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={meta.thumbnail} />

    <!-- Canonical -->
    <link rel="canonical" href={lang === "en" ? `${site}/en` : site} />

    <script is:inline>
      try {
        var ALL = ["light", "dark", "neon"];
        var s = localStorage.getItem("wdev-theme") || "system";
        if (ALL.indexOf(s) < 0) s = "system";
        var r = document.documentElement;
        for (var i = 0; i < ALL.length; i++) r.classList.remove(ALL[i]);
        if (s === "system") {
          r.removeAttribute("data-theme");
          if (matchMedia("(prefers-color-scheme: dark)").matches) r.classList.add("dark");
        } else {
          r.classList.add(s);
          r.setAttribute("data-theme", s);
        }
      } catch (e) {}
    </script>
  </head>

  <body class="overflow-x-clip">
    <div>
      <slot />
    </div>

    <script>
      import { gsap } from "../lib/gsap";

      function revealAll() {
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        const els = document.querySelectorAll<HTMLElement>("[data-reveal]");
        els.forEach((el) => {
          if (el.dataset.revealed === "true") return;
          el.dataset.revealed = "true";
          const opts = {
            opacity: 0,
            y: 40,
            duration: 0.9,
            ease: "power3.out",
            scrollTrigger: { trigger: el, start: "top 80%" },
          };
          // Si el bloque contiene un título, el fade del contenedor taparía
          // la animación de palabras: se animan los hijos que no son título.
          const title = el.querySelector("h1, h2, h3");
          if (title) {
            const others = Array.from(el.children).filter(
              (c) => !(c instanceof HTMLElement && c.matches("h1, h2, h3")),
            );
            if (others.length) gsap.from(others, { ...opts, stagger: 0.15 });
            return;
          }
          gsap.from(el, opts);
        });
      }

      function animateSectionTitles() {
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        const headings = document.querySelectorAll<HTMLElement>("h1, h2, h3");
        headings.forEach((h) => {
          if (h.closest("#hero")) return;
          if (h.closest("dialog")) return;
          // Los títulos de grupo del TechStack se animan al activarse, no al scrollear.
          if (h.closest("[data-title]")) return;
          if (h.dataset.titleSplit === "true") return;
          if (h.querySelector(".hero-word, .title-word")) return;
          const text = (h.textContent || "").trim();
          if (!text) return;
          const words = text.split(/\s+/);
          h.textContent = "";
          words.forEach((w) => {
            const span = document.createElement("span");
            span.className = "title-word";
            span.textContent = w + "\u00A0";
            h.appendChild(span);
          });
          h.dataset.titleSplit = "true";
          const wordEls = h.querySelectorAll<HTMLElement>(".title-word");
          gsap.set(wordEls, { scaleY: 0 });
          gsap.to(wordEls, {
            scaleY: 1,
            duration: 0.8,
            ease: "elastic.out(1, 0.45)",
            stagger: 0.08,
            scrollTrigger: { trigger: h, start: "top 85%" },
          });
        });
      }

      function boot() {
        revealAll();
        animateSectionTitles();
      }

      document.addEventListener("astro:page-load", boot);
      boot();
    </script>
    <ChatWidget />
  </body>
</html>
