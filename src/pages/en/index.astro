---
/**
 * English home page. BaseLayout provides <html>/<head> with i18n Open Graph
 * tags and the theme-preset script; Hero owns the curtain intro, the stars
 * canvas and the hero word-reveal. The global stylesheet is imported here so
 * fonts/Tailwind/theme vars load on every locale page.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/global.css";
import Hero from "../../components/Hero.astro";
import ThemePicker from "../../components/ThemePicker.astro";
import ChatSection from "../../components/ChatSection.astro";
import Credits from "../../components/credits/Credits.astro";
import Logros from "../../components/logros/Logros.astro";
import Icon from "../../components/Icon.astro";
import Deck from "../../components/deck/Deck.astro";
import Slide from "../../components/deck/Slide.astro";
import VStack from "../../components/deck/VStack.astro";
import VSlide from "../../components/deck/VSlide.astro";
import ContactForm from "../../components/contact/ContactForm";
import Collage3D from "../../components/Collage3D.astro";
import Title from "../../components/typography/Title.astro";
import { getTranslations } from "../../i18n/utils";

const lang = Astro.currentLocale as "es" | "en";
const t = getTranslations(lang);
const meta = t("metadata");
const projectList = t("projects").list;
const collage = {
  yellow: projectList[0].image,
  pink: projectList[1].image,
  orange: projectList[2].image,
  green: projectList[3].image,
  blue: projectList[0].image,
};
const c = t("contactSection");
const f = t("footer");

const links = [
  { icon: "lucide:mail", label: f.email, href: `mailto:${f.email}` },
  { icon: "lucide:github", label: "github.com/WanderleeDev", href: "https://github.com/WanderleeDev" },
  {
    icon: "lucide:linkedin",
    label: "linkedin.com/in/wanderlee-max",
    href: "https://linkedin.com/in/wanderlee-max",
  },
];
---

<BaseLayout title={meta.title} description={meta.description}>
  <ThemePicker />
  <Credits lang="en" />
  <Logros lang="en" />
  <Deck start={1} vstart={1}>
    <Slide title={c.title}>
      <div class="flex w-full max-w-2xl flex-col items-center gap-6 md:gap-8">
        <div class="text-center">
          <span class="font-sans text-[0.65rem] font-bold uppercase tracking-[0.3em] text-muted">
            {f.contactLabel}
          </span>
          <Title level={2} family="sans" size="clamp(2.5rem,5vw,4rem)" class="mt-2">
            {c.title}
          </Title>
          <p class="mx-auto mt-3 max-w-[46ch] font-sans text-[clamp(0.95rem,1.6vw,1.1rem)] leading-[1.5] text-soft">
            {c.subtitle}
          </p>
        </div>

        <ul class="flex items-center justify-center gap-2">
          {
            links.map((l) => (
              <li>
                <a
                  href={l.href}
                  target={l.href.startsWith("http") ? "_blank" : undefined}
                  rel={l.href.startsWith("http") ? "noopener" : undefined}
                  aria-label={l.label}
                  title={l.label}
                  class="flex size-11 items-center justify-center rounded-full border border-line bg-surface text-ink transition-colors hover:bg-badge"
                >
                  <Icon name={l.icon} class="size-5" aria-hidden="true" />
                </a>
              </li>
            ))
          }
        </ul>

        <div class="w-full max-w-lg">
          <ContactForm client:load lang={lang} />
        </div>
      </div>
    </Slide>

    <Slide title="Main">
      <VStack>
        <VSlide title="Top" class="!p-0">
          <Collage3D images={collage} />
        </VSlide>
        <VSlide title="Main" class="!p-0">
          <Hero />
        </VSlide>
        <VSlide title="Bottom">
          <h3 class="text-4xl font-bold">Bottom content</h3>
        </VSlide>
      </VStack>
    </Slide>

    <Slide title="End">
      <ChatSection />
    </Slide>
  </Deck>
</BaseLayout>
