---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/global.css";
import Hero from "../components/Hero.astro";
import ThemePicker from "../components/ThemePicker.astro";
import ChatSection from "../components/ChatSection.astro";
import Credits from "../components/credits/Credits.astro";
import Logros from "../components/logros/Logros.astro";
import MusicPlayer from "../components/MusicPlayer.astro";
import Icon from "../components/Icon.astro";
import Title from "../components/typography/Title.astro";
import Deck from "../components/deck/Deck.astro";
import Slide from "../components/deck/Slide.astro";
import VStack from "../components/deck/VStack.astro";
import VSlide from "../components/deck/VSlide.astro";
import { getTranslations } from "../i18n/utils";

const lang = Astro.currentLocale as "es" | "en";
const t = getTranslations(lang);
const meta = t("metadata");
const c = t("contactSection");
const f = t("footer");
const chat = t("chat");

const links = [
  { icon: "lucide:mail", label: f.email, href: `mailto:${f.email}` },
  { icon: "lucide:github", label: "github.com/WanderleeDev", href: "https://github.com/WanderleeDev" },
  {
    icon: "lucide:linkedin",
    label: "linkedin.com/in/wanderlee-max",
    href: "https://linkedin.com/in/wanderlee-max",
  },
];
---

<BaseLayout title={meta.title} description={meta.description}>
  <ThemePicker />
  <Credits lang="es" />
  <Logros lang="es" />
  <Deck start={1} vstart={1}>
    <Slide title={c.title}>
      <div class="flex w-full max-w-5xl flex-col items-center gap-10 md:gap-16">
        <div class="text-center">
          <span class="font-sans text-xs font-bold uppercase tracking-[0.3em] text-muted">
            {f.contactLabel}
          </span>
          <Title level={2} family="sans" size="clamp(3.5rem,8vw,7rem)" class="mt-4">
            {c.title}
          </Title>
          <p class="mx-auto mt-6 max-w-[42ch] font-sans text-[clamp(1.1rem,2.4vw,1.5rem)] leading-[1.5] text-soft">
            {c.subtitle}
          </p>
        </div>

        <ul class="flex flex-wrap items-center justify-center gap-4">
          {
            links.map((l) => (
              <li>
                <a
                  href={l.href}
                  target={l.href.startsWith("http") ? "_blank" : undefined}
                  rel={l.href.startsWith("http") ? "noopener" : undefined}
                  class="inline-flex items-center gap-3 rounded-full border border-line bg-surface px-8 py-4 font-sans text-lg text-ink transition-colors hover:bg-badge"
                >
                  <Icon name={l.icon} class="size-6" aria-hidden="true" />
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </Slide>

    <Slide title="Principal">
      <VStack>
        <VSlide title="Arriba">
          <h3 class="text-4xl font-bold">Contenido superior</h3>
        </VSlide>
        <VSlide title="Principal" class="!p-0">
          <Hero />
        </VSlide>
        <VSlide title="Abajo">
          <MusicPlayer />
        </VSlide>
      </VStack>
    </Slide>

    <Slide title="Final">
      <div class="flex w-full max-w-5xl flex-col items-center gap-8">
        <div class="text-center">
          <span class="font-sans text-xs font-bold uppercase tracking-[0.3em] text-muted">
            {chat.title}
          </span>
          <p class="mt-3 font-sans text-[clamp(1.1rem,2.4vw,1.5rem)] leading-[1.5] text-soft">
            {chat.subtitle}
          </p>
        </div>
        <ChatSection />
      </div>
    </Slide>
  </Deck>
</BaseLayout>
