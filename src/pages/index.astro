---
/**
 * Redesign index — Spencer Gabor language, WanderleeDev content.
 * Standalone white page: no BaseLayout, no old header/footer, no GSAP.
 * Pulls the global CSS so fonts, Tailwind utilities and theme vars work
 * without the old layout chrome.
 */
import "../styles/global.css";
import RedesignHead from "../components/RedesignHead.astro";
import HeroFan from "../components/HeroFan.astro";
import FeaturedWork from "../components/FeaturedWork.astro";
import TechJourney from "../components/TechJourney.astro";
import MoreWork from "../components/MoreWork.astro";
import RedesignContact from "../components/RedesignContact.astro";
import RedesignFooter from "../components/RedesignFooter.astro";
import ThemePicker from "../components/ThemePicker.astro";
import { getTranslations } from "../i18n/utils";

const lang = Astro.currentLocale as "es" | "en";
const t = getTranslations(lang);
const projects = t("projects").list;
---

<html lang={lang}>
  <head>
    <RedesignHead
      title="WanderleeDev — Redesign"
      description="WanderleeDev — Fullstack, diseño y animación"
    />
  </head>
  <body>
    <ThemePicker />
    <HeroFan />
    <FeaturedWork
      items={projects.map((p) => ({
        title: p.title,
        src: p.image,
        alt: p.title,
        description: p.description,
        demoUrl: p.demo_url,
        techs: p.technologies,
        label: p.label,
      }))}
    />
    <TechJourney />
    <MoreWork />
    <RedesignContact />
    <RedesignFooter />
  </body>
</html>
