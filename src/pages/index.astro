---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/global.css";
import Hero from "../components/Hero.astro";
import ThemePicker from "../components/ThemePicker.astro";
import ChatSection from "../components/ChatSection.astro";
import Logros from "../components/logros/Logros.astro";
import MusicPlayer from "../components/MusicPlayer.astro";
import Deck from "../components/deck/Deck.astro";
import Slide from "../components/deck/Slide.astro";
import VStack from "../components/deck/VStack.astro";
import VSlide from "../components/deck/VSlide.astro";
import ContactSection from "../components/ContactSection.astro";
import Collage3D from "../components/Collage3D.astro";
import { getTranslations } from "../i18n/utils";

export const prerender = true;

const lang = Astro.currentLocale as "es" | "en";
const t = getTranslations(lang);
const meta = t("metadata");
const c = t("contactSection");
---

<BaseLayout title={meta.title} description={meta.description}>
  <ThemePicker />
  <Logros lang="es" />
  <Deck start={1} vstart={1}>
    <Slide title={c.title}>
      <ContactSection />
    </Slide>

    <Slide title="Principal">
      <VStack>
        <VSlide title="Arriba" class="[@media(max-height:700px)]:!py-2">
          <MusicPlayer />
        </VSlide>
        <VSlide title="Principal" class="!p-0">
          <Hero />
        </VSlide>
        <VSlide title="Abajo" class="!p-0">
          <Collage3D />
        </VSlide>
      </VStack>
    </Slide>

    <Slide title="Final" class="[@media(max-height:620px)]:!py-2">
      <ChatSection />
    </Slide>
  </Deck>
</BaseLayout>
