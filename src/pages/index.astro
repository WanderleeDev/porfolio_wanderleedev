---
/**
 * Redesign index (es) — shared BaseLayout provides <html>/<head> with
 * i18n Open Graph tags, the View Transitions client router, the
 * theme-preset script, and the Hero component, which owns the
 * curtain intro, the stars canvas and the hero word-reveal. The global stylesheet is imported here
 * so fonts/Tailwind/theme vars load on every locale page.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/global.css";
import Hero from "../components/Hero.astro";
import FeaturedWork from "../components/FeaturedWork.astro";
import TechJourney from "../components/TechJourney.astro";
import MoreWork from "../components/MoreWork.astro";
import RedesignContact from "../components/RedesignContact.astro";
import RedesignFooter from "../components/RedesignFooter.astro";
import ThemePicker from "../components/ThemePicker.astro";
import { getTranslations } from "../i18n/utils";

const lang = Astro.currentLocale as "es" | "en";
const t = getTranslations(lang);
const meta = t("metadata");
const projects = t("projects").list;
---

<BaseLayout title={meta.title} description={meta.description}>
  <ThemePicker />
  <Hero />
  <FeaturedWork
    items={projects.map((p) => ({
      title: p.title,
      src: p.image,
      alt: p.title,
      description: p.description,
      demoUrl: p.demo_url,
      techs: p.technologies,
      label: p.label,
    }))}
  />
  <TechJourney />
  <MoreWork />
  <RedesignContact />
  <RedesignFooter />
</BaseLayout>
