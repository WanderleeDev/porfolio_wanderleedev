---
import DecorativeAccent from "../components/base/DecorativeAccent.astro";
import Paragraph from "../components/typography/Paragraph.astro";
import Title from "../components/typography/Title.astro";
import SkillDesktopDeck from "../components/SkillDesktopDeck.astro";
import SkillAccordionItem from "../components/SkillAccordionItem.astro";
import { getTranslations } from "../i18n/utils";

const lang = Astro.currentLocale as "es" | "en";
const t = getTranslations(lang);
const skillsT = t("skills");
const skills = skillsT.list;
---

<section
  id="skills"
  data-section={skillsT.attr_data}
  class="section-page relative min-h-dvh py-20 px-4 lg:px-8 flex flex-col items-center justify-center overflow-x-clip"
>
  <div class="max-w-7xl w-full mx-auto flex flex-col gap-12 lg:gap-16">
    <header class="space-y-6 w-full relative z-10">
      <DecorativeAccent />
      <Title customClass="skills-title">
        {skillsT.sectionTitle}
      </Title>
      <Paragraph customClass="skills-text w-full">
        {skillsT.sectionDescription}
      </Paragraph>
    </header>

    <div
      class="w-full max-lg:absolute max-lg:pointer-events-none max-lg:opacity-0 max-lg:h-0 max-lg:w-0 max-lg:overflow-hidden"
    >
      <SkillDesktopDeck skills={skills} />
    </div>

    <div
      class="w-full space-y-4 lg:absolute lg:pointer-events-none lg:opacity-0 lg:h-0 lg:w-0 lg:overflow-hidden"
      id="skills-accordion"
    >
      {
        skills.map(({ title, techs, accent }, index) => {
          return (
            <SkillAccordionItem
              title={title}
              techs={techs}
              index={index}
              themeColor={accent}
              isFirst={index === 0}
            />
          );
        })
      }
    </div>
  </div>
</section>

<style></style>

<script>
  import { createRevealSectionTL } from "../utils/createRevealSectionTL";
  import {
    gsap,
    GsapBreakpoints,
    type GsapBreakpointsType,
  } from "../utils/gsapConfig";
  import {} from "gsap";
  import { $ } from "../utils/selectors";

  function animateSkillsSection() {
    if (
      window.matchMedia("(prefers-reduced-motion: reduce)").matches
    )
      return;
    const accordionItems = gsap.utils.toArray<HTMLElement>(
      ".skills-accordion-item",
    );
    const tabs = gsap.utils.toArray<HTMLElement>(".skill-tab-item");
    const cardsContainer = $<HTMLDivElement>("#skill-cards-container");

    if (accordionItems.length === 0 || tabs.length === 0 || !cardsContainer)
      return;

    const mm = gsap.matchMedia();

    mm.add({ ...GsapBreakpoints }, (context) => {
      let { isDesktop, isMobile, isTablet, reduceMotion } =
        context.conditions as GsapBreakpointsType;
      const tl = createRevealSectionTL(".skills-title", ".skills-text");

      if (reduceMotion || !tl) return;
      if (isMobile || isTablet) {
        tl.fromTo(
          accordionItems,
          { opacity: 0, y: -20 },
          {
            opacity: 1,
            y: 0,
            duration: 0.4,
            stagger: 0.1,
            ease: "power3.out",
          },
          "<",
        );

        return;
      }

      if (isDesktop) {
        tl.fromTo(
          tabs,
          { opacity: 0, y: -20 },
          {
            opacity: 1,
            y: 0,
            duration: 0.1,
            stagger: 0.1,
            ease: "power3.out",
          },
          "<",
        ).fromTo(
          cardsContainer,
          { opacity: 0, x: 50 },
          {
            opacity: 1,
            x: 0,
            transformOrigin: "left",
            ease: "power3.out",
            stagger: 0.15,
          },
          "<",
        );
      }
    });
  }

  animateSkillsSection();
</script>
